    "sm1c_pdp_faq": {
      "type": "sm1c-pdp-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Apply the patches under clean, dry eyes, smoothing gently from the inner to outer corner. Leave on for 15–20 minutes, then remove and pat any remaining essence into your skin — no rinsing needed.</p>",
            "icon": "droplet"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "How soon will I see results?",
            "answer": "<p>Most people notice visibly reduced puffiness and brighter-looking under-eyes right after their very first use. With regular use, dark circles and fine lines continue to look more improved over time.</p>",
            "icon": "clock"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Is it safe for sensitive skin?",
            "answer": "<p>Yes — the formula is dermatologically tested and gentle enough for daily use on sensitive skin. We still recommend a patch test before your first full application.</p>",
            "icon": "shield"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Can I use them daily?",
            "answer": "<p>Yes — these patches are gentle enough for daily use, whether as part of your morning routine or a relaxing self-care moment.</p>",
            "icon": "calendar"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "How many patches come in one pack?",
            "answer": "<p>Each pack includes 60 patches (30 pairs), giving you ample supply for consistent, regular use.</p>",
            "icon": "box"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Do you offer a money-back guarantee?",
            "answer": "<p>Yes — refunds are available within 30 days of delivery for products that arrive damaged or defective. Just send us photos as proof; no need to ship anything back.</p>",
            "icon": "refresh"
          }
        }
