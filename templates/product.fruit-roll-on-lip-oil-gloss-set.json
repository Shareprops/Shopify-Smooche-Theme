    "sm1c_pdp_faq": {
      "type": "sm1c-pdp-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How do I apply it?",
            "answer": "<p>Twist the roll-on applicator and glide it directly onto clean or lipstick-topped lips. No brush, fingers, or mirror needed — just roll and go.</p>",
            "icon": "droplet"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Will it feel sticky?",
            "answer": "<p>No — the lightweight oil formula settles in within seconds, leaving a smooth, glassy finish with zero tackiness.</p>",
            "icon": "shield"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Does it add color?",
            "answer": "<p>It's colorless and transparent by design, so it won't alter your natural lip color or stain your cup, mask, or clothing. It simply adds shine and a sheer glow.</p>",
            "icon": "heart"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "How long does one roll-on last?",
            "answer": "<p>With regular daily touch-ups, one roll-on typically lasts 6–8 weeks, depending on how often you reapply.</p>",
            "icon": "box"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "Is it safe for sensitive lips?",
            "answer": "<p>Yes — the formula is lightweight and nourishing, made to soften and condition even dry or sensitive lips. We still recommend a patch test if you have known sensitivities.</p>",
            "icon": "heart"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Do you offer a money-back guarantee?",
            "answer": "<p>Yes — refunds are available within 30 days of delivery for products that arrive damaged or defective. Just send us photos as proof; no need to ship anything back.</p>",
            "icon": "refresh"
          }
        }
      },
