    "sm1c_pdp_faq": {
      "type": "sm1c-pdp-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How do I use the patches?",
            "answer": "<p>Apply a clean, dry patch directly onto your forehead or targeted area before bed, and leave it on overnight. In the morning, gently peel it off and cleanse as usual — no residue left behind.</p>",
            "icon": "check"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "How soon will I see results?",
            "answer": "<p>Many people notice smoother-looking skin the very next morning. With consistent nightly use, expression lines and creases can look visibly softer over several weeks.</p>",
            "icon": "clock"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Can the patches be reused?",
            "answer": "<p>Yes — each patch is designed to be gently cleaned and reused multiple times, so your 192-patch pack goes further than a single-use product.</p>",
            "icon": "refresh"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Is it safe for sensitive skin?",
            "answer": "<p>Yes — the patches are hypoallergenic, latex-free, and silicone-free. We still recommend testing on a small area first if you have known sensitivities.</p>",
            "icon": "shield"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "Where can I use them besides my forehead?",
            "answer": "<p>While designed with the forehead in mind, many customers also use the patches on other expression-prone areas like between the brows or around the mouth.</p>",
            "icon": "box"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Do you offer a money-back guarantee?",
            "answer": "<p>Yes — refunds are available within 30 days of delivery for products that arrive damaged or defective. Just send us photos as proof; no need to ship anything back.</p>",
            "icon": "refresh"
          }
        }
      },
