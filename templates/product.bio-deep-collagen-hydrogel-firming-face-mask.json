    "sm1c_pdp_faq": {
      "type": "sm1c-pdp-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Apply the hydrogel mask to clean, dry skin, smoothing out any air bubbles. Leave on for at least 3 hours, or overnight for maximum absorption, then remove and pat any remaining essence into your skin.</p>",
            "icon": "droplet"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Why does the mask turn transparent?",
            "answer": "<p>As the hydrogel formula delivers its active ingredients into your skin over time, it gradually turns translucent — a visual sign that it's working its way in.</p>",
            "icon": "check"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Is it safe for acne-prone or sensitive skin?",
            "answer": "<p>Yes — the formula includes a gentle probiotic-derived ingredient that helps balance oil and support the skin's natural microecology, with simple, hypoallergenic ingredients. We still recommend a patch test first.</p>",
            "icon": "shield"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "How often should I use it?",
            "answer": "<p>Use 1–2 times per week as part of your evening routine for consistent, visible results.</p>",
            "icon": "calendar"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "How many masks come in one pack?",
            "answer": "<p>Each pack includes 5 hydrogel masks (37g each), giving you enough for several weeks of regular use.</p>",
            "icon": "box"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Do you offer a money-back guarantee?",
            "answer": "<p>Yes — refunds are available within 30 days of delivery for products that arrive damaged or defective. Just send us photos as proof; no need to ship anything back.</p>",
            "icon": "refresh"
          }
        }
