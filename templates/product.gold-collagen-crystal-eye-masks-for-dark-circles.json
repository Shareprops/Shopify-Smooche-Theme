    "sm1c_pdp_faq": {
      "type": "sm1c-pdp-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Cleanse your face, then apply the mask close to your eyes for 20–30 minutes. No need to rinse afterward — start with daily applications for your first six treatments, then maintain with 2–3 times a week.</p>",
            "icon": "droplet"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "What does \"melting\" mean?",
            "answer": "<p>As the mask absorbs into your skin, it gradually thins from a thicker 2mm down to a feather-light 1mm — delivering collagen at a 98%+ absorption rate as it goes.</p>",
            "icon": "check"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "What's the difference between golden and white?",
            "answer": "<p>Both offer the same high-density plant collagen formula — golden and white are simply two color options, so you can pick whichever you like best.</p>",
            "icon": "box"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "How soon will I see results?",
            "answer": "<p>Most people notice visibly reduced puffiness and brighter-looking under-eyes right after their very first use. With the recommended daily routine for the first week, dark circles continue to look more improved.</p>",
            "icon": "clock"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "Is it safe for sensitive skin?",
            "answer": "<p>Yes — the formula includes Centella Asiatica to help keep the delicate under-eye area calm and comfortable. We still recommend a patch test before your first full application.</p>",
            "icon": "shield"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Do you offer a money-back guarantee?",
            "answer": "<p>Yes — refunds are available within 30 days of delivery for products that arrive damaged or defective. Just send us photos as proof; no need to ship anything back.</p>",
            "icon": "refresh"
          }
        }
      },
