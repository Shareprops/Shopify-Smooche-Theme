    "sm1c_pdp_faq": {
      "type": "sm1c-pdp-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Apply an even layer to clean, dry skin, avoiding the eye area, eyebrows, hairline, and lips. Leave on for 15–20 minutes, until the layer looks matte, then peel off from the edges in one motion and follow with your usual moisturizer.</p>",
            "icon": "droplet"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Will turmeric stain my skin?",
            "answer": "<p>No — unlike some cream-based turmeric masks, this peel-off formula is designed to lift away clean, with no yellow staining on skin, towels, or pillowcases.</p>",
            "icon": "check"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "How soon will I see brightening results?",
            "answer": "<p>Most people notice brighter, more even-looking skin right after their very first peel. With consistent use 1–2 times a week, tone and clarity continue to improve over the following weeks.</p>",
            "icon": "clock"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Is it safe for sensitive or acne-prone skin?",
            "answer": "<p>Yes — the formula is alcohol-free and fragrance-free, and includes Centella Asiatica to keep the peel calming on reactive skin. We still recommend a patch test before your first full application.</p>",
            "icon": "shield"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "How long does one bottle last?",
            "answer": "<p>With 1–2 uses per week, a single 75ml bottle typically lasts 6–8 weeks, depending on how much product you apply per session.</p>",
            "icon": "box"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Do you offer a money-back guarantee?",
            "answer": "<p>Yes — refunds are available within 30 days of delivery for products that arrive damaged or defective. Just send us photos as proof; no need to ship anything back.</p>",
            "icon": "refresh"
          }
        }
      },
