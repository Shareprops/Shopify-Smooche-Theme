    "sm1c_pdp_faq": {
      "type": "sm1c-pdp-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Using the included brush, apply an even layer to clean, dry skin, avoiding the eye area, eyebrows, hairline, and lips. Leave on overnight, then peel off in one motion by morning and follow with your usual moisturizer.</p>",
            "icon": "droplet"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Is it safe to leave on overnight?",
            "answer": "<p>Yes — the formula is designed specifically for overnight wear, with Centella Asiatica included to keep it gentle on skin through the night. We still recommend a patch test before your first full application.</p>",
            "icon": "shield"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "What does the brush help with?",
            "answer": "<p>The included brush helps you apply an even, full-coverage layer without using your fingers — making it easier to get smooth, consistent results every time.</p>",
            "icon": "check"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "How soon will I see results?",
            "answer": "<p>Most people notice visibly firmer, brighter-looking skin by the very next morning. With consistent use 1–2 times a week, sagging and dullness continue to look more improved over time.</p>",
            "icon": "clock"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "How long does one bottle last?",
            "answer": "<p>At 2.65 fl.oz, with 1–2 uses per week, one bottle typically lasts 6–8 weeks depending on how much product you apply per session.</p>",
            "icon": "box"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Do you offer a money-back guarantee?",
            "answer": "<p>Yes — refunds are available within 30 days of delivery for products that arrive damaged or defective. Just send us photos as proof; no need to ship anything back.</p>",
            "icon": "refresh"
          }
        }
      },
