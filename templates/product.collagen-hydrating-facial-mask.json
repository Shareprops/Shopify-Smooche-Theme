    "sm1c_pdp_faq": {
      "type": "sm1c-pdp-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Unfold the sheet mask and smooth it onto clean, dry skin, aligning the eye and mouth openings. Leave on for 10–15 minutes, then remove and pat any remaining essence into your skin — no rinsing needed.</p>",
            "icon": "droplet"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "How often should I use it?",
            "answer": "<p>For best results, use 2–3 times per week as part of your evening routine. Consistency is what builds visibly firmer, more hydrated skin over time.</p>",
            "icon": "calendar"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Is it safe for sensitive skin?",
            "answer": "<p>Yes — the formula is gentle and includes Centella Asiatica to help keep skin calm and comfortable. We still recommend a patch test before your first full application.</p>",
            "icon": "shield"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "Will it feel wet or sticky?",
            "answer": "<p>The sheet is fully soaked in essence, so it will feel wet while it's on — but the essence absorbs in fully, leaving skin soft and hydrated, never sticky.</p>",
            "icon": "check"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "How many masks come in one pack?",
            "answer": "<p>This product comes in 2, 5, or 15-piece packs, so you can choose the option that best fits how often you plan to use it.</p>",
            "icon": "box"
          }
        },
        "q_6": {
          "type": "question",
          "settings": {
            "question": "Do you offer a money-back guarantee?",
            "answer": "<p>Yes — refunds are available within 30 days of delivery for products that arrive damaged or defective. Just send us photos as proof; no need to ship anything back.</p>",
            "icon": "refresh"
          }
        }
      },
