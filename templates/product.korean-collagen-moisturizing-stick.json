    "sm1c_pdp_faq": {
      "type": "sm1c-pdp-faq",
      "blocks": {
        "q_1": {
          "type": "question",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Twist up the stick and glide it directly onto clean skin — face, lips, or any dry area. Gently pat or massage in until fully absorbed. No rinsing needed.</p>",
            "icon": "droplet"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Can I use it on my lips too?",
            "answer": "<p>Yes — the formula is gentle and versatile enough to use on your face, lips, and any dry spots that need extra moisture.</p>",
            "icon": "heart"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "How soon will I see results?",
            "answer": "<p>Most people notice an instant hydration boost the moment it touches their skin. With daily use, fine lines and firmness continue to improve over the following weeks.</p>",
            "icon": "clock"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
