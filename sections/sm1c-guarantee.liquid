{%- style -%}
#shopify-section-{{ section.id }} .sm1c-gt-wrap {
  padding: 64px clamp(20px, 4vw, 44px);
  background: {{ section.settings.bg_color }};
  font-family: var(--sm1c-sans, sans-serif);
  text-align: center;
}
#shopify-section-{{ section.id }} .sm1c-gt-eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: {{ section.settings.accent_color }};
  margin-bottom: 12px;
}
#shopify-section-{{ section.id }} .sm1c-gt-heading {
  font-family: var(--sm1c-serif, serif);
  font-size: clamp(28px, 3vw, 38px);
  font-weight: 500;
  line-height: 1.15;
  color: var(--sm1c-ink, #2b211d);
  margin: 0 auto 14px;
  max-width: 620px;
}
#shopify-section-{{ section.id }} .sm1c-gt-heading em {
  font-style: italic;
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-gt-sub {
  font-size: 15px;
  line-height: 1.6;
  color: rgba(43, 33, 29, .65);
  max-width: 540px;
  margin: 0 auto 44px;
}
#shopify-section-{{ section.id }} .sm1c-gt-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: clamp(20px, 3vw, 44px);
  max-width: 1000px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .sm1c-gt-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
}
#shopify-section-{{ section.id }} .sm1c-gt-icon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: {{ section.settings.icon_bg }};
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-gt-icon svg {
  width: 26px;
  height: 26px;
}
#shopify-section-{{ section.id }} .sm1c-gt-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--sm1c-ink, #2b211d);
}
#shopify-section-{{ section.id }} .sm1c-gt-body {
  font-size: 13.5px;
  line-height: 1.6;
  color: rgba(43, 33, 29, .62);
  max-width: 260px;
}
#shopify-section-{{ section.id }} .sm1c-gt-cta {
  display: inline-block;
  margin-top: 44px;
  background: var(--sm1c-rose-deep, #C2506A);
  color: #fff;
  padding: 16px 34px;
  border-radius: 4px;
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  text-decoration: none;
  transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
}
#shopify-section-{{ section.id }} .sm1c-gt-cta:hover {
  background: {{ section.settings.accent_color }};
  transform: translateY(-2px);
  box-shadow: 0 12px 24px -10px rgba(194, 80, 106, .55);
}
#shopify-section-{{ section.id }} .sm1c-gt-note {
  margin-top: 16px;
  font-size: 12.5px;
  color: rgba(43, 33, 29, .55);
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-gt-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }
}
{%- endstyle -%}

<div class="sm1c-gt-wrap">
  {%- if section.settings.eyebrow != blank -%}
    <div class="sm1c-gt-eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}
  <h2 class="sm1c-gt-heading">{{ section.settings.heading }}{%- if section.settings.heading_accent != blank -%} <em>{{ section.settings.heading_accent }}</em>{%- endif -%}</h2>
  {%- if section.settings.subtext != blank -%}
    <div class="sm1c-gt-sub">{{ section.settings.subtext }}</div>
  {%- endif -%}

  <div class="sm1c-gt-grid">
    {%- for block in section.blocks -%}
      <div class="sm1c-gt-item" {{ block.shopify_attributes }}>
        <span class="sm1c-gt-icon">
          {%- case block.settings.icon -%}
            {%- when 'refresh' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.5-5.8"/><path d="M20 4v4.5h-4.5"/></svg>
            {%- when 'truck' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h10v9H3zM13 10h4.5l2.5 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
            {%- when 'lock' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="10" width="15" height="10" rx="2"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10"/></svg>
            {%- when 'headset' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="2.5" y="13.5" width="4" height="6" rx="1.6"/><rect x="17.5" y="13.5" width="4" height="6" rx="1.6"/></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c4 1 7 1 7 1v7c0 5-3 8-7 10-4-2-7-5-7-10V4s3 0 7-1Z"/><path d="m9.2 12 1.9 1.9L14.9 10"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>
          {%- endcase -%}
        </span>
        <div class="sm1c-gt-title">{{ block.settings.title }}</div>
        <div class="sm1c-gt-body">{{ block.settings.body }}</div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.button_label != blank -%}
    <a href="{{ section.settings.button_link | default: '#' }}" class="sm1c-gt-cta">{{ section.settings.button_label }}</a>
  {%- endif -%}
  {%- if section.settings.note != blank -%}
    <div class="sm1c-gt-note">{{ section.settings.note }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "SM1C Guarantee",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop With Confidence" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Backed by Our" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "Money-Back Guarantee" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "If your order arrives damaged or expired, just send us photos within 30 days of delivery — we'll process your refund, no return shipping needed." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Small note under button", "default": "Questions? Our team replies within 24 hours." },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "icon_bg", "label": "Icon circle background", "default": "#FBE9EC" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E8637E" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Guarantee item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "refresh", "label": "Returns / refresh" },
            { "value": "truck", "label": "Shipping truck" },
            { "value": "lock", "label": "Secure lock" },
            { "value": "headset", "label": "Support headset" },
            { "value": "shield", "label": "Shield" },
            { "value": "check", "label": "Check" }
          ],
          "default": "refresh"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "30-Day Guarantee" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Damaged or expired item? Send proof within 30 days and we'll refund you — no need to ship it back." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "SM1C Guarantee",
      "blocks": [
        { "type": "item", "settings": { "icon": "refresh", "title": "30-Day Returns", "body": "Not a match? Send it back within 30 days for a full refund." } },
        { "type": "item", "settings": { "icon": "truck", "title": "Free U.S. Shipping", "body": "Free on every order, shipped from within the U.S." } },
        { "type": "item", "settings": { "icon": "lock", "title": "Secure Checkout", "body": "Encrypted payments via Shop Pay, Apple Pay, and all major cards." } }
      ]
    }
  ]
}
{% endschema %}
