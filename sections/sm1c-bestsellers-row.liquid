      "default": "Top-rated essentials that transform your skincare ritual."
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand label shown on each card",
      "default": "serein"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link label",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#fdfaf6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Badge accent color",
      "default": "#E8637E"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (optional, overrides fields below)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge_text",
