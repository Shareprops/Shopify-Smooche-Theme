{%- style -%}
#shopify-section-{{ section.id }} .sm1c-ts-wrap {
  font-family: 'Work Sans', sans-serif;
  padding: 60px 44px 24px;
  color: #3A2E27;
}
#shopify-section-{{ section.id }} .sm1c-ts-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 28px;
  font-weight: 400;
  margin: 0 0 6px;
}
#shopify-section-{{ section.id }} .sm1c-ts-subtitle {
  font-size: 13px;
  color: rgba(58, 46, 39, .8);
  margin-bottom: 28px;
}
#shopify-section-{{ section.id }} .sm1c-ts-row {
  display: flex;
  gap: 22px;
  overflow-x: auto;
}
#shopify-section-{{ section.id }} .sm1c-ts-item {
  flex: 1 1 220px;
  min-width: 220px;
  display: flex;
  align-items: center;
}
#shopify-section-{{ section.id }} .sm1c-ts-rank {
  flex: none;
  width: 70px;
  text-align: right;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 90px;
  font-weight: 400;
  line-height: 1;
  color: #111;
  z-index: 1;
  user-select: none;
}
#shopify-section-{{ section.id }} .sm1c-ts-card {
  flex: 1;
  margin-left: -10%;
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 12px 30px rgba(0,0,0,.14);
  z-index: 2;
  background: #fff;
  text-decoration: none;
  color: inherit;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-ts-card-img {
  height: 170px;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-ts-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-ts-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: #E8637E;
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  padding: 5px 10px;
  border-radius: 100px;
}
#shopify-section-{{ section.id }} .sm1c-ts-info {
  padding: 14px;
}
#shopify-section-{{ section.id }} .sm1c-ts-name {
  font-size: 13px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-ts-price {
  font-size: 13px;
  font-weight: 700;
  margin-top: 4px;
}
#shopify-section-{{ section.id }} .sm1c-ts-compare {
  text-decoration: line-through;
  color: oklch(60% 0.01 30);
  font-weight: 500;
  font-size: 12px;
}
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .sm1c-ts-wrap { padding: 44px 20px 20px; }
}
{%- endstyle -%}

<div class="sm1c-ts-wrap">
  <h2 class="sm1c-ts-title">{{ section.settings.title }}</h2>
  {%- if section.settings.subtitle != blank -%}
    <div class="sm1c-ts-subtitle">{{ section.settings.subtitle }}</div>
  {%- endif -%}
  <div class="sm1c-ts-row">
    {%- for block in section.blocks -%}
      {%- if block.type == 'product' and block.settings.product != blank -%}
        {%- assign p = block.settings.product -%}
        <div class="sm1c-ts-item" {{ block.shopify_attributes }}>
          <div class="sm1c-ts-rank">{{ forloop.index }}</div>
          <a href="{{ p.url }}" class="sm1c-ts-card">
            <div class="sm1c-ts-card-img">
              {%- if p.featured_image != blank -%}
                {{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: p.title }}
              {%- endif -%}
            </div>
            {%- if block.settings.badge_text != blank -%}
              <div class="sm1c-ts-badge">{{ block.settings.badge_text }}</div>
            {%- endif -%}
            <div class="sm1c-ts-info">
              <div class="sm1c-ts-name">{{ p.title }}</div>
              <div class="sm1c-ts-price">
                {{ p.price | money }}
                {%- if p.compare_at_price > p.price -%}
                  <span class="sm1c-ts-compare">{{ p.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
            </div>
          </a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SM1C Top Sellers",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Top 5 Best-Sellers This Week" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Updated every Monday" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge_text", "label": "Badge text", "default": "BEST SELLER" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "SM1C Top Sellers",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
