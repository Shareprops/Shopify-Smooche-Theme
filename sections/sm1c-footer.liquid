{%- style -%}
#shopify-section-{{ section.id }} .sm1c-foot-wrap {
  padding: 56px 44px;
  background: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  font-family: 'Work Sans', sans-serif;
  overflow-x: hidden;
}
#shopify-section-{{ section.id }} .sm1c-foot-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.4fr);
  gap: 32px;
}
#shopify-section-{{ section.id }} .sm1c-foot-logo {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 18px;
  font-weight: 800;
  margin-bottom: 12px;
}
#shopify-section-{{ section.id }} .sm1c-foot-blurb {
  font-size: 12px;
  line-height: 1.6;
  opacity: .7;
}
#shopify-section-{{ section.id }} .sm1c-foot-col-title {
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 12px;
  letter-spacing: .05em;
  opacity: .85;
  text-transform: uppercase;
}
#shopify-section-{{ section.id }} .sm1c-foot-links {
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: 12px;
  line-height: 2;
  opacity: .75;
}
#shopify-section-{{ section.id }} .sm1c-foot-links a {
  color: inherit;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-foot-signup {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}
#shopify-section-{{ section.id }} .sm1c-foot-signup input {
  flex: 1;
  min-width: 0;
  background: rgba(255,255,255,.1);
  border: none;
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 12px;
  color: inherit;
}
#shopify-section-{{ section.id }} .sm1c-foot-signup input::placeholder {
  color: currentColor;
  opacity: .65;
}
#shopify-section-{{ section.id }} .sm1c-foot-signup button {
  background: {{ section.settings.accent_color }};
  border: none;
  border-radius: 12px;
  width: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #fff;
  cursor: pointer;
}
#shopify-section-{{ section.id }} .sm1c-foot-bottom {
  border-top: 1px solid rgba(255,255,255,.15);
  margin-top: 36px;
  padding-top: 18px;
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  opacity: .55;
  flex-wrap: wrap;
  gap: 8px;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-foot-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
}
@media (max-width: 520px) {
  #shopify-section-{{ section.id }} .sm1c-foot-wrap {
    padding: 44px 24px;
  }
  #shopify-section-{{ section.id }} .sm1c-foot-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
}
{%- endstyle -%}

<div class="sm1c-foot-wrap">
  <div class="sm1c-foot-grid">
    <div>
      <div class="sm1c-foot-logo">{{ section.settings.logo_text }}</div>
      <div class="sm1c-foot-blurb">{{ section.settings.blurb }}</div>
    </div>
    {%- for block in section.blocks -%}
      {%- if block.type == 'link_column' -%}
        <div {{ block.shopify_attributes }}>
          <div class="sm1c-foot-col-title">{{ block.settings.title }}</div>
          <ul class="sm1c-foot-links">
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}
    <div>
      <div class="sm1c-foot-col-title">{{ section.settings.signup_title }}</div>
      <form class="sm1c-foot-signup" action="/contact#footer" method="post">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="email" name="contact[email]" placeholder="Your email" required>
        <button type="submit" aria-label="Subscribe">→</button>
      </form>
    </div>
  </div>
  <div class="sm1c-foot-bottom">
    <span>{{ section.settings.copyright }}</span>
    <span>{{ section.settings.social_text }}</span>
  </div>
</div>

{% schema %}
{
  "name": "SM1C Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "smooche"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "A solutions-oriented beauty brand, creating a world where everyone feels confident."
    },
    {
      "type": "text",
      "id": "signup_title",
      "label": "Signup column title",
      "default": "STAY IN TOUCH"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "© 2026 Smooche"
    },
    {
      "type": "text",
      "id": "social_text",
      "label": "Social text",
      "default": "Instagram · TikTok · Follow on Shop"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#2e1810"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f0e6df"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Signup button color",
      "default": "#c24a2e"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column title",
          "default": "MAIN MENU"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "SM1C Footer",
      "blocks": [
        { "type": "link_column", "settings": { "title": "MAIN MENU" } },
        { "type": "link_column", "settings": { "title": "USEFUL LINKS" } }
      ]
    }
  ]
}
{% endschema %}
