{%- style -%}
#shopify-section-{{ section.id }} .sm1c-foot-wave-wrap {
  position: relative;
  width: 100%;
  height: 72px;
  overflow: hidden;
  margin-bottom: -1px;
  /* Base color — anywhere neither wave path reaches shows this, never the
     page's white background. */
  background: var(--sm1c-rose-soft, #FBE9EC);
}
#shopify-section-{{ section.id }} .sm1c-foot-wave {
  position: absolute;
  left: 0;
  bottom: 0;
  display: block;
  width: 100%;
  height: 100%;
}
#shopify-section-{{ section.id }} .sm1c-foot-wave--back {
  z-index: 1;
}
#shopify-section-{{ section.id }} .sm1c-foot-wave--front {
  z-index: 2;
}
#shopify-section-{{ section.id }} .sm1c-foot-wrap {
  padding: 56px 44px;
  background: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  font-family: var(--sm1c-sans, sans-serif);
  overflow-x: hidden;
}
#shopify-section-{{ section.id }} .sm1c-foot-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.4fr);
  gap: 32px;
}
#shopify-section-{{ section.id }} .sm1c-foot-logo {
  margin-bottom: 14px;
  display: inline-flex;
}
#shopify-section-{{ section.id }} .sm1c-foot-logo-mark {
  display: block;
  height: 28px;
  width: 59px;
  background-color: {{ section.settings.accent_color }};
  -webkit-mask-image: url({{ 'serein-logo.png' | asset_url }});
  mask-image: url({{ 'serein-logo.png' | asset_url }});
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-position: center left;
  mask-position: center left;
}
#shopify-section-{{ section.id }} .sm1c-foot-blurb {
  font-size: 12.5px;
  line-height: 1.65;
  opacity: .75;
  max-width: 260px;
}
#shopify-section-{{ section.id }} .sm1c-foot-col-title {
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 12px;
  letter-spacing: .05em;
  opacity: .85;
  text-transform: uppercase;
}
#shopify-section-{{ section.id }} .sm1c-foot-links {
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: 12px;
  line-height: 2;
  opacity: .75;
}
#shopify-section-{{ section.id }} .sm1c-foot-links a {
  color: inherit;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-foot-signup {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}
#shopify-section-{{ section.id }} .sm1c-foot-signup input {
  flex: 1;
  min-width: 0;
  background: rgba(255,255,255,.1);
  border: none;
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 12px;
  color: inherit;
}
#shopify-section-{{ section.id }} .sm1c-foot-signup input::placeholder {
  color: currentColor;
  opacity: .65;
}
#shopify-section-{{ section.id }} .sm1c-foot-signup input:focus-visible {
  outline: 2px solid {{ section.settings.accent_color }};
  outline-offset: 2px;
}
#shopify-section-{{ section.id }} .sm1c-foot-signup button {
  background: {{ section.settings.accent_color }};
  border: none;
  border-radius: 12px;
  width: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: #fff;
  cursor: pointer;
}
#shopify-section-{{ section.id }} .sm1c-foot-signup button:focus-visible {
  outline: 2px solid {{ section.settings.text_color }};
  outline-offset: 2px;
}
#shopify-section-{{ section.id }} .sm1c-foot-bottom {
  border-top: 1px solid rgba(255,255,255,.15);
  margin-top: 36px;
  padding-top: 18px;
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  opacity: .55;
  flex-wrap: wrap;
  gap: 8px;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-foot-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
}
@media (max-width: 520px) {
  #shopify-section-{{ section.id }} .sm1c-foot-wrap {
    padding: 44px 24px;
  }
  #shopify-section-{{ section.id }} .sm1c-foot-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
}
{%- endstyle -%}

<div class="sm1c-foot-wave-wrap">
  <svg class="sm1c-foot-wave sm1c-foot-wave--back" viewBox="0 0 1440 56" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,26 C90,4 200,50 320,28 C430,8 520,48 630,40 C740,32 810,2 920,14 C1030,26 1110,52 1220,32 C1310,16 1370,40 1440,22 L1440,56 L0,56 Z" fill="#F6D3D9"></path>
  </svg>
  <svg class="sm1c-foot-wave sm1c-foot-wave--front" viewBox="0 0 1440 56" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,18 C110,50 210,2 340,16 C460,29 560,0 690,10 C810,20 880,52 990,34 C1100,17 1180,0 1290,10 C1360,16 1400,36 1440,24 L1440,56 L0,56 Z" fill="{{ section.settings.bg_color }}"></path>
  </svg>
</div>
<div class="sm1c-foot-wrap">
  <div class="sm1c-foot-grid">
    <div>
      <div class="sm1c-foot-logo" aria-label="{{ section.settings.logo_text }}">
        <span class="sm1c-foot-logo-mark"></span>
      </div>
      <div class="sm1c-foot-blurb">{{ section.settings.blurb }}</div>
    </div>
    {%- for block in section.blocks -%}
      {%- if block.type == 'link_column' -%}
        <div {{ block.shopify_attributes }}>
          <div class="sm1c-foot-col-title">{{ block.settings.title }}</div>
          <ul class="sm1c-foot-links">
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}
    <div>
      <div class="sm1c-foot-col-title">{{ section.settings.signup_title }}</div>
      <form class="sm1c-foot-signup" action="/contact#footer" method="post">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="email" name="contact[email]" placeholder="Your email" required>
        <button type="submit" aria-label="Subscribe">→</button>
      </form>
    </div>
  </div>
  <div class="sm1c-foot-bottom">
    <span>{{ section.settings.copyright }}</span>
    <span>{{ section.settings.social_text }}</span>
  </div>
</div>

{% schema %}
{
  "name": "SM1C Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Serein"
    },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Brand blurb",
      "default": "Korean-inspired skincare rituals crafted for visible results — clean ingredients, real glass skin."
    },
    {
      "type": "text",
      "id": "signup_title",
      "label": "Signup column title",
      "default": "STAY IN TOUCH"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "© 2026 Serein"
    },
    {
      "type": "text",
      "id": "social_text",
      "label": "Social text",
      "default": "Instagram · TikTok · Follow on Shop"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#3A2E27"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f0e6df"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Signup button color",
      "default": "#E8637E"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column title",
          "default": "MAIN MENU"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "SM1C Footer",
      "blocks": [
        { "type": "link_column", "settings": { "title": "MAIN MENU" } },
        { "type": "link_column", "settings": { "title": "USEFUL LINKS" } }
      ]
    }
  ]
}
{% endschema %}
