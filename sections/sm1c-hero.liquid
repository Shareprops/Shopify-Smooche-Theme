{%- style -%}
#shopify-section-{{ section.id }} .sm1c-hero {
  position: relative;
  height: {{ section.settings.height }}px;
  background: linear-gradient(135deg, {{ section.settings.gradient_from }}, {{ section.settings.gradient_to }});
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-hero-media {
  position: absolute;
  right: 6%;
  top: 8%;
  width: 44%;
  height: 84%;
  border-radius: 28px;
  overflow: hidden;
  background-image: repeating-linear-gradient(135deg, rgba(255,255,255,.35) 0 10px, rgba(255,255,255,.2) 10px 20px);
}
#shopify-section-{{ section.id }} .sm1c-hero-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-hero-content {
  position: absolute;
  left: 60px;
  top: 90px;
  max-width: 460px;
  color: #fff;
  font-family: 'Work Sans', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,.25);
  backdrop-filter: blur(8px);
  padding: 8px 16px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 22px;
}
#shopify-section-{{ section.id }} .sm1c-hero-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 68px;
  line-height: 1;
  font-weight: 800;
  margin: 0;
}
#shopify-section-{{ section.id }} .sm1c-hero-subtext {
  margin-top: 20px;
  font-size: 16px;
  line-height: 1.5;
  max-width: 380px;
  opacity: .95;
}
#shopify-section-{{ section.id }} .sm1c-hero-ctas {
  display: flex;
  gap: 14px;
  margin-top: 30px;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .sm1c-btn-primary {
  background: #111;
  color: #fff;
  padding: 16px 30px;
  border-radius: 14px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  display: inline-block;
}
#shopify-section-{{ section.id }} .sm1c-btn-secondary {
  background: rgba(255,255,255,.2);
  border: 1.5px solid rgba(255,255,255,.7);
  color: #fff;
  padding: 16px 30px;
  border-radius: 14px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  display: inline-block;
}
#shopify-section-{{ section.id }} .sm1c-hero-chip {
  position: absolute;
  left: 60px;
  bottom: 40px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fff;
  padding: 12px 18px;
  border-radius: 14px;
  font-size: 12px;
  font-weight: 600;
  color: #111;
  max-width: 400px;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-hero {
    height: auto;
    min-height: 640px;
  }
  #shopify-section-{{ section.id }} .sm1c-hero-media {
    right: 0;
    left: 0;
    width: 100%;
    top: 0;
    height: 45%;
    border-radius: 0;
  }
  #shopify-section-{{ section.id }} .sm1c-hero-content {
    left: 24px;
    right: 24px;
    top: 47%;
    max-width: none;
  }
  #shopify-section-{{ section.id }} .sm1c-hero-title {
    font-size: 40px;
  }
  #shopify-section-{{ section.id }} .sm1c-hero-chip {
    left: 24px;
    right: 24px;
    bottom: 20px;
    max-width: none;
  }
}
{%- endstyle -%}

<div class="sm1c-hero">
  <div class="sm1c-hero-media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', alt: section.settings.image.alt }}
    {%- endif -%}
  </div>
  <div class="sm1c-hero-content">
    <div class="sm1c-hero-badge">★★★★★ {{ section.settings.badge_text }}</div>
    <h1 class="sm1c-hero-title">{{ section.settings.title }}</h1>
    <div class="sm1c-hero-subtext">{{ section.settings.subtext }}</div>
    <div class="sm1c-hero-ctas">
      {%- if section.settings.button_1_label != blank -%}
        <a href="{{ section.settings.button_1_link | default: '#' }}" class="sm1c-btn-primary">{{ section.settings.button_1_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a href="{{ section.settings.button_2_link | default: '#' }}" class="sm1c-btn-secondary">{{ section.settings.button_2_label }}</a>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.chip_text != blank -%}
    <div class="sm1c-hero-chip">{{ section.settings.chip_text }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "SM1C Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Model portrait image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Rating badge text",
      "default": "Loved by 50,000+ customers"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Headline",
      "default": "Beauty inspired by you."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Skin-loving formulas designed for real routines — and the real you."
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Shop Bestsellers"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Shop The Foundation"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "chip_text",
      "label": "Trust chip text",
      "default": "Clinicians' Choice — 197 clinicians recommend Smooche"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Hero height (px)",
      "min": 400,
      "max": 800,
      "step": 20,
      "default": 600
    },
    {
      "type": "color",
      "id": "gradient_from",
      "label": "Gradient start",
      "default": "#e6b98a"
    },
    {
      "type": "color",
      "id": "gradient_to",
      "label": "Gradient end",
      "default": "#dd8f7a"
    }
  ],
  "presets": [
    {
      "name": "SM1C Hero"
    }
  ]
}
{% endschema %}
