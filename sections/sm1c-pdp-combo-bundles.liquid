{%- comment -%}
  Destination section for Pumper multi-product COMBO bundle widgets
  (.pmpr_bundle__root). Pumper injects those widgets into the product form
  inside sm1c-pdp-main; the mover script in that section relocates them here
  when this section is present on the template, so the combo offer lands
  after the shopper has read what the product actually does.

  This section renders no bundle markup of its own — it is purely a target
  container. It stays hidden until the mover actually places a widget inside
  it, so products that belong to no combo show nothing at all rather than an
  empty heading.

  Quantity tiers (Buy 1 / Buy 2 / Buy 3 of the same product) are a separate
  feature that lives in the buy box of sm1c-pdp-main and are deliberately
  NOT moved here — they need no product education to be understood.
{%- endcomment -%}

{%- style -%}
#shopify-section-{{ section.id }} .sm1c-combo-wrap {
  padding: 64px clamp(20px, 4vw, 44px);
  background: {{ section.settings.bg_color }};
  font-family: 'Work Sans', sans-serif;
  text-align: center;
}
#shopify-section-{{ section.id }} .sm1c-combo-wrap[hidden] {
  display: none;
}
#shopify-section-{{ section.id }} .sm1c-combo-eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: {{ section.settings.accent_color }};
  margin-bottom: 12px;
}
#shopify-section-{{ section.id }} .sm1c-combo-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: clamp(26px, 3vw, 32px);
  font-weight: 400;
  line-height: 1.15;
  color: var(--sm1c-ink, #2b211d);
  margin: 0 auto 14px;
  max-width: 620px;
}
#shopify-section-{{ section.id }} .sm1c-combo-title span {
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-combo-sub {
  font-size: 14px;
  line-height: 1.6;
  color: rgba(58, 46, 39, .8);
  max-width: 520px;
  margin: 0 auto 36px;
}
#shopify-section-{{ section.id }} .sm1c-combo-slot {
  max-width: 760px;
  margin: 0 auto;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
/* Pumper renders its own card chrome; give each combo room to breathe and
   keep it from inheriting the centred text of the wrapper. */
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__root {
  margin: 0;
  width: 100%;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-combo-wrap {
    padding: 48px 16px;
  }
}
{%- endstyle -%}

<div class="sm1c-combo-wrap" data-sm1c-combo-section hidden>
  {%- if section.settings.eyebrow != blank -%}
    <div class="sm1c-combo-eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="sm1c-combo-title">
      {{ section.settings.heading }}
      {%- if section.settings.heading_accent != blank %} <span>{{ section.settings.heading_accent }}</span>{% endif -%}
    </h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <div class="sm1c-combo-sub">{{ section.settings.subheading }}</div>
  {%- endif -%}
  <div class="sm1c-combo-slot" data-sm1c-combo-slot></div>
</div>

{% schema %}
{
  "name": "SM1C PDP Combo Bundles",
  "settings": [
    { "type": "paragraph", "content": "Destination for Pumper multi-product combo bundles. Stays hidden on products that belong to no combo. Quantity tiers (Buy 2 / Buy 3) are unaffected and remain in the buy box." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bundle & Save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pair it with the" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (colored)", "default": "full ritual" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Now that you know how it works — add the products it works best with and save on the set." },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FDF4F1" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E8637E" }
  ],
  "presets": [
    { "name": "SM1C PDP Combo Bundles" }
  ]
}
{% endschema %}
