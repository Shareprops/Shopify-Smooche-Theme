{%- comment -%}
  Destination section for Pumper multi-product COMBO bundle widgets
  (.pmpr_bundle__root). Pumper injects those widgets into the product form
  inside sm1c-pdp-main; the mover script in that section relocates them here
  when this section is present on the template, so the combo offer lands
  after the shopper has read what the product actually does.

  This section renders no bundle markup of its own — it is purely a target
  container. It stays hidden until the mover actually places a widget inside
  it, so products that belong to no combo show nothing at all rather than an
  empty heading.

  Quantity tiers (Buy 1 / Buy 2 / Buy 3 of the same product) are a separate
  feature that lives in the buy box of sm1c-pdp-main and are deliberately
  NOT moved here — they need no product education to be understood.
{%- endcomment -%}

{%- style -%}
#shopify-section-{{ section.id }} .sm1c-combo-wrap {
  padding: 64px clamp(20px, 4vw, 44px);
  background: {{ section.settings.bg_color }};
  font-family: 'Work Sans', sans-serif;
  text-align: center;
}
#shopify-section-{{ section.id }} .sm1c-combo-wrap[hidden] {
  display: none;
}
#shopify-section-{{ section.id }} .sm1c-combo-eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: {{ section.settings.accent_color }};
  margin-bottom: 12px;
}
#shopify-section-{{ section.id }} .sm1c-combo-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: clamp(26px, 3vw, 32px);
  font-weight: 400;
  line-height: 1.15;
  color: var(--sm1c-ink, #2b211d);
  margin: 0 auto 14px;
  max-width: 620px;
}
#shopify-section-{{ section.id }} .sm1c-combo-title span {
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-combo-sub {
  font-size: 14px;
  line-height: 1.6;
  color: rgba(58, 46, 39, .8);
  max-width: 520px;
  margin: 0 auto 36px;
}
#shopify-section-{{ section.id }} .sm1c-combo-slot {
  max-width: 760px;
  margin: 0 auto;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
/* ------------------------------------------------------------------
   Pumper widget restyling.

   Out of the box the combo card has a TRANSPARENT background and only a
   1px hairline shadow, so it dissolves into this section's tinted
   background — and its product rows (#FFF5F4) are nearly the same colour
   as the section itself (#FDF4F1). The result reads as flat pink-on-pink
   with no focal point.

   Pumper sets colours via INLINE styles driven by its own app settings,
   so overriding those specific properties requires !important. Anything
   it doesn't set inline (card, header, total) is overridden normally.
   ------------------------------------------------------------------ */
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__root {
  margin: 0;
  width: 100%;
  /* Solid white lifts the card off the tinted section — the core fix. */
  background: #fff;
  border: 1.5px solid rgba(232, 99, 126, .28);
  border-radius: 20px;
  padding: 24px 22px 22px;
  box-shadow: 0 18px 40px -22px rgba(43, 33, 29, .45), 0 2px 6px rgba(43, 33, 29, .05);
}

/* Bundle name — Pumper sets `font-family: inherit` inline (so it wants the
   theme's face) alongside its own colour/size/weight. Take the typography
   to match the theme's headings, but deliberately leave `color` alone so
   the merchant keeps controlling it from Pumper's app settings. */
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__title_text {
  font-family: 'Bricolage Grotesque', sans-serif !important;
  font-size: 20px !important;
  font-weight: 400 !important;
  line-height: 1.2;
}
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__header::after {
  content: '';
  display: block;
  width: 44px;
  height: 3px;
  border-radius: 2px;
  background: {{ section.settings.accent_color }};
  margin: 12px auto 4px;
}

/* Product rows: nudged off the section tint so they read as items sitting
   inside a white card rather than blending into the page. */
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__product {
  background-color: #FFF8F6 !important;
  border-color: rgba(58, 46, 39, .09) !important;
}
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__product_name_text {
  /* Pumper sets font-size: 14px inline, so this needs !important. */
  font-size: 15.5px !important;
  font-weight: 600;
  color: var(--sm1c-ink, #2b211d);
}
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__price_text {
  font-weight: 700;
  color: var(--sm1c-ink, #2b211d);
}

/* "Buy all at" row — was flat grey (#F5F5F5), which clashed with the rose
   palette and made the total look incidental. Treat it as the deal row. */
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__buy_all {
  background-color: #FBE9EC !important;
  border: 1.5px solid rgba(232, 99, 126, .3) !important;
  border-radius: 14px !important;
  margin-bottom: 14px;
}
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__footer_text {
  font-weight: 700;
  color: var(--sm1c-ink, #2b211d);
}
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__total_price_text {
  /* Pumper sets `font-family: inherit` inline, so this needs !important. */
  font-family: 'Bricolage Grotesque', sans-serif !important;
  font-size: 25px !important;
  font-weight: 400 !important;
  letter-spacing: -.02em;
  color: var(--sm1c-ink, #2b211d) !important;
}
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__highlight_offer {
  font-weight: 700 !important;
  font-size: 10.5px !important;
  letter-spacing: .1em;
  text-transform: uppercase;
  padding: 4px 11px;
  border-radius: 100px !important;
}

/* CTA — the flat 4px-radius, shadowless button was the weakest element on
   the page. Match the primary Add to Cart in sm1c-pdp-main so this reads
   as a real buy button. */
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__add_to_cart {
  background: linear-gradient(135deg, #ED7C93 0%, #E8637E 45%, #D14C67 100%) !important;
  border: none !important;
  border-radius: 14px !important;
  font-size: 15px !important;
  font-weight: 700 !important;
  text-transform: uppercase;
  letter-spacing: .04em;
  padding: 17px 16px !important;
  margin-top: 4px;
  cursor: pointer;
  box-shadow: 0 6px 16px -4px rgba(216, 68, 100, .55), 0 2px 4px rgba(216, 68, 100, .3);
  transition: transform .18s ease, box-shadow .18s ease;
}
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__add_to_cart:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 22px -4px rgba(216, 68, 100, .65), 0 3px 8px rgba(216, 68, 100, .4);
}
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__add_to_cart:active {
  transform: translateY(0) scale(.99);
}
@media (prefers-reduced-motion: no-preference) {
  #shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__add_to_cart {
    animation: sm1c-combo-pulse 2.6s ease-in-out infinite;
  }
  #shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__add_to_cart:hover {
    animation: none;
  }
}
@keyframes sm1c-combo-pulse {
  0%, 100% { box-shadow: 0 6px 16px -4px rgba(216, 68, 100, .55), 0 2px 4px rgba(216, 68, 100, .3); }
  50% { box-shadow: 0 6px 22px -2px rgba(216, 68, 100, .8), 0 2px 8px rgba(216, 68, 100, .45); }
}

/* Hide the "Powered by Pumper" branding badge that floats over the card. */
#shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr-branding-wrapper {
  display: none !important;
}

@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-combo-wrap {
    padding: 48px 16px;
  }
  #shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__root {
    padding: 20px 16px 18px;
    border-radius: 18px;
  }
  #shopify-section-{{ section.id }} .sm1c-combo-slot .pmpr_bundle__total_price_text {
    font-size: 22px !important;
  }
}
{%- endstyle -%}

<div class="sm1c-combo-wrap" data-sm1c-combo-section hidden>
  {%- if section.settings.eyebrow != blank -%}
    <div class="sm1c-combo-eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="sm1c-combo-title">
      {{ section.settings.heading }}
      {%- if section.settings.heading_accent != blank %} <span>{{ section.settings.heading_accent }}</span>{% endif -%}
    </h2>
  {%- endif -%}
  {%- if section.settings.subheading != blank -%}
    <div class="sm1c-combo-sub">{{ section.settings.subheading }}</div>
  {%- endif -%}
  <div class="sm1c-combo-slot" data-sm1c-combo-slot></div>
</div>

{% schema %}
{
  "name": "SM1C PDP Combo Bundles",
  "settings": [
    { "type": "paragraph", "content": "Destination for Pumper multi-product combo bundles. Stays hidden on products that belong to no combo. Quantity tiers (Buy 2 / Buy 3) are unaffected and remain in the buy box." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bundle & Save" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pair it with the" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (colored)", "default": "full ritual" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Now that you know how it works — add the products it works best with and save on the set." },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FDF4F1" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E8637E" }
  ],
  "presets": [
    { "name": "SM1C PDP Combo Bundles" }
  ]
}
{% endschema %}
