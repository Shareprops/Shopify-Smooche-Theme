{%- style -%}
#shopify-section-{{ section.id }} .sm1c-header {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 20px 44px;
  background: #fff;
  font-family: 'Work Sans', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-header-nav {
  display: flex;
  justify-self: start;
  gap: 24px;
  font-size: 12px;
  font-weight: 600;
  list-style: none;
  margin: 0;
  padding: 0;
}
#shopify-section-{{ section.id }} .sm1c-header-nav a {
  color: inherit;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-header-nav .sm1c-nav-highlight {
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-header-logo {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -.01em;
  color: #111;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-header-icons {
  display: flex;
  justify-self: end;
  gap: 18px;
  font-size: 13px;
  font-weight: 600;
  align-items: center;
}
#shopify-section-{{ section.id }} .sm1c-header-icons a {
  color: inherit;
  text-decoration: none;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-header {
    grid-template-columns: 1fr 1fr;
    row-gap: 12px;
    padding: 16px 20px;
  }
  #shopify-section-{{ section.id }} .sm1c-header-logo {
    justify-self: center;
  }
  #shopify-section-{{ section.id }} .sm1c-header-nav {
    grid-column: 1 / -1;
    order: 3;
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
  }
}
{%- endstyle -%}

<div class="sm1c-header">
  <ul class="sm1c-header-nav">
    {%- for link in section.settings.menu.links -%}
      {%- assign sm1c_is_current = false -%}
      {%- if link.url == request.path -%}
        {%- assign sm1c_is_current = true -%}
      {%- endif -%}
      <li><a href="{{ link.url }}"{% if link.title contains 'Sale' or sm1c_is_current %} class="sm1c-nav-highlight"{% endif %}>{{ link.title | upcase }}</a></li>
    {%- else -%}
      <li><a href="/collections/all">SHOP ALL</a></li>
      <li><a href="/pages/best-seller"{% if request.path == '/pages/best-seller' %} class="sm1c-nav-highlight"{% endif %}>BESTSELLERS</a></li>
      <li><a href="#">ACCESSORIES</a></li>
      <li><a href="#">ABOUT</a></li>
      <li><a href="#" class="sm1c-nav-highlight">SALE</a></li>
    {%- endfor -%}
  </ul>

  <a href="{{ routes.root_url }}" class="sm1c-header-logo">{{ section.settings.logo_text }}</a>

  <div class="sm1c-header-icons">
    <a href="{{ routes.search_url }}" aria-label="Search">◎</a>
    <a href="/account" aria-label="Account">♡</a>
    <a href="/account/login" aria-label="Login">◐</a>
    <a href="{{ routes.cart_url }}" aria-label="Cart" data-sm1c-cart-icon>Cart (<span data-sm1c-cart-count>{{ cart.item_count }}</span>)</a>
  </div>
</div>

{% render 'sm1c-cart-drawer' %}

{% schema %}
{
  "name": "SM1C Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "smooche"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (sale link)",
      "default": "#c24a2e"
    }
  ],
  "presets": [
    {
      "name": "SM1C Header"
    }
  ]
}
{% endschema %}
