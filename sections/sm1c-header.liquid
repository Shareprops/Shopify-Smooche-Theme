{%- style -%}
#shopify-section-{{ section.id }} .sm1c-header {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 20px 44px;
  background: var(--sm1c-bg, #fff);
  color: var(--sm1c-text, #111);
  font-family: 'Work Sans', sans-serif;
  transition: background .2s ease, color .2s ease;
}
#shopify-section-{{ section.id }} .sm1c-header-nav {
  display: flex;
  justify-self: start;
  gap: 24px;
  font-size: 12px;
  font-weight: 600;
  list-style: none;
  margin: 0;
  padding: 0;
}
#shopify-section-{{ section.id }} .sm1c-header-nav a {
  color: inherit;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-header-nav .sm1c-nav-highlight {
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-header-logo {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -.01em;
  color: var(--sm1c-text, #111);
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-header-icons {
  display: flex;
  justify-self: end;
  gap: 18px;
  font-size: 13px;
  font-weight: 600;
  align-items: center;
}
#shopify-section-{{ section.id }} .sm1c-header-icons a {
  color: inherit;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-icon-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  padding: 0;
  border: none;
  background: none;
  color: inherit;
  cursor: pointer;
  font-family: inherit;
}
#shopify-section-{{ section.id }} .sm1c-icon-btn svg {
  width: 20px;
  height: 20px;
}
#shopify-section-{{ section.id }} .sm1c-icon-btn .sm1c-icon-moon {
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-icon-btn .sm1c-icon-sun {
  display: none;
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-icon-btn .sm1c-icon-moon {
  display: none;
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-icon-btn .sm1c-icon-sun {
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-icon-badge {
  position: absolute;
  top: -6px;
  right: -8px;
  min-width: 16px;
  height: 16px;
  padding: 0 3px;
  border-radius: 999px;
  background: {{ section.settings.accent_color }};
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  line-height: 16px;
  text-align: center;
}
#shopify-section-{{ section.id }} .sm1c-icon-badge[hidden] {
  display: none;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-header {
    grid-template-columns: 1fr 1fr;
    row-gap: 12px;
    padding: 16px 20px;
  }
  #shopify-section-{{ section.id }} .sm1c-header-logo {
    justify-self: center;
  }
  #shopify-section-{{ section.id }} .sm1c-header-nav {
    grid-column: 1 / -1;
    order: 3;
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
  }
}
{%- endstyle -%}

<div class="sm1c-header">
  <ul class="sm1c-header-nav">
    {%- for link in section.settings.menu.links -%}
      {%- assign sm1c_is_current = false -%}
      {%- if link.url == request.path -%}
        {%- assign sm1c_is_current = true -%}
      {%- endif -%}
      <li><a href="{{ link.url }}"{% if link.title contains 'Sale' or sm1c_is_current %} class="sm1c-nav-highlight"{% endif %}>{{ link.title | upcase }}</a></li>
    {%- else -%}
      <li><a href="/collections/all">SHOP ALL</a></li>
      <li><a href="/pages/best-seller"{% if request.path == '/pages/best-seller' %} class="sm1c-nav-highlight"{% endif %}>BESTSELLERS</a></li>
      <li><a href="#">ACCESSORIES</a></li>
      <li><a href="#">ABOUT</a></li>
      <li><a href="#" class="sm1c-nav-highlight">SALE</a></li>
    {%- endfor -%}
  </ul>

  <a href="{{ routes.root_url }}" class="sm1c-header-logo">{{ section.settings.logo_text }}</a>

  <div class="sm1c-header-icons">
    <a href="/pages/favorite" class="sm1c-icon-btn" aria-label="Favorites">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
      </svg>
      <span class="sm1c-icon-badge" data-sm1c-wishlist-count hidden>0</span>
    </a>
    <button type="button" class="sm1c-icon-btn" data-sm1c-theme-toggle aria-label="Switch to dark theme" aria-pressed="false">
      <svg class="sm1c-icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="8.2" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <path d="M12 3.8a8.2 8.2 0 0 0 0 16.4z" fill="currentColor"/>
      </svg>
      <svg class="sm1c-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.2"/>
        <path d="M12 2.5v2.4M12 19.1v2.4M4.6 4.6l1.7 1.7M17.7 17.7l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.6 19.4l1.7-1.7M17.7 6.3l1.7-1.7"/>
      </svg>
    </button>
    <a href="{{ routes.cart_url }}" class="sm1c-icon-btn" aria-label="Cart" data-sm1c-cart-icon>
      {%- render 'icon-cart' -%}
      <span class="sm1c-icon-badge" data-sm1c-cart-count>{{ cart.item_count }}</span>
    </a>
  </div>
</div>

{% render 'sm1c-cart-drawer' %}
{{ 'sm1c-theme-toggle.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "SM1C Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "smooche"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (sale link)",
      "default": "#c24a2e"
    }
  ],
  "presets": [
    {
      "name": "SM1C Header"
    }
  ]
}
{% endschema %}
