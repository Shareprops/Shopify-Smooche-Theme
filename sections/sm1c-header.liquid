{%- style -%}
html {
  scroll-padding-top: var(--sm1c-header-height, 90px);
}
@media (prefers-reduced-motion: no-preference) {
  html {
    scroll-behavior: smooth;
  }
}
#shopify-section-{{ section.id }} {
  position: sticky;
  top: 0;
  z-index: 500;
}
#shopify-section-{{ section.id }} .sm1c-header {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 20px 44px;
  background: var(--sm1c-bg, #fff);
  color: var(--sm1c-text, #111);
  font-family: 'Work Sans', sans-serif;
  transition: background .2s ease, color .2s ease, box-shadow .3s ease, padding .25s ease;
  animation: sm1c-header-in .5s ease;
}
#shopify-section-{{ section.id }} .sm1c-header.is-scrolled {
  padding-top: 14px;
  padding-bottom: 14px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, .08);
}
@keyframes sm1c-header-in {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}
#shopify-section-{{ section.id }} .sm1c-header-nav {
  position: relative;
  display: flex;
  justify-self: start;
  gap: 28px;
  font-size: 12px;
  font-weight: 600;
  list-style: none;
  margin: 0;
  padding: 0;
}
#shopify-section-{{ section.id }} .sm1c-header-nav a {
  position: relative;
  display: inline-block;
  color: inherit;
  text-decoration: none;
  padding-bottom: 5px;
  transition: color .2s ease;
}
#shopify-section-{{ section.id }} .sm1c-header-nav a:hover {
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-nav-indicator {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 2px;
  width: 0;
  background: {{ section.settings.accent_color }};
  border-radius: 2px;
  opacity: 0;
  transform: translateX(0);
  transition: transform .3s cubic-bezier(.65, 0, .35, 1), width .3s cubic-bezier(.65, 0, .35, 1), opacity .2s ease;
  pointer-events: none;
}
#shopify-section-{{ section.id }} .sm1c-nav-indicator.is-active {
  opacity: 1;
}
#shopify-section-{{ section.id }} .sm1c-header-nav .sm1c-nav-highlight {
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-header-logo {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -.01em;
  color: var(--sm1c-text, #111);
  text-decoration: none;
  display: inline-block;
  transition: transform .25s ease;
}
#shopify-section-{{ section.id }} .sm1c-header-logo:hover {
  transform: scale(1.05);
}
#shopify-section-{{ section.id }} .sm1c-header-icons {
  display: flex;
  justify-self: end;
  gap: 18px;
  font-size: 13px;
  font-weight: 600;
  align-items: center;
}
#shopify-section-{{ section.id }} .sm1c-header-icons a {
  color: inherit;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-icon-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  padding: 0;
  border: none;
  background: none;
  color: inherit;
  cursor: pointer;
  font-family: inherit;
  transition: transform .2s ease, color .2s ease;
}
#shopify-section-{{ section.id }} .sm1c-icon-btn:hover {
  transform: translateY(-2px) scale(1.1);
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-icon-btn svg {
  width: 20px;
  height: 20px;
}
#shopify-section-{{ section.id }} .sm1c-icon-btn-account {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: none;
}
#shopify-section-{{ section.id }} .sm1c-icon-btn-account svg {
  width: 28px;
  height: 28px;
}
#shopify-section-{{ section.id }} .sm1c-icon-btn .sm1c-icon-moon {
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-icon-btn .sm1c-icon-sun {
  display: none;
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-icon-btn .sm1c-icon-moon {
  display: none;
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-icon-btn .sm1c-icon-sun {
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-icon-badge {
  position: absolute;
  top: -6px;
  right: -8px;
  min-width: 16px;
  height: 16px;
  padding: 0 3px;
  border-radius: 999px;
  background: {{ section.settings.accent_color }};
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  line-height: 16px;
  text-align: center;
}
#shopify-section-{{ section.id }} .sm1c-icon-badge[hidden] {
  display: none;
}
#shopify-section-{{ section.id }} .sm1c-icon-badge.sm1c-bump {
  animation: sm1c-badge-pop .45s ease;
}
@keyframes sm1c-badge-pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.4); }
  100% { transform: scale(1); }
}
#shopify-section-{{ section.id }} .sm1c-hamburger {
  display: none;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  padding: 0;
  border: none;
  background: none;
  color: inherit;
  cursor: pointer;
  justify-self: start;
}
#shopify-section-{{ section.id }} .sm1c-hamburger svg {
  width: 22px;
  height: 22px;
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer {
  position: fixed;
  inset: 0;
  z-index: 900;
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer[hidden] {
  display: none;
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer-overlay {
  position: absolute;
  inset: 0;
  background: rgba(20, 14, 10, .45);
  opacity: 0;
  transition: opacity .25s ease;
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer.is-open .sm1c-nav-drawer-overlay {
  opacity: 1;
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer-panel {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 82%;
  max-width: 320px;
  background: var(--sm1c-bg, #fff);
  color: var(--sm1c-text, #111);
  box-shadow: 12px 0 30px rgba(0, 0, 0, .15);
  transform: translateX(-100%);
  transition: transform .3s cubic-bezier(.65, 0, .35, 1);
  display: flex;
  flex-direction: column;
  padding: 24px 22px;
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer.is-open .sm1c-nav-drawer-panel {
  transform: translateX(0);
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer-logo {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 20px;
  font-weight: 800;
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer-close {
  background: none;
  border: none;
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  color: inherit;
  padding: 4px;
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer-list a {
  display: block;
  padding: 16px 2px;
  font-size: 15px;
  font-weight: 700;
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid rgba(0, 0, 0, .08);
}
#shopify-section-{{ section.id }} .sm1c-nav-drawer-list a.sm1c-nav-highlight {
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-mega-menu {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  max-height: 70vh;
  overflow: hidden;
  background: var(--sm1c-bg, #fff);
  box-shadow: 0 20px 40px rgba(0, 0, 0, .12);
  padding: 32px 44px;
  visibility: hidden;
  clip-path: inset(0 0 100% 0);
  transition: clip-path .45s cubic-bezier(.65, 0, .35, 1), visibility 0s .45s;
  transform-origin: top;
  z-index: 100;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu.is-open {
  visibility: visible;
  clip-path: inset(0 0 0% 0);
  transition: clip-path .45s cubic-bezier(.65, 0, .35, 1), visibility 0s 0s;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-layout {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 48px;
  max-width: 1280px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-nav {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32px 36px;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-nav-heading {
  display: block;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: .02em;
  color: inherit;
  text-decoration: none;
  margin-bottom: 14px;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-nav-heading:hover {
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-nav-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-nav-list a {
  display: block;
  font-family: 'Work Sans', sans-serif;
  font-size: 13.5px;
  font-weight: 500;
  line-height: 1.4;
  color: inherit;
  opacity: .85;
  text-decoration: none;
  transition: opacity .15s ease, color .15s ease;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-nav-list a:hover {
  opacity: 1;
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  align-content: start;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-card {
  position: relative;
  display: block;
  border-radius: 16px;
  overflow: hidden;
  height: 190px;
  background: #eee;
  text-decoration: none;
  color: #fff;
  box-shadow: 0 1px 3px rgba(0, 0, 0, .1);
  transition: box-shadow .25s ease, transform .25s ease;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-card:hover {
  box-shadow: 0 12px 28px rgba(0, 0, 0, .18);
  transform: translateY(-2px);
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, .1);
  z-index: 1;
  pointer-events: none;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .35s ease;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-card:hover img {
  transform: scale(1.05);
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-card-overlay {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24px;
  background: linear-gradient(to top, rgba(0, 0, 0, .85) 0%, rgba(0, 0, 0, .55) 35%, rgba(0, 0, 0, .15) 65%, rgba(0, 0, 0, 0) 100%);
  display: flex;
  flex-direction: column;
  gap: 4px;
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-card-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 20px;
  font-weight: 800;
  line-height: 1.2;
  text-shadow: 0 1px 4px rgba(0, 0, 0, .5);
}
#shopify-section-{{ section.id }} .sm1c-mega-menu-card-subtitle {
  font-size: 12px;
  font-weight: 500;
  opacity: .92;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .5);
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-header {
    grid-template-columns: auto 1fr auto;
    padding: 16px 20px;
  }
  #shopify-section-{{ section.id }} .sm1c-header.is-scrolled {
    padding-top: 12px;
    padding-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .sm1c-header-logo {
    justify-self: center;
  }
  #shopify-section-{{ section.id }} .sm1c-header-nav {
    display: none;
  }
  #shopify-section-{{ section.id }} .sm1c-hamburger {
    display: inline-flex;
  }
  #shopify-section-{{ section.id }} .sm1c-mega-menu {
    display: none !important;
  }
}
{%- endstyle -%}

{%- capture sm1c_nav_items -%}
  {%- for link in section.settings.menu.links -%}
    {%- assign sm1c_is_current = false -%}
    {%- if link.url == request.path -%}
      {%- assign sm1c_is_current = true -%}
    {%- endif -%}
    {%- assign sm1c_link_title_downcase = link.title | strip | downcase -%}
    <li><a href="{{ link.url }}"{% if link.title contains 'Sale' or sm1c_is_current %} class="sm1c-nav-highlight"{% endif %}{% if sm1c_link_title_downcase == 'shop all' %} data-sm1c-mega-trigger="shop-all"{% endif %}>{{ link.title | upcase }}</a></li>
  {%- else -%}
    <li><a href="{{ routes.root_url }}"{% if request.path == routes.root_url %} class="sm1c-nav-highlight"{% endif %} data-sm1c-mega-trigger="shop-all">SHOP ALL</a></li>
    <li><a href="/pages/best-seller"{% if request.path == '/pages/best-seller' %} class="sm1c-nav-highlight"{% endif %}>BEST SELLERS</a></li>
    <li><a href="/pages/hot-deals"{% if request.path == '/pages/hot-deals' %} class="sm1c-nav-highlight"{% endif %}>🔥 HOT DEALS</a></li>
    <li><a href="/pages/track-my-order"{% if request.path == '/pages/track-my-order' %} class="sm1c-nav-highlight"{% endif %}>TRACK MY ORDER</a></li>
  {%- endfor -%}
{%- endcapture -%}

{%- capture sm1c_mega_menu -%}
  {%- assign sm1c_mega_col_1 = collections['anti-aging'] -%}
  {%- assign sm1c_mega_col_2 = collections['daily-skincare-essentials'] -%}
  {%- assign sm1c_mega_col_3 = collections['beauty-tools-devices'] -%}
  {%- assign sm1c_mega_col_4 = collections['shapewear-body-shaping'] -%}
  <div class="sm1c-mega-menu" data-sm1c-mega-panel hidden>
    <div class="sm1c-mega-menu-layout">
      <div class="sm1c-mega-menu-nav">
        {%- for entry in (1..4) -%}
          {%- case entry -%}
            {%- when 1 -%}
              {%- assign sm1c_mega_collection = sm1c_mega_col_1 -%}
            {%- when 2 -%}
              {%- assign sm1c_mega_collection = sm1c_mega_col_2 -%}
            {%- when 3 -%}
              {%- assign sm1c_mega_collection = sm1c_mega_col_3 -%}
            {%- when 4 -%}
              {%- assign sm1c_mega_collection = sm1c_mega_col_4 -%}
          {%- endcase -%}
          {%- if sm1c_mega_collection -%}
            <div class="sm1c-mega-menu-nav-block">
              <a href="{{ sm1c_mega_collection.url }}" class="sm1c-mega-menu-nav-heading">{{ sm1c_mega_collection.title | upcase }}</a>
              <ul class="sm1c-mega-menu-nav-list">
                {%- for product in sm1c_mega_collection.products limit: 3 -%}
                  <li><a href="{{ product.url }}">{{ product.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="sm1c-mega-menu-grid">
        {%- for entry in (1..4) -%}
          {%- case entry -%}
            {%- when 1 -%}
              {%- assign sm1c_mega_collection = sm1c_mega_col_1 -%}
              {%- assign sm1c_mega_subtitle = 'Turn back the clock' -%}
            {%- when 2 -%}
              {%- assign sm1c_mega_collection = sm1c_mega_col_2 -%}
              {%- assign sm1c_mega_subtitle = 'Your everyday glow' -%}
            {%- when 3 -%}
              {%- assign sm1c_mega_collection = sm1c_mega_col_3 -%}
              {%- assign sm1c_mega_subtitle = 'Spa results at home' -%}
            {%- when 4 -%}
              {%- assign sm1c_mega_collection = sm1c_mega_col_4 -%}
              {%- assign sm1c_mega_subtitle = 'Smooth. Lift. Own it.' -%}
          {%- endcase -%}
          {%- if sm1c_mega_collection -%}
            <a href="{{ sm1c_mega_collection.url }}" class="sm1c-mega-menu-card">
              {%- if sm1c_mega_collection.image -%}
                {{ sm1c_mega_collection.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: sm1c_mega_collection.title, sizes: '(min-width: 750px) 20vw, 100vw', widths: '300, 450, 600' }}
              {%- endif -%}
              <span class="sm1c-mega-menu-card-overlay">
                <span class="sm1c-mega-menu-card-title">{{ sm1c_mega_collection.title }}</span>
                <span class="sm1c-mega-menu-card-subtitle">{{ sm1c_mega_subtitle }}</span>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endcapture -%}

<div class="sm1c-header">
  <button type="button" class="sm1c-hamburger" data-sm1c-nav-open aria-label="Open menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M3 6h18M3 12h18M3 18h18"/>
    </svg>
  </button>

  <ul class="sm1c-header-nav">
    {{ sm1c_nav_items }}
    <span class="sm1c-nav-indicator" data-sm1c-nav-indicator aria-hidden="true"></span>
  </ul>

  <a href="{{ routes.root_url }}" class="sm1c-header-logo">{{ section.settings.logo_text }}</a>

  <div class="sm1c-header-icons">
    {%- comment -%} Favorites icon and theme toggle temporarily removed for launch; dark-mode/wishlist code is kept elsewhere in the theme for future re-enable. {%- endcomment -%}
    <a href="{{ routes.account_url }}" class="sm1c-icon-btn sm1c-icon-btn-account" aria-label="{% if customer %}Account{% else %}Log in or sign up{% endif %}">
      <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-user" viewBox="0 0 192 192" fill="none" stroke-width="8">
        <path d="M96 168c39.765 0 72-32.235 72-72 0-39.764-32.235-72-72-72-39.764 0-72 32.236-72 72 0 39.765 32.236 72 72 72Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M96 120c16.569 0 30-13.431 30-30 0-16.569-13.431-30-30-30-16.569 0-30 13.431-30 30 0 16.569 13.431 30 30 30Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M47.85 149.55a54.002 54.002 0 0 1 76.399-21.577 54.005 54.005 0 0 1 19.901 21.577" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
    <a href="{{ routes.cart_url }}" class="sm1c-icon-btn" aria-label="Cart" data-sm1c-cart-icon>
      {%- render 'icon-cart' -%}
      <span class="sm1c-icon-badge" data-sm1c-cart-count>{{ cart.item_count }}</span>
    </a>
  </div>

  {{ sm1c_mega_menu }}
</div>

<div class="sm1c-nav-drawer" data-sm1c-nav-drawer hidden>
  <div class="sm1c-nav-drawer-overlay" data-sm1c-nav-drawer-close></div>
  <div class="sm1c-nav-drawer-panel">
    <div class="sm1c-nav-drawer-head">
      <span class="sm1c-nav-drawer-logo">{{ section.settings.logo_text }}</span>
      <button type="button" class="sm1c-nav-drawer-close" data-sm1c-nav-drawer-close aria-label="Close menu">✕</button>
    </div>
    <ul class="sm1c-nav-drawer-list">
      {{ sm1c_nav_items }}
    </ul>
  </div>
</div>

{% render 'sm1c-cart-drawer' %}

<script>
(function () {
  var headerEl = document.currentScript.closest('.shopify-section');
  if (!headerEl) return;
  var header = headerEl.querySelector('.sm1c-header');
  var badge = headerEl.querySelector('[data-sm1c-cart-count]');

  if (header) {
    var updateHeaderHeight = function () {
      document.documentElement.style.setProperty('--sm1c-header-height', header.offsetHeight + 'px');
    };
    var toggleScrolled = function () {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
      updateHeaderHeight();
    };
    toggleScrolled();
    window.addEventListener('scroll', toggleScrolled, { passive: true });
    window.addEventListener('resize', updateHeaderHeight);
  }

  if (badge && window.MutationObserver) {
    var lastCount = badge.textContent;
    new MutationObserver(function () {
      if (badge.textContent !== lastCount) {
        lastCount = badge.textContent;
        badge.classList.remove('sm1c-bump');
        void badge.offsetWidth;
        badge.classList.add('sm1c-bump');
      }
    }).observe(badge, { characterData: true, childList: true, subtree: true });
  }

  var nav = headerEl.querySelector('.sm1c-header-nav');
  var indicator = headerEl.querySelector('[data-sm1c-nav-indicator]');
  if (nav && indicator) {
    var navLinks = Array.prototype.slice.call(nav.querySelectorAll('a'));

    var moveIndicatorTo = function (el) {
      if (!el) {
        indicator.classList.remove('is-active');
        return;
      }
      var navRect = nav.getBoundingClientRect();
      var linkRect = el.getBoundingClientRect();
      indicator.style.width = linkRect.width + 'px';
      indicator.style.transform = 'translateX(' + (linkRect.left - navRect.left) + 'px)';
      indicator.classList.add('is-active');
    };

    var restingLink = nav.querySelector('a.sm1c-nav-highlight');

    navLinks.forEach(function (link) {
      link.addEventListener('mouseenter', function () { moveIndicatorTo(link); });
    });
    nav.addEventListener('mouseleave', function () { moveIndicatorTo(restingLink); });

    moveIndicatorTo(restingLink);
    window.addEventListener('resize', function () {
      var current = nav.querySelector('a:hover') || restingLink;
      moveIndicatorTo(current);
    });
  }

  var hamburger = headerEl.querySelector('[data-sm1c-nav-open]');
  var drawer = headerEl.querySelector('[data-sm1c-nav-drawer]');
  if (hamburger && drawer) {
    var openDrawer = function () {
      drawer.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () { drawer.classList.add('is-open'); });
    };
    var closeDrawer = function () {
      drawer.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(function () { drawer.hidden = true; }, 300);
    };
    hamburger.addEventListener('click', openDrawer);
    drawer.querySelectorAll('[data-sm1c-nav-drawer-close]').forEach(function (el) {
      el.addEventListener('click', closeDrawer);
    });
    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeDrawer);
    });
    document.addEventListener('keydown', function (evt) {
      if (evt.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
    });
  }

  var megaTrigger = headerEl.querySelector('[data-sm1c-mega-trigger="shop-all"]');
  var megaPanel = headerEl.querySelector('[data-sm1c-mega-panel]');
  if (megaTrigger && megaPanel) {
    var megaCloseTimer;

    var openMega = function () {
      clearTimeout(megaCloseTimer);
      megaPanel.hidden = false;
      // Force a synchronous layout read so the browser commits the closed
      // clip-path state before we transition to open — otherwise removing
      // `hidden` and adding `is-open` in the same frame can skip straight
      // to the end state with no visible animation.
      void megaPanel.offsetHeight;
      megaPanel.classList.add('is-open');
    };
    var closeMega = function () {
      megaCloseTimer = setTimeout(function () {
        megaPanel.classList.remove('is-open');
        setTimeout(function () { megaPanel.hidden = true; }, 460);
      }, 120);
    };

    megaTrigger.addEventListener('mouseenter', openMega);
    megaTrigger.addEventListener('mouseleave', closeMega);
    megaPanel.addEventListener('mouseenter', function () { clearTimeout(megaCloseTimer); });
    megaPanel.addEventListener('mouseleave', closeMega);
    megaTrigger.addEventListener('focus', openMega);
    document.addEventListener('keydown', function (evt) {
      if (evt.key === 'Escape' && megaPanel.classList.contains('is-open')) closeMega();
    });
  }
})();
</script>

