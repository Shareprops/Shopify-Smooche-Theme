{%- style -%}
#shopify-section-{{ section.id }} .sm1c-life-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin: 0 44px 60px;
  border-radius: 28px;
  overflow: hidden;
  background: {{ section.settings.bg_color }};
  font-family: 'Work Sans', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-life-img {
  height: 400px;
  background: #ddd;
}
#shopify-section-{{ section.id }} .sm1c-life-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-life-content {
  padding: 60px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
#shopify-section-{{ section.id }} .sm1c-life-heading {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 32px;
  font-weight: 800;
  margin: 0 0 16px;
}
#shopify-section-{{ section.id }} .sm1c-life-body {
  font-size: 14px;
  line-height: 1.6;
  max-width: 340px;
  margin-bottom: 22px;
  color: rgba(0,0,0,.65);
}
#shopify-section-{{ section.id }} .sm1c-life-btn {
  background: #111;
  color: #fff;
  padding: 15px 28px;
  border-radius: 14px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  display: inline-block;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-life-wrap {
    grid-template-columns: 1fr;
    margin: 0 20px 40px;
  }
  #shopify-section-{{ section.id }} .sm1c-life-content {
    padding: 32px;
  }
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-life-wrap {
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-life-body {
  color: rgba(240, 237, 232, .65);
}
{%- endstyle -%}

<div class="sm1c-life-wrap">
  <div class="sm1c-life-img">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading }}
    {%- endif -%}
  </div>
  <div class="sm1c-life-content">
    <div class="sm1c-life-heading">{{ section.settings.heading }}</div>
    <div class="sm1c-life-body">{{ section.settings.body }}</div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="sm1c-life-btn">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SM1C Lifestyle Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fuller lips, naturally."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Crafted from natural ingredients — hydrated, nourished volume, without harsh chemicals."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f6e6dd"
    }
  ],
  "presets": [
    {
      "name": "SM1C Lifestyle Banner"
    }
  ]
}
{% endschema %}
