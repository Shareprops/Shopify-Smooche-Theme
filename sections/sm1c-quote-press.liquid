{%- style -%}
#shopify-section-{{ section.id }} .sm1c-qp-wrap {
  display: grid;
  grid-template-columns: 1.1fr auto 1.4fr;
  align-items: center;
  gap: 40px;
  padding: 52px clamp(20px, 4vw, 44px);
  background: {{ section.settings.bg_color }};
  font-family: var(--sm1c-sans, sans-serif);
}
#shopify-section-{{ section.id }} .sm1c-qp-quote-mark {
  font-family: Georgia, serif;
  font-size: 60px;
  line-height: .6;
  color: {{ section.settings.accent_color }};
  opacity: .4;
  margin-bottom: 6px;
}
#shopify-section-{{ section.id }} .sm1c-qp-quote {
  font-family: var(--sm1c-serif, serif);
  font-style: italic;
  font-size: clamp(17px, 1.6vw, 20px);
  line-height: 1.45;
  color: var(--sm1c-ink, #2b211d);
  margin-bottom: 18px;
}
#shopify-section-{{ section.id }} .sm1c-qp-author {
  display: flex;
  align-items: center;
  gap: 12px;
}
#shopify-section-{{ section.id }} .sm1c-qp-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  overflow: hidden;
  background: var(--sm1c-rose-soft, #FBE9EC);
  flex: none;
}
#shopify-section-{{ section.id }} .sm1c-qp-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-qp-author-name {
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: var(--sm1c-ink, #2b211d);
}
#shopify-section-{{ section.id }} .sm1c-qp-author-role {
  font-size: 12px;
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-qp-divider {
  width: 1px;
  align-self: stretch;
  background: var(--sm1c-border, rgba(0,0,0,.08));
}
#shopify-section-{{ section.id }} .sm1c-qp-press {
  text-align: right;
}
#shopify-section-{{ section.id }} .sm1c-qp-press-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: rgba(43,33,29,.5);
  margin-bottom: 16px;
}
#shopify-section-{{ section.id }} .sm1c-qp-press-logos {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: clamp(20px, 3vw, 40px);
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .sm1c-qp-press-logo {
  font-family: var(--sm1c-serif, serif);
  font-size: clamp(16px, 1.6vw, 21px);
  font-weight: 600;
  letter-spacing: .01em;
  color: rgba(43,33,29,.55);
  white-space: nowrap;
}
@media (max-width: 989px) {
  #shopify-section-{{ section.id }} .sm1c-qp-wrap {
    grid-template-columns: 1fr;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .sm1c-qp-divider {
    display: none;
  }
  #shopify-section-{{ section.id }} .sm1c-qp-author {
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .sm1c-qp-press {
    text-align: center;
  }
  #shopify-section-{{ section.id }} .sm1c-qp-press-logos {
    justify-content: center;
  }
}
{%- endstyle -%}

<div class="sm1c-qp-wrap">
  <div>
    <div class="sm1c-qp-quote-mark">&ldquo;</div>
    <div class="sm1c-qp-quote">{{ section.settings.quote }}</div>
    <div class="sm1c-qp-author">
      <div class="sm1c-qp-avatar">
        {%- if section.settings.avatar != blank -%}
          {{ section.settings.avatar | image_url: width: 84 | image_tag: loading: 'lazy', alt: section.settings.author }}
        {%- endif -%}
      </div>
      <div>
        <div class="sm1c-qp-author-name">{{ section.settings.author }}</div>
        <div class="sm1c-qp-author-role">{{ section.settings.author_role }}</div>
      </div>
    </div>
  </div>

  <div class="sm1c-qp-divider"></div>

  <div class="sm1c-qp-press">
    <div class="sm1c-qp-press-label">{{ section.settings.press_label }}</div>
    <div class="sm1c-qp-press-logos">
      {%- for block in section.blocks -%}
        <span class="sm1c-qp-press-logo" {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SM1C Quote & Press",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "My skin has never felt this hydrated and glowing. These products are now a must in my routine!"
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Author photo"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author name",
      "default": "Jessica M."
    },
    {
      "type": "text",
      "id": "author_role",
      "label": "Author role",
      "default": "Verified Buyer"
    },
    {
      "type": "text",
      "id": "press_label",
      "label": "Press label",
      "default": "As Seen In"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#fdfaf6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#E8637E"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Publication name", "default": "Allure" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "SM1C Quote & Press",
      "blocks": [
        { "type": "logo", "settings": { "name": "Allure" } },
        { "type": "logo", "settings": { "name": "Byrdie" } },
        { "type": "logo", "settings": { "name": "Vogue" } },
        { "type": "logo", "settings": { "name": "Glamour" } }
      ]
    }
  ]
}
{% endschema %}
