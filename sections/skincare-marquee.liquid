{{ 'component-tickers.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --font-size: {{ section.settings.text_size }}rem;
    --font-weight: {{ section.settings.font_weight }};
    --corner-radius: {{ section.settings.corner_radius }}px;
    --glow-opacity: 0.12;
    background: var(--bg-color);
    display: block !important;
    visibility: visible !important;
    width: 100%;
  }

  .premium-marquee-wrapper-{{ section.id }} {
    overflow: hidden;
    width: 100%;
    background: var(--bg-color);
    border-top: 1px solid rgba(212, 160, 160, 0.25);
    border-bottom: 1px solid rgba(212, 160, 160, 0.25);
  }

  .premium-marquee-container-{{ section.id }} {
    display: flex;
    align-items: center;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .premium-marquee-track-{{ section.id }} {
    display: flex;
    white-space: nowrap;
    width: max-content;
    animation: premiumMarqueeAnimation-{{ section.id }} {{ 150 | divided_by: section.settings.speed }}s linear infinite;
    will-change: transform;
  }

  {%- if section.settings.hover_pause -%}
    @media screen and (min-width: 990px) {
      .premium-marquee-container-{{ section.id }}:hover .premium-marquee-track-{{ section.id }} {
        animation-play-state: paused;
      }
    }
  {%- endif -%}

  .premium-marquee-item-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    color: var(--text-color);
    letter-spacing: 0.04em;
    padding: 0 24px;
    font-family: var(--font-body-family), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    transition: color 0.3s ease;
  }

  .premium-marquee-item-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .premium-marquee-item-{{ section.id }} a:hover {
    opacity: 0.8;
  }

  .premium-marquee-item-{{ section.id }}--icon {
    font-size: 1.25em;
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }

  .premium-marquee-separator-{{ section.id }} {
    color: var(--accent-color);
    margin-left: 24px;
    font-weight: normal;
    font-size: 1.1em;
    user-select: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
  }

  @keyframes premiumMarqueeAnimation-{{ section.id }} {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --font-size: calc({{ section.settings.text_size }}rem * 0.85);
    }
    .premium-marquee-container-{{ section.id }} {
      padding: 10px 16px;
    }
    .premium-marquee-item-{{ section.id }} {
      padding: 0 16px;
    }
    .premium-marquee-separator-{{ section.id }} {
      margin-left: 16px;
    }
    .premium-marquee-track-{{ section.id }} {
      animation-duration: {{ 150 | divided_by: section.settings.speed | times: 0.75 }}s;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="premium-marquee-wrapper-{{ section.id }}">
    <div class="premium-marquee-container-{{ section.id }}" role="region" aria-label="Announcements">
      <div class="premium-marquee-track-{{ section.id }}">
        
        {%- comment -%} Determine repeat times based on block size to ensure clean endless scrolling {%- endcomment -%}
        {% assign block_size = section.blocks | size %}
        {% if block_size < 3 %}
          {% assign repeat_count = 6 %}
        {% elsif block_size < 5 %}
          {% assign repeat_count = 4 %}
        {% else %}
          {% assign repeat_count = 2 %}
        {% endif %}

        {%- for i in (1..repeat_count) -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.title != blank -%}
              <div class="premium-marquee-item-{{ section.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <span class="premium-marquee-item-{{ section.id }}--icon">{{ block.settings.icon }}</span>
                {%- endif -%}
                
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">
                {%- endif -%}
                  {{ block.settings.title }}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
                
                {%- if section.settings.show_separators -%}
                  <span class="premium-marquee-separator-{{ section.id }}">
                    {%- if section.settings.separator_style == 'dot' -%}
                      •
                    {%- elsif section.settings.separator_style == 'heart' -%}
                      ♥
                    {%- elsif section.settings.separator_style == 'star' -%}
                      ✦
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}

      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Beauty Marquee",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F8F4F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D1B1B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D4A0A0"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Speed",
      "min": 1,
      "max": 5,
      "default": 3,
      "step": 0.5,
      "info": "Lower = faster scroll"
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Item Spacing",
      "min": 1,
      "max": 5,
      "default": 2.5,
      "step": 0.5
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text Size",
      "options": [
        { "value": "1.0", "label": "Extra small" },
        { "value": "1.5", "label": "Small" },
        { "value": "1.75", "label": "Medium" },
        { "value": "2.0", "label": "Large" },
        { "value": "2.5", "label": "Extra large" }
      ],
      "default": "1.5"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "checkbox",
      "id": "italic_text",
      "label": "Italic Text",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "uppercase_text",
      "label": "Uppercase Text",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "bold_text",
      "label": "Bold Text (overrides font weight)",
      "default": false
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "hover_pause",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "✨",
          "info": "Use emojis: 🌸 💖 ✨ 🚚 💪 🌿 ⭐"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Text",
          "default": "Free Shipping on $50+"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beauty Marquee",
      "blocks": [
        { "type": "text", "settings": { "icon": "✨", "title": "Free Shipping on $50+" } },
        { "type": "text", "settings": { "icon": "🌸", "title": "Cruelty-Free & Clean" } },
        { "type": "text", "settings": { "icon": "💖", "title": "30-Day Love Guarantee" } },
        { "type": "text", "settings": { "icon": "🚚", "title": "Fast US Shipping" } },
        { "type": "text", "settings": { "icon": "⭐", "title": "4.9/5 from 2,000+ Customers" } }
      ]
    }
  ]
}
{% endschema %}