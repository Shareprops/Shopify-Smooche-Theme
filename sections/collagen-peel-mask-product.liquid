<!-- ══════════════════════════════════════════════
     JAVASCRIPT — Gallery, Bundle Selector, FAQ
══════════════════════════════════════════════ -->
<script>
(function() {
  'use strict';

  window.cpmThumbClick = function(el) {
    var mainImg = document.getElementById('cpm-main-img');
    if (mainImg && el.dataset.src) {
      mainImg.src = el.dataset.src;
      var thumbs = el.closest('.cpm-thumbnails').querySelectorAll('.cpm-thumb');
      thumbs.forEach(function(t) { t.classList.remove('active'); });
      el.classList.add('active');
      var slideCount = document.getElementById('cpm-slide-count');
      if (slideCount && el.dataset.index) {
        slideCount.textContent = el.dataset.index + ' / ' + thumbs.length;
      }
    }
  };

  document.addEventListener('DOMContentLoaded', function() {
    var sectionId = '{{ section.id }}';
    var bundleInputs = document.querySelectorAll('[name="cpm_bundle_qty"]');
    var qtyInput = document.getElementById('cpm-quantity-' + sectionId);
    var currentPrice = document.getElementById('cpm-price-current-' + sectionId);
    var comparePrice = document.getElementById('cpm-price-compare-' + sectionId);
    var saveBadge = document.getElementById('cpm-save-badge-' + sectionId);

    var basePrice = {{ base_price }};
    var discounts = { '1': 0, '2': 0.20, '3': 0.35 };
    var saveLabels = { '1': '', '2': 'You Save 20%', '3': 'You Save 35%' };

    function formatMoney(cents) {
      return '{{ cart.currency.symbol }}' + (cents / 100).toFixed(2);
    }

    bundleInputs.forEach(function(input) {
      input.addEventListener('change', function() {
        var qty = parseInt(this.value, 10);
        var discount = discounts[String(qty)] || 0;
        var originalTotal = basePrice * qty;
        var discountedTotal = Math.round(originalTotal * (1 - discount));

        if (qtyInput) qtyInput.value = qty;
        if (currentPrice) currentPrice.textContent = formatMoney(discountedTotal);

        if (comparePrice) {
          if (discount > 0) {
            comparePrice.textContent = formatMoney(originalTotal);
            comparePrice.style.display = '';
          } else {
            comparePrice.style.display = 'none';
          }
        }

        if (saveBadge) {
          var label = saveLabels[String(qty)] || '';
          if (label) {
            saveBadge.textContent = label;
            saveBadge.style.display = '';
          } else {
            saveBadge.style.display = 'none';
          }
        }
      });
    });

    if ('IntersectionObserver' in window) {
      var animEls = document.querySelectorAll('.cpm-benefit-card, .cpm-ritual-step, .cpm-ingredient-card, .cpm-timeline-stop, .cpm-testimonial-card, .cpm-faq-item');
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

      animEls.forEach(function(el) {
        el.style.opacity = '0';
        el.style.transform = 'translateY(24px)';
        el.style.transition = 'opacity 0.55s ease, transform 0.55s ease';
        observer.observe(el);
      });
    }
  });

  window.cpmFaqToggle = function(btn) {
    var item = btn.closest('.cpm-faq-item');
    var isOpen = item.classList.contains('open');
    document.querySelectorAll('.cpm-faq-item.open').forEach(function(openItem) {
      openItem.classList.remove('open');
      openItem.querySelector('.cpm-faq-question').setAttribute('aria-expanded', 'false');
    });
    if (!isOpen) {
      item.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }
  };

})();
</script>


