{{ 'section-collagen-peel-mask-product.css' | asset_url | stylesheet_tag }}
{{ 'product-form.js' | asset_url | script_tag }}

{%- liquid
  assign product_form_id = 'cpm-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign base_price = current_variant.price
  assign base_compare = current_variant.compare_at_price
-%}

<div class="cpm-page" id="CpmPage-{{ section.id }}">

  <!-- ══════════════════════════════════════════════
       1 · ANNOUNCEMENT BAR
  ══════════════════════════════════════════════ -->
  {%- if section.settings.show_announcement -%}
  <div class="cpm-announcement-bar" role="banner" aria-label="Promotional announcement">
    <p>{{ section.settings.announcement_text }}</p>
  </div>
  {%- endif -%}

  <!-- ══════════════════════════════════════════════
       2 · HERO: GALLERY + BUY BOX
  ══════════════════════════════════════════════ -->
  <section class="cpm-hero" aria-label="Product information">
    <div class="cpm-container">
      <div class="cpm-hero-grid">

        <!-- LEFT · MEDIA GALLERY -->
        <div class="cpm-gallery" id="CpmGallery">
          <div class="cpm-gallery-main" id="CpmMainImage">
            <span class="cpm-gallery-badge">✦ Dermatologist Tested</span>

            {%- if product.featured_image -%}
              <img
                id="cpm-main-img"
                src="{{ product.featured_image | image_url: width: 900 }}"
                alt="{{ product.featured_image.alt | escape | default: product.title }}"
                loading="eager"
                width="900"
                height="900"
                fetchpriority="high"
              >
            {%- else -%}
              <div class="cpm-img-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>
                </svg>
                <span>Product Image</span>
              </div>
            {%- endif -%}

            {%- if product.images.size > 1 -%}
            <span class="cpm-gallery-slide-count" id="cpm-slide-count">1 / {{ product.images.size }}</span>
            {%- endif -%}
          </div>

          {%- if product.images.size > 1 -%}
          <div class="cpm-thumbnails" role="list" aria-label="Product image gallery">
            {%- for image in product.images limit: 6 -%}
              <div
                class="cpm-thumb{% if forloop.first %} active{% endif %}"
                role="listitem"
                data-src="{{ image | image_url: width: 900 }}"
                data-index="{{ forloop.index }}"
                tabindex="0"
                aria-label="View image {{ forloop.index }}"
                onclick="cpmThumbClick(this)"
                onkeydown="if(event.key==='Enter')cpmThumbClick(this)"
              >
                <img
                  src="{{ image | image_url: width: 150 }}"
                  alt="{{ image.alt | escape | default: product.title | append: ' - Image ' | append: forloop.index }}"
                  loading="lazy"
                  width="76"
                  height="76"
                >
              </div>
            {%- endfor -%}
          </div>
          {%- endif -%}
        </div>

        <!-- RIGHT · BUY BOX -->
        <div class="cpm-buybox" id="CpmBuybox">

          <div class="cpm-stars-row cpm-animate-in">
            <div class="cpm-stars" aria-label="4.9 out of 5 stars" role="img">
              {%- for i in (1..5) -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M10 1l2.5 5.5L18 7.5l-4 4 1 5.5L10 14.5l-5 2.5 1-5.5-4-4 5.5-1z"/>
              </svg>
              {%- endfor -%}
            </div>
            <a href="#cpm-reviews" class="cpm-review-link">{{ section.settings.review_count | default: '2,380+' }} verified reviews</a>
            <span class="cpm-social-chip">🔥 Selling fast this week</span>
          </div>

          <h1 class="cpm-product-title cpm-animate-in cpm-animate-delay-1">
            {{ product.title | default: 'Collagen Peel-Off Face Mask' }}
          </h1>

          <p class="cpm-value-prop cpm-animate-in cpm-animate-delay-1">
            {{ section.settings.value_prop | default: 'One smooth peel lifts away dirt, oil, and dullness while a <strong>marine collagen + peptide gel</strong> visibly tightens and plumps — no rinsing, no residue.' }}
          </p>

          <div class="cpm-chip-row cpm-animate-in cpm-animate-delay-2">
            {%- for block in section.blocks -%}
              {%- if block.type == 'feature_chip' -%}
                <span class="cpm-chip" {{ block.shopify_attributes }}>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10l4 4 8-8"/></svg>
                  {{ block.settings.text }}
                </span>
              {%- endif -%}
            {%- endfor -%}

            {%- assign chip_blocks = section.blocks | where: 'type', 'feature_chip' -%}
            {%- if chip_blocks.size == 0 -%}
              {%- assign default_chips = "Instant visible tightening,One-piece full peel,Deep pore detox,Zero sticky residue,15-minute ritual,Sensitive-skin safe" | split: "," -%}
              {%- for chip in default_chips -%}
                <span class="cpm-chip">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10l4 4 8-8"/></svg>
                  {{ chip }}
                </span>
              {%- endfor -%}
            {%- endif -%}
          </div>

          <div class="cpm-animate-in cpm-animate-delay-3">
            <p class="cpm-bundle-title">Choose Your Set</p>

            <product-form class="product-form" id="CpmProductForm-{{ section.id }}">
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <svg aria-hidden="true" focusable="false" class="icon icon-error" viewBox="0 0 13 13">
                  <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                  <path d="M5.87 3.53L5.97 7.57h1.05l.10-4.04H5.87zM6.50 9.66c.38 0 .68-.29.68-.66s-.30-.65-.68-.65-.68.28-.68.65.30.66.68.66z" fill="white"/>
                </svg>
                <span class="product-form__error-message"></span>
              </div>

              {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" class="product-variant-id" id="cpm-variant-id-{{ section.id }}">

                <div class="cpm-bundle-cards" role="radiogroup" aria-label="Select bundle quantity">

                  <!-- TIER 1: Single -->
                  <input type="radio" class="cpm-bundle-card-input" name="cpm_bundle_qty" id="cpm-bundle-1-{{ section.id }}" value="1" aria-label="Buy 1 mask">
                  <label class="cpm-bundle-card" for="cpm-bundle-1-{{ section.id }}" data-qty="1" data-price="{{ base_price }}">
                    <div class="cpm-bundle-card-body">
                      <div>
                        <div class="cpm-bundle-card-name">Try It — 1 Mask</div>
                        <div class="cpm-bundle-card-sub">A single 15-minute reveal session</div>
                      </div>
                      <div class="cpm-bundle-card-price">
                        <span class="cpm-price-val" id="cpm-bundle-price-1-{{ section.id }}">{{ base_price | money }}</span>
                        {%- if base_compare > base_price -%}
                        <span class="cpm-compare-val">{{ base_compare | money }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                  </label>

                  <!-- TIER 2: Duo, checked by default -->
                  <input type="radio" class="cpm-bundle-card-input" name="cpm_bundle_qty" id="cpm-bundle-2-{{ section.id }}" value="2" checked aria-label="Buy 2 masks, save 20 percent">
                  <label class="cpm-bundle-card" for="cpm-bundle-2-{{ section.id }}" data-qty="2" data-price="{{ base_price | times: 2 | times: 0.80 | round }}">
                    <span class="cpm-best-value-badge">Most Popular</span>
                    <div class="cpm-bundle-card-body">
                      <div>
                        <div class="cpm-bundle-card-name">Duo Set — 2 Masks <span style="color:var(--cpm-rose-dark);">(Save 20%)</span></div>
                        <div class="cpm-bundle-card-sub">A full month of weekly resets</div>
                      </div>
                      <div class="cpm-bundle-card-price">
                        <span class="cpm-price-val" id="cpm-bundle-price-2-{{ section.id }}">{{ base_price | times: 2 | times: 0.80 | round | money }}</span>
                        <span class="cpm-compare-val">{{ base_price | times: 2 | money }}</span>
                      </div>
                    </div>
                  </label>

                  <!-- TIER 3: Trio -->
                  <input type="radio" class="cpm-bundle-card-input" name="cpm_bundle_qty" id="cpm-bundle-3-{{ section.id }}" value="3" aria-label="Buy 3 masks, save 35 percent">
                  <label class="cpm-bundle-card" for="cpm-bundle-3-{{ section.id }}" data-qty="3" data-price="{{ base_price | times: 3 | times: 0.65 | round }}">
                    <div class="cpm-bundle-card-body">
                      <div>
                        <div class="cpm-bundle-card-name">Glow Trio — 3 Masks <span style="color:var(--cpm-rose-dark);">(Save 35%)</span></div>
                        <div class="cpm-bundle-card-sub">Best value • free tracked shipping</div>
                      </div>
                      <div class="cpm-bundle-card-price">
                        <span class="cpm-price-val" id="cpm-bundle-price-3-{{ section.id }}">{{ base_price | times: 3 | times: 0.65 | round | money }}</span>
                        <span class="cpm-compare-val">{{ base_price | times: 3 | money }}</span>
                      </div>
                    </div>
                  </label>

                </div>

                <input type="hidden" name="quantity" value="2" id="cpm-quantity-{{ section.id }}">

                <div class="cpm-urgency">
                  <div class="cpm-urgency-row">
                    <span>Only a few sets left in stock</span>
                    <span>12% remaining</span>
                  </div>
                  <div class="cpm-urgency-track">
                    <div class="cpm-urgency-fill" style="width:12%;"></div>
                  </div>
                </div>

                <div class="cpm-price-display" id="cpm-price-display-{{ section.id }}">
                  <span class="cpm-price-current" id="cpm-price-current-{{ section.id }}">{{ base_price | times: 2 | times: 0.80 | round | money }}</span>
                  <span class="cpm-price-compare" id="cpm-price-compare-{{ section.id }}">{{ base_price | times: 2 | money }}</span>
                  <span class="cpm-price-save-badge" id="cpm-save-badge-{{ section.id }}">You Save 20%</span>
                </div>

                <div class="product-form__buttons" style="margin-top:16px;">
                  <button
                    id="cpm-atc-{{ section.id }}"
                    type="submit"
                    name="add"
                    class="cpm-atc-btn"
                    aria-label="{{ section.settings.atc_label | default: 'Add to Cart' }}"
                  >
                    <span class="atc-btn-text">{{ section.settings.atc_label | default: 'Add to Cart' }}</span>
                    <div class="loading-overlay__spinner hidden" aria-hidden="true">
                      <svg viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
                        <circle class="path" fill="none" stroke="white" stroke-width="6" cx="33" cy="33" r="30"></circle>
                      </svg>
                    </div>
                  </button>
                </div>
              {%- endform -%}
            </product-form>
          </div>

          <div class="cpm-trust-badges" role="list" aria-label="Trust and safety badges">
            <div class="cpm-trust-item" role="listitem">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>30-Day Money-Back Guarantee</span>
            </div>
            <div class="cpm-trust-divider" aria-hidden="true"></div>
            <div class="cpm-trust-item" role="listitem">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              <span>Dermatologist Tested</span>
            </div>
            <div class="cpm-trust-divider" aria-hidden="true"></div>
            <div class="cpm-trust-item" role="listitem">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>Secure Checkout</span>
            </div>
          </div>

        </div><!-- /cpm-buybox -->

      </div><!-- /cpm-hero-grid -->
    </div><!-- /cpm-container -->
  </section>

  <!-- ══════════════════════════════════════════════
       3 · SOCIAL PROOF TICKER
  ══════════════════════════════════════════════ -->
  <div class="cpm-ticker-bar" role="marquee" aria-label="Social proof ticker" aria-live="off">
    <div class="cpm-ticker-track">
      {%- for i in (1..4) -%}
        <span class="cpm-ticker-item" aria-hidden="true">Tightens in One Peel</span>
        <span class="cpm-ticker-sep" aria-hidden="true">✦</span>
        <span class="cpm-ticker-item" aria-hidden="true">Dermatologist Tested</span>
        <span class="cpm-ticker-sep" aria-hidden="true">✦</span>
        <span class="cpm-ticker-item" aria-hidden="true">30,000+ Happy Faces</span>
        <span class="cpm-ticker-sep" aria-hidden="true">✦</span>
        <span class="cpm-ticker-item" aria-hidden="true">Marine Collagen + Peptides</span>
        <span class="cpm-ticker-sep" aria-hidden="true">✦</span>
        <span class="cpm-ticker-item" aria-hidden="true">30-Day Money-Back Guarantee</span>
        <span class="cpm-ticker-sep" aria-hidden="true">✦</span>
      {%- endfor -%}
    </div>
  </div>

  <!-- ══════════════════════════════════════════════
       4 · WHY IT WORKS — BENEFIT GRID
  ══════════════════════════════════════════════ -->
  <section class="cpm-benefits" aria-labelledby="cpm-benefits-title">
    <div class="cpm-container">
      <div class="cpm-section-header">
        <span class="cpm-section-tag">Why It Works</span>
        <h2 class="cpm-section-title" id="cpm-benefits-title">One Peel. Visibly Tighter Skin.</h2>
        <p class="cpm-section-subtitle">A liquid gel that hardens into a single, lift-off sheet — pulling impurities out while sealing in collagen and peptides.</p>
      </div>

      <div class="cpm-benefit-grid">
        <div class="cpm-benefit-card">
          <div class="cpm-benefit-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/></svg></div>
          <h3 class="cpm-benefit-title">Instant Visible Tightening</h3>
          <p class="cpm-benefit-desc">As the gel dries, it contracts across the skin — the same tension you feel is what leaves your face looking firmer and more sculpted the moment it's off.</p>
        </div>
        <div class="cpm-benefit-card">
          <div class="cpm-benefit-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
          <h3 class="cpm-benefit-title">15 Minutes, Zero Mess</h3>
          <p class="cpm-benefit-desc">Paint it on, let it set, peel it off in one piece — no rinsing, no sheet-mask drip, no sticky leftover film on your skin.</p>
        </div>
        <div class="cpm-benefit-card">
          <div class="cpm-benefit-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3 9 4-18 3 9h4"/></svg></div>
          <h3 class="cpm-benefit-title">Detox While You Firm</h3>
          <p class="cpm-benefit-desc">The peel physically lifts trapped oil, dead skin, and blackhead debris out of pores while collagen peptides work to plump and smooth.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       5 · HOW TO USE — 3-STEP RITUAL
  ══════════════════════════════════════════════ -->
  <section class="cpm-ritual" aria-labelledby="cpm-ritual-title">
    <div class="cpm-container">
      <div class="cpm-section-header">
        <span class="cpm-section-tag">The Ritual</span>
        <h2 class="cpm-section-title" id="cpm-ritual-title">Apply. Relax. Peel.</h2>
        <p class="cpm-section-subtitle">Three simple steps stand between you and glass-smooth, visibly tighter skin.</p>
      </div>

      <div class="cpm-ritual-grid">
        <div class="cpm-ritual-step">
          <div class="cpm-ritual-number">1</div>
          <h3 class="cpm-ritual-name">Apply</h3>
          <p class="cpm-ritual-desc">Smooth an even layer over clean, dry skin — avoiding eyebrows, hairline, and lips. Let it breathe, don't rub it in.</p>
          <span class="cpm-ritual-time">2 minutes</span>
        </div>
        <div class="cpm-ritual-step">
          <div class="cpm-ritual-number">2</div>
          <h3 class="cpm-ritual-name">Relax</h3>
          <p class="cpm-ritual-desc">Sit back while the gel dries into a single, flexible film. You'll feel it tighten gently as the collagen sets in.</p>
          <span class="cpm-ritual-time">15–20 minutes</span>
        </div>
        <div class="cpm-ritual-step">
          <div class="cpm-ritual-number">3</div>
          <h3 class="cpm-ritual-name">Peel</h3>
          <p class="cpm-ritual-desc">Starting at the edges, peel upward in one smooth sheet. Rinse away any residue and follow with your favorite moisturizer.</p>
          <span class="cpm-ritual-time">1 minute</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       6 · INGREDIENT SPOTLIGHT
  ══════════════════════════════════════════════ -->
  <section class="cpm-ingredients" aria-labelledby="cpm-ingredients-title">
    <div class="cpm-container">
      <div class="cpm-section-header">
        <span class="cpm-section-tag">What's Inside</span>
        <h2 class="cpm-section-title" id="cpm-ingredients-title">Formulated With Purpose</h2>
        <p class="cpm-section-subtitle">Every batch is built around six actives chosen for firming, hydration, and calm — nothing filler, nothing harsh.</p>
      </div>

      <div class="cpm-ingredient-grid" id="cpm-ingredients-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'ingredient' -%}
          <div class="cpm-ingredient-card" {{ block.shopify_attributes }}>
            <span class="cpm-ingredient-tag">{{ block.settings.tag }}</span>
            <h3 class="cpm-ingredient-name">{{ block.settings.name }}</h3>
            <p class="cpm-ingredient-desc">{{ block.settings.description }}</p>
          </div>
          {%- endif -%}
        {%- endfor -%}

        {%- assign ingredient_blocks = section.blocks | where: 'type', 'ingredient' -%}
        {%- if ingredient_blocks.size == 0 -%}
          <div class="cpm-ingredient-card">
            <span class="cpm-ingredient-tag">Firming</span>
            <h3 class="cpm-ingredient-name">Hydrolyzed Marine Collagen</h3>
            <p class="cpm-ingredient-desc">Small-molecule collagen peptides that sit on the skin's surface to visibly plump and smooth fine dehydration lines.</p>
          </div>
          <div class="cpm-ingredient-card">
            <span class="cpm-ingredient-tag">Elasticity</span>
            <h3 class="cpm-ingredient-name">Tri-Peptide Complex</h3>
            <p class="cpm-ingredient-desc">A blend of signal peptides that supports the skin's own collagen production for a firmer look over time.</p>
          </div>
          <div class="cpm-ingredient-card">
            <span class="cpm-ingredient-tag">Brightening</span>
            <h3 class="cpm-ingredient-name">Niacinamide</h3>
            <p class="cpm-ingredient-desc">Refines the look of pores and evens tone, leaving skin brighter and less congested after every peel.</p>
          </div>
          <div class="cpm-ingredient-card">
            <span class="cpm-ingredient-tag">Calming</span>
            <h3 class="cpm-ingredient-name">Centella Asiatica</h3>
            <p class="cpm-ingredient-desc">A soothing botanical extract that keeps the peel gentle on sensitive, reactive, and post-breakout skin.</p>
          </div>
          <div class="cpm-ingredient-card">
            <span class="cpm-ingredient-tag">Antioxidant</span>
            <h3 class="cpm-ingredient-name">Vitamin E</h3>
            <p class="cpm-ingredient-desc">Protects freshly-detoxed skin from environmental stress while locking in moisture after the peel comes off.</p>
          </div>
          <div class="cpm-ingredient-card">
            <span class="cpm-ingredient-tag">Hydration</span>
            <h3 class="cpm-ingredient-name">Rose Flower Extract</h3>
            <p class="cpm-ingredient-desc">Delivers a light floral hydration boost and a spa-grade scent without a trace of alcohol or synthetic fragrance.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       7 · RESULTS TIMELINE
  ══════════════════════════════════════════════ -->
  <section class="cpm-timeline" aria-labelledby="cpm-timeline-title">
    <div class="cpm-container">
      <div class="cpm-section-header">
        <span class="cpm-section-tag">What To Expect</span>
        <h2 class="cpm-section-title" id="cpm-timeline-title">Your First-Peel to Four-Week Glow</h2>
        <p class="cpm-section-subtitle">Results build with consistency — here's what most users notice, and when.</p>
      </div>

      <div class="cpm-timeline-track">
        <div class="cpm-timeline-stop">
          <div class="cpm-timeline-dot"></div>
          <p class="cpm-timeline-label">First Peel</p>
          <p class="cpm-timeline-headline">Instantly smoother, tighter-feeling skin</p>
          <p class="cpm-timeline-sub">Pores look visibly refined within minutes of peeling off</p>
        </div>
        <div class="cpm-timeline-stop">
          <div class="cpm-timeline-dot"></div>
          <p class="cpm-timeline-label">Week 1</p>
          <p class="cpm-timeline-headline">Texture evens out</p>
          <p class="cpm-timeline-sub">Rough patches and dullness begin to fade with 2–3 uses</p>
        </div>
        <div class="cpm-timeline-stop">
          <div class="cpm-timeline-dot"></div>
          <p class="cpm-timeline-label">Week 2</p>
          <p class="cpm-timeline-headline">Firmer contours</p>
          <p class="cpm-timeline-sub">Skin starts to hold its lifted look between sessions</p>
        </div>
        <div class="cpm-timeline-stop">
          <div class="cpm-timeline-dot"></div>
          <p class="cpm-timeline-label">Week 4+</p>
