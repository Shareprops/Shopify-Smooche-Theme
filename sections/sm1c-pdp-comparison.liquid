{%- style -%}
#shopify-section-{{ section.id }} .sm1c-cmp-wrap {
  padding: 60px 44px;
  background: oklch(97% 0.015 30);
  font-family: 'Work Sans', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-cmp-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 30px;
  font-weight: 400;
  text-align: center;
  margin-bottom: 8px;
}
#shopify-section-{{ section.id }} .sm1c-cmp-title span {
  color: #E8637E;
}
#shopify-section-{{ section.id }} .sm1c-cmp-sub {
  font-size: 13px;
  color: rgba(58, 46, 39, .8);
  text-align: center;
  max-width: 600px;
  margin: 0 auto 36px;
  line-height: 1.6;
}
#shopify-section-{{ section.id }} .sm1c-cmp-table {
  max-width: 900px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .sm1c-cmp-head {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  align-items: end;
}
#shopify-section-{{ section.id }} .sm1c-cmp-head-brand {
  background: #E8637E;
  border-radius: 16px 16px 0 0;
  text-align: center;
  padding: 22px 10px 16px;
}
#shopify-section-{{ section.id }} .sm1c-cmp-head-brand-name {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 20px;
  font-weight: 600;
  color: #fff;
}
#shopify-section-{{ section.id }} .sm1c-cmp-head-brand-price {
  font-size: 12px;
  font-weight: 700;
  color: rgba(255, 255, 255, .85);
  margin-top: 6px;
}
#shopify-section-{{ section.id }} .sm1c-cmp-head-col {
  text-align: center;
  padding: 10px;
}
#shopify-section-{{ section.id }} .sm1c-cmp-head-col-name {
  font-size: 13px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-cmp-head-col-price {
  font-size: 12px;
  color: rgba(58, 46, 39, .8);
  margin-top: 6px;
}
#shopify-section-{{ section.id }} .sm1c-cmp-rows {
  display: flex;
  flex-direction: column;
}
#shopify-section-{{ section.id }} .sm1c-cmp-row {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  align-items: center;
}
#shopify-section-{{ section.id }} .sm1c-cmp-row:nth-child(odd) {
  background: oklch(94% 0.02 30);
}
#shopify-section-{{ section.id }} .sm1c-cmp-row:nth-child(even) {
  background: #fff;
}
#shopify-section-{{ section.id }} .sm1c-cmp-feature {
  padding: 18px 20px;
  font-size: 14px;
  font-weight: 600;
}
#shopify-section-{{ section.id }} .sm1c-cmp-cell {
  text-align: center;
}
#shopify-section-{{ section.id }} .sm1c-cmp-cell-smooche {
  padding: 12px;
  background: #F0899D;
}
#shopify-section-{{ section.id }} .sm1c-cmp-row:last-child .sm1c-cmp-cell-smooche {
  padding: 12px 12px 20px;
  border-radius: 0 0 16px 16px;
}
#shopify-section-{{ section.id }} .sm1c-cmp-mark {
  display: inline-flex;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 800;
}
#shopify-section-{{ section.id }} .sm1c-cmp-mark-yes {
  background: #fff;
  color: #E8637E;
}
#shopify-section-{{ section.id }} .sm1c-cmp-mark-no {
  background: #E8637E;
  color: #fff;
  font-size: 12px;
}
@media (max-width: 700px) {
  #shopify-section-{{ section.id }} .sm1c-cmp-table {
    margin-top: 8px;
  }
  #shopify-section-{{ section.id }} .sm1c-cmp-feature {
    font-size: 12px;
    padding: 14px 10px;
  }
  #shopify-section-{{ section.id }} .sm1c-cmp-head,
  #shopify-section-{{ section.id }} .sm1c-cmp-row {
    grid-template-columns: 2fr 1fr 1fr;
  }
  #shopify-section-{{ section.id }} .sm1c-cmp-head > :last-child,
  #shopify-section-{{ section.id }} .sm1c-cmp-row > :last-child {
    display: none;
  }
  #shopify-section-{{ section.id }} .sm1c-cmp-head-brand {
    padding: 26px 8px 18px;
  }
  #shopify-section-{{ section.id }} .sm1c-cmp-head-col {
    padding: 26px 8px 18px;
  }
}
{%- endstyle -%}

<div class="sm1c-cmp-wrap">
  {%- liquid
    assign cmp_heading_mf = product.metafields.custom.comparison_heading.value
    assign cmp_c1_name = product.metafields.custom.competitor_1_name.value | default: section.settings.competitor_1_name
    assign cmp_c1_price = product.metafields.custom.competitor_1_price.value | default: section.settings.competitor_1_price
    assign cmp_c2_name = product.metafields.custom.competitor_2_name.value | default: section.settings.competitor_2_name
    assign cmp_c2_price = product.metafields.custom.competitor_2_price.value | default: section.settings.competitor_2_price
  -%}
  {%- if cmp_heading_mf != blank -%}
    {%- assign cmp_parts = cmp_heading_mf | split: ' vs ' -%}
    <div class="sm1c-cmp-title">
      {{- cmp_parts[0] -}}
      {%- if cmp_parts.size > 1 %} <span>vs {{ cmp_parts[1] }}</span>{% endif -%}
    </div>
  {%- else -%}
    <div class="sm1c-cmp-title">{{ section.settings.heading }} <span>{{ section.settings.heading_accent }}</span></div>
  {%- endif -%}
  <div class="sm1c-cmp-sub">{{ section.settings.subheading }}</div>
  <div class="sm1c-cmp-table">
    <div class="sm1c-cmp-head">
      <div></div>
      <div class="sm1c-cmp-head-brand">
        <div class="sm1c-cmp-head-brand-name">{{ section.settings.brand_name }}</div>
        <div class="sm1c-cmp-head-brand-price">{{ product.selected_or_first_available_variant.price | money }}</div>
      </div>
      <div class="sm1c-cmp-head-col">
        <div class="sm1c-cmp-head-col-name">{{ cmp_c1_name }}</div>
        <div class="sm1c-cmp-head-col-price">{{ cmp_c1_price }}</div>
      </div>
      <div class="sm1c-cmp-head-col">
        <div class="sm1c-cmp-head-col-name">{{ cmp_c2_name }}</div>
        <div class="sm1c-cmp-head-col-price">{{ cmp_c2_price }}</div>
      </div>
    </div>
    <div class="sm1c-cmp-rows">
      {%- if product.metafields.custom.comparison_rows.value.size > 0 -%}
        {%- for row in product.metafields.custom.comparison_rows.value -%}
          <div class="sm1c-cmp-row">
            <div class="sm1c-cmp-feature">{{ row.feature.value }}</div>
            <div class="sm1c-cmp-cell sm1c-cmp-cell-smooche">
              <span class="sm1c-cmp-mark {% if row.brand_has.value %}sm1c-cmp-mark-yes{% else %}sm1c-cmp-mark-no{% endif %}">{% if row.brand_has.value %}✓{% else %}✕{% endif %}</span>
            </div>
            <div class="sm1c-cmp-cell">
              <span class="sm1c-cmp-mark {% if row.competitor_1_has.value %}sm1c-cmp-mark-yes{% else %}sm1c-cmp-mark-no{% endif %}">{% if row.competitor_1_has.value %}✓{% else %}✕{% endif %}</span>
            </div>
            <div class="sm1c-cmp-cell">
              <span class="sm1c-cmp-mark {% if row.competitor_2_has.value %}sm1c-cmp-mark-yes{% else %}sm1c-cmp-mark-no{% endif %}">{% if row.competitor_2_has.value %}✓{% else %}✕{% endif %}</span>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <div class="sm1c-cmp-row" {{ block.shopify_attributes }}>
            <div class="sm1c-cmp-feature">{{ block.settings.feature }}</div>
            <div class="sm1c-cmp-cell sm1c-cmp-cell-smooche">
              <span class="sm1c-cmp-mark sm1c-cmp-mark-yes">✓</span>
            </div>
            <div class="sm1c-cmp-cell">
              <span class="sm1c-cmp-mark {% if block.settings.competitor_1 %}sm1c-cmp-mark-yes{% else %}sm1c-cmp-mark-no{% endif %}">{% if block.settings.competitor_1 %}✓{% else %}✕{% endif %}</span>
            </div>
            <div class="sm1c-cmp-cell">
              <span class="sm1c-cmp-mark {% if block.settings.competitor_2 %}sm1c-cmp-mark-yes{% else %}sm1c-cmp-mark-no{% endif %}">{% if block.settings.competitor_2 %}✓{% else %}✕{% endif %}</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SM1C Comparison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lip Plumper" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "vs The Usual Options" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Most serums try to force volume. Serein removes what blocks it — no stinging, no stimulants, just consistent results." },
    { "type": "text", "id": "brand_name", "label": "Brand column name", "default": "Serein" },
    { "type": "text", "id": "competitor_1_name", "label": "Competitor 1 name", "default": "Other Serums" },
    { "type": "text", "id": "competitor_1_price", "label": "Competitor 1 price note", "default": "From $3.67/unit" },
    { "type": "text", "id": "competitor_2_name", "label": "Competitor 2 name", "default": "Generic Balms" },
    { "type": "text", "id": "competitor_2_price", "label": "Competitor 2 price note", "default": "From $2.84/unit" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature label", "default": "Long-lasting volume" },
        { "type": "checkbox", "id": "competitor_1", "label": "Competitor 1 has this", "default": false },
        { "type": "checkbox", "id": "competitor_2", "label": "Competitor 2 has this", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "SM1C Comparison",
      "blocks": [
        { "type": "row", "settings": { "feature": "Long-lasting volume" } },
        { "type": "row", "settings": { "feature": "No harsh chemicals" } },
        { "type": "row", "settings": { "feature": "Hydrates while plumping" } },
        { "type": "row", "settings": { "feature": "Dermatologist-tested" } },
        { "type": "row", "settings": { "feature": "Works without stimulants" } }
      ]
    }
  ]
}
{% endschema %}
