{%- style -%}
#shopify-section-{{ section.id }} .sm1c-fav-wrap {
  padding: 44px;
  font-family: 'Work Sans', sans-serif;
  background: var(--sm1c-bg, #fff);
  color: var(--sm1c-text, #111);
  min-height: 40vh;
}
#shopify-section-{{ section.id }} .sm1c-fav-heading {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 30px;
  font-weight: 800;
  margin-bottom: 24px;
}
#shopify-section-{{ section.id }} .sm1c-fav-empty {
  font-size: 14px;
  color: oklch(55% 0.02 30);
}
#shopify-section-{{ section.id }} .sm1c-fav-empty a {
  color: inherit;
  font-weight: 700;
  text-decoration: underline;
}
#shopify-section-{{ section.id }} .sm1c-fav-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px 20px;
}
#shopify-section-{{ section.id }} .sm1c-fav-card {
  display: flex;
  flex-direction: column;
}
#shopify-section-{{ section.id }} .sm1c-fav-imgwrap {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: oklch(94% 0.03 30);
}
#shopify-section-{{ section.id }} .sm1c-fav-img {
  height: 230px;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-fav-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-fav-name {
  margin-top: 14px;
  font-size: 14px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-fav-price {
  font-size: 14px;
  font-weight: 700;
  margin-top: 4px;
}
#shopify-section-{{ section.id }} .sm1c-fav-remove {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,.9);
  color: #c24a2e;
  font-size: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-family: inherit;
}
#shopify-section-{{ section.id }} .sm1c-fav-remove.sm1c-pop {
  animation: sm1c-fav-pop .4s ease;
}
@keyframes sm1c-fav-pop {
  0% { transform: scale(1); }
  35% { transform: scale(1.4); }
  60% { transform: scale(.9); }
  100% { transform: scale(1); }
}
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .sm1c-fav-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
{%- endstyle -%}

<div class="sm1c-fav-wrap" data-sm1c-favorites-page>
  <div class="sm1c-fav-heading">{{ section.settings.heading }}</div>
  <div class="sm1c-fav-empty" data-sm1c-favorites-empty hidden>
    You haven't added anything to favorites yet. <a href="/collections/all">Browse products →</a>
  </div>
  <div class="sm1c-fav-grid" data-sm1c-favorites-grid></div>
</div>

{{ 'sm1c-favorites-page.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "SM1C Favorites",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Favorites" }
  ],
  "presets": [
    { "name": "SM1C Favorites" }
  ]
}
{% endschema %}
