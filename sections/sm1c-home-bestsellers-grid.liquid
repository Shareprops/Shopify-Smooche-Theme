{%- style -%}
#shopify-section-{{ section.id }} .sm1c-bg-wrap {
  padding: 60px 44px;
  background: {{ section.settings.bg_color }};
  font-family: 'Work Sans', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-bg-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 26px;
  flex-wrap: wrap;
  gap: 12px;
}
#shopify-section-{{ section.id }} .sm1c-bg-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 30px;
  font-weight: 800;
}
#shopify-section-{{ section.id }} .sm1c-bg-viewall {
  font-size: 12px;
  font-weight: 700;
  background: {{ section.settings.pill_bg }};
  padding: 8px 16px;
  border-radius: 100px;
  text-decoration: none;
  color: inherit;
}
#shopify-section-{{ section.id }} .sm1c-bg-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
#shopify-section-{{ section.id }} .sm1c-bg-card a {
  color: inherit;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-bg-imgwrap {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-bg-img {
  height: 250px;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-bg-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-bg-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: {{ section.settings.accent_color }};
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 100px;
}
#shopify-section-{{ section.id }} .sm1c-bg-heart {
  position: absolute;
  top: 12px;
  right: 12px;
  background: rgba(255,255,255,.9);
  border-radius: 100px;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}
#shopify-section-{{ section.id }} .sm1c-bg-name {
  margin-top: 12px;
  font-size: 14px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-bg-rating {
  font-size: 13px;
  color: rgba(0,0,0,.5);
  margin: 4px 0;
}
#shopify-section-{{ section.id }} .sm1c-bg-price {
  font-size: 15px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-bg-compare {
  text-decoration: line-through;
  color: rgba(0,0,0,.4);
  font-weight: 500;
  font-size: 13px;
  margin-left: 4px;
}
@media (max-width: 989px) {
  #shopify-section-{{ section.id }} .sm1c-bg-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
{%- endstyle -%}

<div class="sm1c-bg-wrap">
  <div class="sm1c-bg-head">
    <div class="sm1c-bg-title">{{ section.settings.heading }}</div>
    {%- if section.settings.view_all_link != blank -%}
      <a href="{{ section.settings.view_all_link }}" class="sm1c-bg-viewall">Shop All →</a>
    {%- else -%}
      <span class="sm1c-bg-viewall">Shop All →</span>
    {%- endif -%}
  </div>
  <div class="sm1c-bg-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign item_title = block.settings.title
        assign item_price = block.settings.price
        assign item_image = block.settings.image
        assign item_url = block.settings.link
        if block.settings.product != blank
          assign item_title = block.settings.product.title
          assign item_price = block.settings.product.price | money
          assign item_image = block.settings.product.featured_image
          assign item_url = block.settings.product.url
        endif
      -%}
      <div class="sm1c-bg-card" {{ block.shopify_attributes }}>
        <a href="{{ item_url | default: '#' }}">
          <div class="sm1c-bg-imgwrap">
            <div class="sm1c-bg-img">
              {%- if item_image != blank -%}
                {{ item_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: item_title }}
              {%- endif -%}
            </div>
            {%- if block.settings.badge_text != blank -%}
              <div class="sm1c-bg-badge">{{ block.settings.badge_text }}</div>
            {%- endif -%}
            {%- if block.settings.show_wishlist -%}
              <div class="sm1c-bg-heart">♡</div>
            {%- endif -%}
          </div>
          <div class="sm1c-bg-name">{{ item_title }}</div>
          {%- if block.settings.rating_text != blank -%}
            <div class="sm1c-bg-rating">{{ block.settings.rating_text }}</div>
          {%- endif -%}
          <div class="sm1c-bg-price">
            {{ item_price }}
            {%- if block.settings.compare_at_price != blank -%}
              <span class="sm1c-bg-compare">{{ block.settings.compare_at_price }}</span>
            {%- endif -%}
          </div>
        </a>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SM1C Home Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "View-all pill background",
      "default": "#f6e6dd"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Badge accent color",
      "default": "#c24a2e"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (optional, overrides fields below)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "VIRAL"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Peel-off Lip Stain"
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating text",
          "default": "★★★★★ 1,204"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$29.00"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare-at price (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_wishlist",
          "label": "Show wishlist icon",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "SM1C Home Bestsellers",
      "blocks": [
        { "type": "item", "settings": { "badge_text": "VIRAL", "title": "Peel-off Lip Stain", "rating_text": "★★★★★ 1,204", "price": "$29.00" } },
        { "type": "item", "settings": { "badge_text": "BESTSELLER", "title": "Color Changing Foundation", "rating_text": "★★★★★ 834", "price": "$39.00", "compare_at_price": "$58.00" } },
        { "type": "item", "settings": { "badge_text": "1+1 FREE", "title": "Extreme Lip Plumper", "rating_text": "★★★★★ 2,910", "price": "$39.00", "compare_at_price": "$48.00" } },
        { "type": "item", "settings": { "badge_text": "SALE", "title": "Eyebrow Growth Serum", "rating_text": "★★★★★ 561", "price": "$39.00", "compare_at_price": "$58.00" } }
      ]
    }
  ]
}
{% endschema %}
