{%- style -%}
#shopify-section-{{ section.id }} .sm1c-bun-wrap {
  padding: 0 44px 60px;
  background: {{ section.settings.bg_color }};
  font-family: 'Work Sans', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-bun-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 26px;
  flex-wrap: wrap;
  gap: 12px;
}
#shopify-section-{{ section.id }} .sm1c-bun-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 30px;
  font-weight: 800;
}
#shopify-section-{{ section.id }} .sm1c-bun-viewall {
  font-size: 12px;
  font-weight: 700;
  background: {{ section.settings.pill_bg }};
  padding: 8px 16px;
  border-radius: 100px;
  text-decoration: none;
  color: inherit;
}
#shopify-section-{{ section.id }} .sm1c-bun-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
#shopify-section-{{ section.id }} .sm1c-bun-card a {
  color: inherit;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-bun-imgwrap {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-bun-img {
  height: 210px;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-bun-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-bun-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #111;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 100px;
}
#shopify-section-{{ section.id }} .sm1c-bun-name {
  margin-top: 12px;
  font-size: 14px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-bun-price {
  font-size: 15px;
  font-weight: 700;
  margin-top: 4px;
}
#shopify-section-{{ section.id }} .sm1c-bun-compare {
  text-decoration: line-through;
  color: rgba(0,0,0,.4);
  font-weight: 500;
  font-size: 13px;
  margin-left: 4px;
}
@media (max-width: 989px) {
  #shopify-section-{{ section.id }} .sm1c-bun-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
{%- endstyle -%}

<div class="sm1c-bun-wrap">
  <div class="sm1c-bun-head">
    <div class="sm1c-bun-title">{{ section.settings.heading }}</div>
    {%- if section.settings.view_all_link != blank -%}
      <a href="{{ section.settings.view_all_link }}" class="sm1c-bun-viewall">Shop All →</a>
    {%- else -%}
      <span class="sm1c-bun-viewall">Shop All →</span>
    {%- endif -%}
  </div>
  <div class="sm1c-bun-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign item_title = block.settings.title
        assign item_price = block.settings.price
        assign item_image = block.settings.image
        assign item_url = block.settings.link
        if block.settings.product != blank
          assign item_title = block.settings.product.title
          assign item_price = block.settings.product.price | money
          assign item_image = block.settings.product.featured_image
          assign item_url = block.settings.product.url
        endif
      -%}
      <div class="sm1c-bun-card" {{ block.shopify_attributes }}>
        <a href="{{ item_url | default: '#' }}">
          <div class="sm1c-bun-imgwrap">
            <div class="sm1c-bun-img">
              {%- if item_image != blank -%}
                {{ item_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: item_title }}
              {%- endif -%}
            </div>
            {%- if block.settings.badge_text != blank -%}
              <div class="sm1c-bun-badge">{{ block.settings.badge_text }}</div>
            {%- endif -%}
          </div>
          <div class="sm1c-bun-name">{{ item_title }}</div>
          <div class="sm1c-bun-price">
            {{ item_price }}
            {%- if block.settings.compare_at_price != blank -%}
              <span class="sm1c-bun-compare">{{ block.settings.compare_at_price }}</span>
            {%- endif -%}
          </div>
        </a>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SM1C Bundle & Save",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle & Save"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "View-all pill background",
      "default": "#f6e6dd"
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (optional, overrides fields below)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "SAVE 58%"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Triple Lip Plumper Bundle"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$48.00"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare-at price (optional)",
          "default": "$115.00"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "SM1C Bundle & Save",
      "blocks": [
        { "type": "bundle", "settings": { "badge_text": "SAVE 58%", "title": "Triple Lip Plumper Bundle", "price": "$48.00", "compare_at_price": "$115.00" } },
        { "type": "bundle", "settings": { "badge_text": "SALE", "title": "Lash & Brow Growth Kit", "price": "$48.00", "compare_at_price": "$77.00" } },
        { "type": "bundle", "settings": { "badge_text": "SAVE 65%", "title": "Bestseller Duo Kit", "price": "$58.00", "compare_at_price": "$168.00" } },
        { "type": "bundle", "settings": { "badge_text": "SAVE 54%", "title": "Bestseller Mega Lip Bundle", "price": "$68.00", "compare_at_price": "$150.00" } }
      ]
    }
  ]
}
{% endschema %}
