<!-- ══════════════════════════════════════════════
     JAVASCRIPT — Gallery, Bundle, Before/After, FAQ
══════════════════════════════════════════════ -->
<script>
(function() {
  'use strict';

  /* ─── Gallery Thumbnail Click ─── */
  window.ledMaskThumbClick = function(el) {
    var mainImg = document.getElementById('led-mask-main-img');
    if (mainImg && el.dataset.src) {
      mainImg.src = el.dataset.src;
      // update active state
      var thumbs = el.closest('.lm-thumbnails').querySelectorAll('.lm-thumb');
      thumbs.forEach(function(t) { t.classList.remove('active'); });
      el.classList.add('active');
    }
  };

  /* ─── Bundle Tier Selection ─── */
  document.addEventListener('DOMContentLoaded', function() {
    var sectionId = '{{ section.id }}';
    var bundleInputs = document.querySelectorAll('[name="led_bundle_qty"]');
    var qtyInput = document.getElementById('led-mask-quantity-' + sectionId);
    var currentPrice = document.getElementById('led-mask-price-current-' + sectionId);
    var comparePrice = document.getElementById('led-mask-price-compare-' + sectionId);
    var saveBadge = document.getElementById('led-mask-save-badge-' + sectionId);

    var basePrice = {{ base_price }};
    var discounts = { '1': 0, '2': 0.40, '3': 0.45 };
    var saveLabels = { '1': '', '2': 'You Save 40%', '3': 'You Save 45%' };

    function formatMoney(cents) {
      return '{{ cart.currency.symbol }}' + (cents / 100).toFixed(2);
    }

    bundleInputs.forEach(function(input) {
      input.addEventListener('change', function() {
        var qty = parseInt(this.value);
        var discount = discounts[String(qty)] || 0;
        var originalTotal = basePrice * qty;
        var discountedTotal = Math.round(originalTotal * (1 - discount));

        if (qtyInput) qtyInput.value = qty;
        if (currentPrice) currentPrice.textContent = formatMoney(discountedTotal);

        if (comparePrice) {
          if (discount > 0) {
            comparePrice.textContent = formatMoney(originalTotal);
            comparePrice.style.display = '';
          } else {
            comparePrice.style.display = 'none';
          }
        }

        if (saveBadge) {
          var label = saveLabels[String(qty)] || '';
          if (label) {
            saveBadge.textContent = label;
            saveBadge.style.display = '';
          } else {
            saveBadge.style.display = 'none';
          }
        }
      });
    });

    /* ─── Before/After Slider ─── */
    var baContainer = document.getElementById('led-mask-ba-{{ section.id }}');
    if (baContainer) {
      var baBefore = document.getElementById('led-mask-ba-before-{{ section.id }}');
      var baLine = document.getElementById('led-mask-ba-line-{{ section.id }}');
      var baHandle = document.getElementById('led-mask-ba-handle-{{ section.id }}');
      var isDragging = false;

      function setSliderPos(pct) {
        pct = Math.max(5, Math.min(95, pct));
        if (baBefore) baBefore.style.clipPath = 'inset(0 ' + (100 - pct) + '% 0 0)';
        if (baLine) baLine.style.left = pct + '%';
        if (baHandle) baHandle.style.left = pct + '%';
      }

      function getPos(e) {
        var rect = baContainer.getBoundingClientRect();
        var clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        return ((clientX - rect.left) / rect.width) * 100;
      }

      baContainer.addEventListener('mousedown', function(e) {
        isDragging = true;
        setSliderPos(getPos(e));
        e.preventDefault();
      });

      baContainer.addEventListener('touchstart', function(e) {
        isDragging = true;
        setSliderPos(getPos(e));
      }, { passive: true });

      document.addEventListener('mousemove', function(e) {
        if (isDragging) setSliderPos(getPos(e));
      });

      document.addEventListener('touchmove', function(e) {
        if (isDragging) setSliderPos(getPos(e));
      }, { passive: true });

      document.addEventListener('mouseup', function() { isDragging = false; });
      document.addEventListener('touchend', function() { isDragging = false; });

      // Initialize at 50%
      setSliderPos(50);
    }

    /* ─── Scroll-triggered animations ─── */
    if ('IntersectionObserver' in window) {
      var animEls = document.querySelectorAll('.lm-wave-card, .lm-stat-item, .lm-faq-item');
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

      animEls.forEach(function(el) {
        el.style.opacity = '0';
        el.style.transform = 'translateY(24px)';
        el.style.transition = 'opacity 0.55s ease, transform 0.55s ease';
        observer.observe(el);
      });
    }
  });

  /* ─── FAQ Toggle ─── */
  window.ledMaskFaqToggle = function(btn) {
    var item = btn.closest('.lm-faq-item');
    var isOpen = item.classList.contains('open');
    // Close all
    document.querySelectorAll('.lm-faq-item.open').forEach(function(openItem) {
      openItem.classList.remove('open');
      openItem.querySelector('.lm-faq-question').setAttribute('aria-expanded', 'false');
    });
    // Open clicked (if it was closed)
    if (!isOpen) {
      item.classList.add('open');
      btn.setAttribute('aria-expanded', 'true');
    }
  };

})();
</script>


