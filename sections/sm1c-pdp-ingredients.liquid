{%- style -%}
#shopify-section-{{ section.id }} .sm1c-ing-wrap {
  padding: 60px 44px;
  background: oklch(94% 0.03 30);
  font-family: 'Work Sans', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-ing-photo {
  height: 200px;
  border-radius: 20px;
  overflow: hidden;
  margin-bottom: 32px;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-ing-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-ing-list {
  display: flex;
  flex-direction: column;
  max-width: 820px;
  margin: 0 auto;
  background: #fff;
  border-radius: 20px;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-ing-item {
  border-bottom: 1px solid oklch(92% 0.01 30);
}
#shopify-section-{{ section.id }} .sm1c-ing-item:last-child {
  border-bottom: none;
}
#shopify-section-{{ section.id }} .sm1c-ing-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 24px;
  list-style: none;
}
#shopify-section-{{ section.id }} .sm1c-ing-summary::-webkit-details-marker {
  display: none;
}
#shopify-section-{{ section.id }} .sm1c-ing-item.has-description .sm1c-ing-summary {
  cursor: pointer;
}
#shopify-section-{{ section.id }} .sm1c-ing-item.has-description .sm1c-ing-summary::after {
  content: "\02c5";
  color: oklch(55% 0.03 30);
  transition: transform .2s ease;
  flex: none;
  margin-left: 12px;
}
#shopify-section-{{ section.id }} .sm1c-ing-item.has-description[open] .sm1c-ing-summary::after {
  transform: rotate(180deg);
}
#shopify-section-{{ section.id }} .sm1c-ing-name {
  font-size: 14px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-ing-tag {
  background: oklch(94% 0.03 30);
  color: oklch(60% 0.16 25);
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 100px;
  margin-left: 6px;
}
#shopify-section-{{ section.id }} .sm1c-ing-support {
  font-size: 12px;
  color: oklch(45% 0.02 30);
  margin-top: 4px;
}
#shopify-section-{{ section.id }} .sm1c-ing-body {
  padding: 0 24px 20px;
  font-size: 13px;
  line-height: 1.6;
  color: oklch(40% 0.02 30);
}
{%- endstyle -%}

<div class="sm1c-ing-wrap">
  {%- if section.settings.image != blank -%}
    <div class="sm1c-ing-photo">
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: '' }}
    </div>
  {%- endif -%}
  <div class="sm1c-ing-list">
    {%- if product.metafields.custom.fabric_facts.value.size > 0 -%}
      {%- for fact in product.metafields.custom.fabric_facts.value -%}
        <details class="sm1c-ing-item">
          <summary class="sm1c-ing-summary">
            <div>
              <div class="sm1c-ing-name">
                {{ fact.name.value }}
                {%- if fact.tag.value != blank -%}
                  <span class="sm1c-ing-tag">{{ fact.tag.value }}</span>
                {%- endif -%}
              </div>
              {%- if fact.support_text.value != blank -%}
                <div class="sm1c-ing-support">{{ fact.support_text.value }}</div>
              {%- endif -%}
            </div>
          </summary>
        </details>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        <details class="sm1c-ing-item{% if block.settings.description != blank %} has-description{% endif %}" {{ block.shopify_attributes }}>
          <summary class="sm1c-ing-summary">
            <div>
              <div class="sm1c-ing-name">
                {{ block.settings.name }}
                {%- if block.settings.tag != blank -%}
                  <span class="sm1c-ing-tag">{{ block.settings.tag }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.support_text != blank -%}
                <div class="sm1c-ing-support">{{ block.settings.support_text }}</div>
              {%- endif -%}
            </div>
          </summary>
          {%- if block.settings.description != blank -%}
            <div class="sm1c-ing-body">{{ block.settings.description }}</div>
          {%- endif -%}
        </details>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SM1C Ingredients",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Top photo" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Vitamin E" },
        { "type": "text", "id": "tag", "label": "Tag label", "default": "HYDRATION" },
        { "type": "text", "id": "support_text", "label": "Support text", "default": "Used to support: nourished, softer lips" },
        { "type": "textarea", "id": "description", "label": "Description (shown when expanded)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "SM1C Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Vitamin E", "tag": "HYDRATION", "support_text": "Used to support: nourished, softer lips" } },
        { "type": "ingredient", "settings": { "name": "Peptide Complex", "tag": "VOLUME", "support_text": "Used to support: fullness & definition" } },
        { "type": "ingredient", "settings": { "name": "Shea Butter", "tag": "MOISTURE", "support_text": "Used to support: everyday comfort" } }
      ]
    }
  ]
}
{% endschema %}
