{%- style -%}
#shopify-section-{{ section.id }} .sm1c-vp-outer {
  background: {{ section.settings.page_bg }};
  padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 44px) {{ section.settings.padding_bottom }}px;
  {%- if section.settings.overlap -%}
  margin-top: -46px;
  position: relative;
  z-index: 4;
  {%- endif -%}
}
#shopify-section-{{ section.id }} .sm1c-vp-wrap {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: {{ section.settings.card_bg }};
  border: 1px solid var(--sm1c-border, rgba(0,0,0,.07));
  border-radius: 18px;
  box-shadow: 0 18px 44px -24px rgba(43, 33, 29, .3);
  overflow: hidden;
  font-family: var(--sm1c-sans, sans-serif);
}
#shopify-section-{{ section.id }} .sm1c-vp-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 26px clamp(16px, 1.8vw, 26px);
  border-right: 1px solid var(--sm1c-border, rgba(0,0,0,.07));
}
#shopify-section-{{ section.id }} .sm1c-vp-item:last-child {
  border-right: none;
}
#shopify-section-{{ section.id }} .sm1c-vp-icon {
  flex: none;
  width: 30px;
  height: 30px;
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-vp-icon svg {
  width: 100%;
  height: 100%;
}
#shopify-section-{{ section.id }} .sm1c-vp-title {
  font-size: 14px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--sm1c-ink, #2b211d);
  margin-bottom: 4px;
}
#shopify-section-{{ section.id }} .sm1c-vp-body {
  font-size: 12.5px;
  line-height: 1.5;
  color: rgba(43, 33, 29, .62);
}
@media (max-width: 989px) {
  #shopify-section-{{ section.id }} .sm1c-vp-wrap {
    grid-template-columns: repeat(2, 1fr);
  }
  #shopify-section-{{ section.id }} .sm1c-vp-item:nth-child(2) {
    border-right: none;
  }
  #shopify-section-{{ section.id }} .sm1c-vp-item:nth-child(-n+2) {
    border-bottom: 1px solid var(--sm1c-border, rgba(0,0,0,.07));
  }
}
@media (max-width: 599px) {
  #shopify-section-{{ section.id }} .sm1c-vp-outer {
    margin-top: 0;
  }
  #shopify-section-{{ section.id }} .sm1c-vp-wrap {
    grid-template-columns: 1fr;
  }
  #shopify-section-{{ section.id }} .sm1c-vp-item {
    border-right: none;
    border-bottom: 1px solid var(--sm1c-border, rgba(0,0,0,.07));
    padding: 20px;
  }
  #shopify-section-{{ section.id }} .sm1c-vp-item:last-child {
    border-bottom: none;
  }
}
{%- endstyle -%}

<div class="sm1c-vp-outer">
  <div class="sm1c-vp-wrap">
    {%- for block in section.blocks -%}
      <div class="sm1c-vp-item" {{ block.shopify_attributes }}>
        <span class="sm1c-vp-icon">
          {%- case block.settings.icon -%}
            {%- when 'sparkle' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4L12 3Z"/><path d="M18.5 15.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2Z"/></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3c4 1 7 1 7 1v7c0 5-3 8-7 10-4-2-7-5-7-10V4s3 0 7-1Z"/><path d="m9.2 12 1.9 1.9L14.9 10"/></svg>
            {%- when 'flower' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="2.4"/><path d="M12 9.6c0-2.6-1-4.6-2.6-4.6S7 6.6 7 8.4c0 1.4 1 2.4 2.4 3M14.4 12c2.6 0 4.6-1 4.6-2.6S17.4 7 15.6 7c-1.4 0-2.4 1-3 2.4M12 14.4c0 2.6 1 4.6 2.6 4.6S17 17.4 17 15.6c0-1.4-1-2.4-2.4-3M9.6 12c-2.6 0-4.6 1-4.6 2.6S6.6 17 8.4 17c1.4 0 2.4-1 3-2.4"/></svg>
            {%- when 'heart' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s-7-4.35-9.3-8.7C1.2 8.6 3 5.5 6.2 5.2c1.8-.2 3.3.7 4.3 2.1C11.5 5.9 13 5 14.8 5.2c3.2.3 5 3.4 3.5 6.6C15.9 16.15 12 20.5 12 20.5Z"/></svg>
            {%- when 'leaf' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20c0-8 5-13 16-13 0 9-5 13-11 13a7 7 0 0 1-5-2Z"/><path d="M9 15c2-3 5-5 8-6"/></svg>
            {%- when 'truck' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h10v9H3zM13 10h4.5l2.5 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>
          {%- endcase -%}
        </span>
        <div>
          <div class="sm1c-vp-title">{{ block.settings.title }}</div>
          <div class="sm1c-vp-body">{{ block.settings.body }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SM1C Value Pillars",
  "settings": [
    {
      "type": "checkbox",
      "id": "overlap",
      "label": "Overlap the section above (floating card effect)",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "page_bg",
      "label": "Page background",
      "default": "#fbf6ee"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Icon color",
      "default": "#E8637E"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "shield", "label": "Shield" },
            { "value": "flower", "label": "Flower" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "truck", "label": "Truck" },
            { "value": "check", "label": "Check" }
          ],
          "default": "sparkle"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Premium Quality" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Carefully selected ingredients for visible results." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "SM1C Value Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "sparkle", "title": "Premium Quality", "body": "Carefully selected ingredients for visible results." } },
        { "type": "pillar", "settings": { "icon": "shield", "title": "Safe & Effective", "body": "Formulated to be gentle on all skin types." } },
        { "type": "pillar", "settings": { "icon": "flower", "title": "K-Beauty Expertise", "body": "Advanced Korean skincare, backed by science." } },
        { "type": "pillar", "settings": { "icon": "heart", "title": "Loved by Thousands", "body": "Join our community of glowing skin lovers." } }
      ]
    }
  ]
}
{% endschema %}
