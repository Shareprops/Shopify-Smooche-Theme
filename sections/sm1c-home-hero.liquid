{%- style -%}
#shopify-section-{{ section.id }} .sm1c-hh-wrap {
  font-family: 'Work Sans', sans-serif;
  position: relative;
  min-height: {{ section.settings.height }}px;
  background: linear-gradient(135deg, oklch(80% 0.1 30), #F0899D);
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-hh-img {
  position: absolute;
  right: 6%;
  top: 8%;
  width: 44%;
  height: 84%;
  border-radius: 28px;
  overflow: hidden;
  background: rgba(255,255,255,.25);
}
#shopify-section-{{ section.id }} .sm1c-hh-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-hh-content {
  position: relative;
  z-index: 2;
  max-width: 460px;
  color: #fff;
  padding: 90px 0 0 60px;
}
#shopify-section-{{ section.id }} .sm1c-hh-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,.25);
  backdrop-filter: blur(8px);
  padding: 8px 16px;
  border-radius: 100px;
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 22px;
}
#shopify-section-{{ section.id }} .sm1c-hh-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 60px;
  line-height: 1.05;
  font-weight: 600;
  margin: 0;
}
#shopify-section-{{ section.id }} .sm1c-hh-sub {
  margin-top: 20px;
  font-size: 16px;
  line-height: 1.5;
  max-width: 380px;
  opacity: .95;
}
#shopify-section-{{ section.id }} .sm1c-hh-ctas {
  display: flex;
  gap: 14px;
  margin-top: 30px;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .sm1c-hh-cta-primary {
  background: #111;
  color: #fff;
  padding: 16px 30px;
  border-radius: 14px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  display: inline-block;
}
#shopify-section-{{ section.id }} .sm1c-hh-cta-secondary {
  background: rgba(255,255,255,.2);
  border: 1.5px solid rgba(255,255,255,.7);
  color: #fff;
  padding: 16px 30px;
  border-radius: 14px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  display: inline-block;
}
#shopify-section-{{ section.id }} .sm1c-hh-clinician {
  position: absolute;
  left: 60px;
  bottom: 40px;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fff;
  padding: 12px 18px;
  border-radius: 14px;
  font-size: 12px;
  font-weight: 600;
  color: #111;
}
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .sm1c-hh-wrap {
    min-height: auto;
    padding-bottom: 32px;
  }
  #shopify-section-{{ section.id }} .sm1c-hh-img {
    position: static;
    width: 100%;
    height: 320px;
    border-radius: 0;
    margin-bottom: 0;
  }
  #shopify-section-{{ section.id }} .sm1c-hh-content {
    max-width: 100%;
    padding: 32px 24px 0;
  }
  #shopify-section-{{ section.id }} .sm1c-hh-title {
    font-size: 38px;
  }
  #shopify-section-{{ section.id }} .sm1c-hh-clinician {
    position: static;
    display: inline-flex;
    left: auto;
    bottom: auto;
    margin: 20px 24px 0;
    width: fit-content;
  }
}
{%- endstyle -%}

<div class="sm1c-hh-wrap">
  {%- if section.settings.image != blank -%}
    <div class="sm1c-hh-img">
      {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager', alt: section.settings.image.alt }}
    </div>
  {%- endif -%}
  <div class="sm1c-hh-content">
    {%- if section.settings.badge_text != blank -%}
      <div class="sm1c-hh-badge">{{ section.settings.badge_text }}</div>
    {%- endif -%}
    <h1 class="sm1c-hh-title">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <div class="sm1c-hh-sub">{{ section.settings.subheading }}</div>
    {%- endif -%}
    <div class="sm1c-hh-ctas">
      {%- if section.settings.button_1_label != blank -%}
        <a href="{{ section.settings.button_1_link }}" class="sm1c-hh-cta-primary">{{ section.settings.button_1_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a href="{{ section.settings.button_2_link }}" class="sm1c-hh-cta-secondary">{{ section.settings.button_2_label }}</a>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.clinician_text != blank -%}
    <div class="sm1c-hh-clinician">{{ section.settings.clinician_text }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "SM1C Home Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Model / hero image" },
    { "type": "text", "id": "badge_text", "label": "Top badge text", "default": "★★★★★ Loved by 50,000+ customers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beauty inspired by you." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Skin-loving formulas designed for real routines — and the real you." },
    { "type": "text", "id": "button_1_label", "label": "Primary button label", "default": "Shop Bestsellers" },
    { "type": "url", "id": "button_1_link", "label": "Primary button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button label", "default": "Shop The Foundation" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link" },
    { "type": "text", "id": "clinician_text", "label": "Trust strip text", "default": "Clinicians' Choice — 197 clinicians recommend Serein" },
    { "type": "range", "id": "height", "label": "Section height (px)", "min": 360, "max": 760, "step": 20, "default": 600 }
  ],
  "presets": [{ "name": "SM1C Home Hero" }]
}
{% endschema %}
