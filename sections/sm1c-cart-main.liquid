    { "type": "header", "content": "Delivery estimate" },
    { "type": "checkbox", "id": "show_eta", "label": "Show estimated delivery window", "default": true },
    { "type": "text", "id": "eta_prefix", "label": "Estimate prefix", "default": "Estimated delivery" },
    { "type": "text", "id": "eta_suffix", "label": "Estimate suffix", "default": "Ships free from the U.S." },
