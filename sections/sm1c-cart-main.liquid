    { "type": "range", "id": "eta_max_days", "label": "Latest delivery (days)", "min": 1, "max": 45, "step": 1, "default": 9 },

    { "type": "header", "content": "Trust signals" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show accepted payment icons", "default": true },
    { "type": "text", "id": "trust_guarantee_title", "label": "Guarantee title", "default": "30-day money-back" },
    { "type": "text", "id": "trust_guarantee_body", "label": "Guarantee body", "default": "Not a match? Full refund, no return shipping." },
    { "type": "text", "id": "trust_shipping_title", "label": "Shipping title", "default": "Free U.S. shipping" },
    { "type": "text", "id": "trust_shipping_body", "label": "Shipping body", "default": "On every order, no minimum spend." },
    { "type": "text", "id": "trust_secure_title", "label": "Security title", "default": "Secure checkout" },
    { "type": "text", "id": "trust_secure_body", "label": "Security body", "default": "Encrypted payments via Shop Pay, Apple Pay and all major cards." },

    { "type": "header", "content": "Empty cart" },
    { "type": "text", "id": "empty_title", "label": "Empty cart title", "default": "Your cart is empty" },
    { "type": "text", "id": "empty_subtitle", "label": "Empty cart subtitle", "default": "Looks like you haven't added anything yet." },
    { "type": "text", "id": "empty_cta_label", "label": "Empty cart button label", "default": "Continue Shopping" },
    { "type": "url", "id": "empty_cta_link", "label": "Continue shopping link" }
  ],
  "presets": [
    { "name": "SM1C Cart" }
  ]
}
{% endschema %}
