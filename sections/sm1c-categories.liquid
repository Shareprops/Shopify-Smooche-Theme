{%- style -%}
#shopify-section-{{ section.id }} .sm1c-cat-wrap {
  padding: 60px 44px;
  background: {{ section.settings.bg_color }};
  font-family: 'Work Sans', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-cat-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 30px;
  font-weight: 800;
  text-align: center;
  margin-bottom: 32px;
}
#shopify-section-{{ section.id }} .sm1c-cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
#shopify-section-{{ section.id }} .sm1c-cat-tile {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  height: 320px;
  display: block;
  color: inherit;
  text-decoration: none;
  background: #ddd;
}
#shopify-section-{{ section.id }} .sm1c-cat-tile img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
#shopify-section-{{ section.id }} .sm1c-cat-tile::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.55), transparent 55%);
}
#shopify-section-{{ section.id }} .sm1c-cat-label {
  position: absolute;
  bottom: 22px;
  left: 22px;
  color: #fff;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-weight: 800;
  font-size: 20px;
  z-index: 1;
}
#shopify-section-{{ section.id }} .sm1c-cat-cta {
  text-align: center;
  margin-top: 30px;
}
#shopify-section-{{ section.id }} .sm1c-cat-cta a {
  background: #111;
  color: #fff;
  padding: 16px 32px;
  border-radius: 14px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  display: inline-block;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-cat-grid {
    grid-template-columns: 1fr;
  }
}
:root[data-theme='dark'] #shopify-section-{{ section.id }} .sm1c-cat-wrap {
  background: var(--sm1c-bg);
  color: var(--sm1c-text);
}
:root[data-theme='dark'] #shopify-section-{{ section.id }} .sm1c-cat-cta a {
  background: var(--sm1c-surface);
  color: var(--sm1c-text);
}
{%- endstyle -%}

<div class="sm1c-cat-wrap">
  <div class="sm1c-cat-title">{{ section.settings.heading }}</div>
  <div class="sm1c-cat-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="sm1c-cat-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.label }}
        {%- endif -%}
        <div class="sm1c-cat-label">{{ block.settings.label }}</div>
      </a>
    {%- endfor -%}
  </div>
  {%- if section.settings.cta_label != blank -%}
    <div class="sm1c-cat-cta">
      <a href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "SM1C Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f6e6dd"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Bottom button label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Bottom button link"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Face"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "SM1C Categories",
      "blocks": [
        { "type": "tile", "settings": { "label": "Face" } },
        { "type": "tile", "settings": { "label": "Lips & Cheeks" } },
        { "type": "tile", "settings": { "label": "Eyes" } }
      ]
    }
  ]
}
{% endschema %}
