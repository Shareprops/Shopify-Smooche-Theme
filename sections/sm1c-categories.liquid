{%- style -%}
#shopify-section-{{ section.id }} .sm1c-cat-wrap {
  padding: 60px 44px;
  background: {{ section.settings.bg_color }};
  font-family: 'Inter', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-cat-title {
  font-family: 'Fraunces', serif;
  font-size: 30px;
  font-weight: 400;
  text-align: center;
  margin-bottom: 32px;
}
#shopify-section-{{ section.id }} .sm1c-cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
#shopify-section-{{ section.id }} .sm1c-cat-tile {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  height: 320px;
  display: block;
  color: inherit;
  text-decoration: none;
  background: #ddd;
}
#shopify-section-{{ section.id }} .sm1c-cat-tile img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
#shopify-section-{{ section.id }} .sm1c-cat-tile::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, .82) 0%, rgba(0, 0, 0, .5) 32%, transparent 62%);
}
#shopify-section-{{ section.id }} .sm1c-cat-text {
  position: absolute;
  bottom: 22px;
  left: 22px;
  right: 22px;
  color: #fff;
  z-index: 1;
}
#shopify-section-{{ section.id }} .sm1c-cat-label {
  font-family: 'Fraunces', serif;
  font-weight: 400;
  font-size: 20px;
  text-shadow: 0 1px 4px rgba(0, 0, 0, .5);
}
#shopify-section-{{ section.id }} .sm1c-cat-subtitle {
  margin-top: 2px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .03em;
  text-transform: uppercase;
  opacity: .92;
  text-shadow: 0 1px 3px rgba(0, 0, 0, .5);
}
#shopify-section-{{ section.id }} .sm1c-cat-cta {
  text-align: center;
  margin-top: 30px;
}
#shopify-section-{{ section.id }} .sm1c-cat-cta a {
  background: #111;
  color: #fff;
  padding: 16px 32px;
  border-radius: 14px;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  display: inline-block;
}
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .sm1c-cat-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-cat-grid {
    grid-template-columns: 1fr;
  }
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-cat-wrap {
  background: var(--sm1c-bg);
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-cat-cta a {
  background: var(--sm1c-surface);
  color: var(--sm1c-text);
}
{%- endstyle -%}

<div class="sm1c-cat-wrap">
  <div class="sm1c-cat-title">{{ section.settings.heading }}</div>
  <div class="sm1c-cat-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tile_collection = block.settings.collection
        assign tile_image = block.settings.image | default: tile_collection.image
        assign tile_label = block.settings.label | default: tile_collection.title
        assign tile_link = block.settings.link | default: tile_collection.url
      -%}
      <a href="{{ tile_link | default: '#' }}" class="sm1c-cat-tile" {{ block.shopify_attributes }}>
        {%- if tile_image != blank -%}
          {{ tile_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: tile_label }}
        {%- endif -%}
        <div class="sm1c-cat-text">
          <div class="sm1c-cat-label">{{ tile_label }}</div>
          {%- if block.settings.subtitle != blank -%}
            <div class="sm1c-cat-subtitle">{{ block.settings.subtitle }}</div>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
  {%- if section.settings.cta_label != blank -%}
    <div class="sm1c-cat-cta">
      <a href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "SM1C Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f6e6dd"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Bottom button label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Bottom button link"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Auto-fills the image, label, and link below unless you override them."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label override"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "SM1C Categories",
      "blocks": [
        { "type": "tile", "settings": { "label": "Face" } },
        { "type": "tile", "settings": { "label": "Lips & Cheeks" } },
        { "type": "tile", "settings": { "label": "Eyes" } }
      ]
    }
  ]
}
{% endschema %}
