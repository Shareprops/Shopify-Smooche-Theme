{%- style -%}
#shopify-section-{{ section.id }} .sm1c-bl-hero {
  padding: 70px clamp(20px, 5vw, 72px) 60px;
  background: {{ section.settings.hero_bg_color | default: '#fdfaf6' }};
  font-family: var(--sm1c-sans, sans-serif);
}
#shopify-section-{{ section.id }} .sm1c-bl-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
  max-width: 1160px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .sm1c-bl-hero-img {
  aspect-ratio: 4 / 3.2;
  border-radius: 24px;
  overflow: hidden;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-bl-hero-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-bl-eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #fff;
  background: {{ section.settings.accent_color | default: '#E8637E' }};
  padding: 7px 14px;
  border-radius: 100px;
  margin-bottom: 18px;
}
#shopify-section-{{ section.id }} .sm1c-bl-title {
  font-family: var(--sm1c-serif, serif);
  font-size: clamp(32px, 4vw, 46px);
  font-weight: 500;
  line-height: 1.08;
  color: var(--sm1c-ink, #2b211d);
  margin-bottom: 16px;
}
#shopify-section-{{ section.id }} .sm1c-bl-story {
  font-size: 15px;
  line-height: 1.7;
  color: rgba(43, 33, 29, .7);
  margin-bottom: 28px;
  max-width: 460px;
}
#shopify-section-{{ section.id }} .sm1c-bl-value {
  font-size: 13px;
  color: rgba(43, 33, 29, .55);
  margin-bottom: 20px;
}
#shopify-section-{{ section.id }} .sm1c-bl-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: {{ section.settings.accent_color | default: '#E8637E' }};
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: .02em;
  padding: 16px 30px;
  border-radius: 100px;
  text-decoration: none;
}
#shopify-section-{{ section.id }} .sm1c-bl-included {
  padding: 60px clamp(20px, 5vw, 72px);
  background: var(--sm1c-bg, #fff);
}
#shopify-section-{{ section.id }} .sm1c-bl-included-head {
  text-align: center;
  max-width: 560px;
  margin: 0 auto 40px;
}
#shopify-section-{{ section.id }} .sm1c-bl-included-title {
  font-family: var(--sm1c-serif, serif);
  font-size: clamp(26px, 3vw, 34px);
  font-weight: 500;
  margin-bottom: 10px;
  color: var(--sm1c-ink, #2b211d);
}
#shopify-section-{{ section.id }} .sm1c-bl-included-sub {
  font-size: 14px;
  color: rgba(43, 33, 29, .6);
}
#shopify-section-{{ section.id }} .sm1c-bl-included-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 24px;
  max-width: 1000px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .sm1c-bl-item {
  background: var(--sm1c-surface, #fff);
  border: 1px solid var(--sm1c-border, rgba(0,0,0,.07));
  border-radius: 18px;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-bl-item-img {
  aspect-ratio: 1 / 1;
  background: #eee;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-bl-item-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-bl-item-body {
  padding: 18px 18px 20px;
}
#shopify-section-{{ section.id }} .sm1c-bl-item-step {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: {{ section.settings.accent_color | default: '#E8637E' }};
  margin-bottom: 6px;
}
#shopify-section-{{ section.id }} .sm1c-bl-item-name {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 6px;
  color: var(--sm1c-ink, #2b211d);
}
#shopify-section-{{ section.id }} .sm1c-bl-item-desc {
  font-size: 13px;
  line-height: 1.6;
  color: rgba(43, 33, 29, .65);
}
#shopify-section-{{ section.id }} .sm1c-bl-trust {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 28px;
  padding: 36px clamp(20px, 5vw, 72px);
  background: {{ section.settings.hero_bg_color | default: '#fdfaf6' }};
}
#shopify-section-{{ section.id }} .sm1c-bl-trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
  color: var(--sm1c-ink, #2b211d);
}
#shopify-section-{{ section.id }} .sm1c-bl-footer-cta {
  text-align: center;
  padding: 60px clamp(20px, 5vw, 72px) 72px;
}
#shopify-section-{{ section.id }} .sm1c-bl-footer-title {
  font-family: var(--sm1c-serif, serif);
  font-size: clamp(24px, 2.8vw, 30px);
  font-weight: 500;
  margin-bottom: 22px;
  color: var(--sm1c-ink, #2b211d);
}
@media (max-width: 800px) {
  #shopify-section-{{ section.id }} .sm1c-bl-hero-grid {
    grid-template-columns: 1fr;
  }
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-hero,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-trust {
  background: var(--sm1c-surface);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-included {
  background: var(--sm1c-bg);
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-item {
  background: var(--sm1c-surface);
  border-color: var(--sm1c-border);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-story,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-value,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-included-sub,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-item-desc {
  color: rgba(240, 237, 232, .6);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-title,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-included-title,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-item-name,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-trust-item,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-bl-footer-title {
  color: var(--sm1c-text);
}
{%- endstyle -%}

<div class="sm1c-bl-hero">
  <div class="sm1c-bl-hero-grid">
    <div class="sm1c-bl-hero-img">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- endif -%}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <span class="sm1c-bl-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <div class="sm1c-bl-title">{{ section.settings.heading }}</div>
      {%- if section.settings.story != blank -%}
        <div class="sm1c-bl-story">{{ section.settings.story }}</div>
      {%- endif -%}
      {%- if section.settings.value_note != blank -%}
        <div class="sm1c-bl-value">{{ section.settings.value_note }}</div>
      {%- endif -%}
      {%- if section.settings.cta_link != blank -%}
        <a class="sm1c-bl-cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | default: 'Buy This Bundle' }} &rarr;</a>
      {%- endif -%}
    </div>
  </div>
</div>

{%- assign item_blocks = section.blocks | where: 'type', 'included_item' -%}
{%- if item_blocks.size > 0 -%}
  <div class="sm1c-bl-included">
    <div class="sm1c-bl-included-head">
      {%- if section.settings.included_heading != blank -%}
        <div class="sm1c-bl-included-title">{{ section.settings.included_heading }}</div>
      {%- endif -%}
      {%- if section.settings.included_subheading != blank -%}
        <div class="sm1c-bl-included-sub">{{ section.settings.included_subheading }}</div>
      {%- endif -%}
    </div>
    <div class="sm1c-bl-included-grid">
      {%- for block in item_blocks -%}
        <div class="sm1c-bl-item" {{ block.shopify_attributes }}>
          <div class="sm1c-bl-item-img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {%- endif -%}
          </div>
          <div class="sm1c-bl-item-body">
            {%- if block.settings.step_label != blank -%}
              <div class="sm1c-bl-item-step">{{ block.settings.step_label }}</div>
            {%- endif -%}
            <div class="sm1c-bl-item-name">{{ block.settings.name }}</div>
            {%- if block.settings.description != blank -%}
              <div class="sm1c-bl-item-desc">{{ block.settings.description }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- assign trust_blocks = section.blocks | where: 'type', 'trust_item' -%}
{%- if trust_blocks.size > 0 -%}
  <div class="sm1c-bl-trust">
    {%- for block in trust_blocks -%}
      <div class="sm1c-bl-trust-item" {{ block.shopify_attributes }}>
        <span aria-hidden="true">{{ block.settings.icon }}</span>
        {{ block.settings.label }}
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{%- if section.settings.cta_link != blank -%}
  <div class="sm1c-bl-footer-cta">
    {%- if section.settings.footer_heading != blank -%}
      <div class="sm1c-bl-footer-title">{{ section.settings.footer_heading }}</div>
    {%- endif -%}
    <a class="sm1c-bl-cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | default: 'Buy This Bundle' }} &rarr;</a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "SM1C Bundle Landing",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow badge", "default": "Limited-Time Bundle" },
    { "type": "text", "id": "heading", "label": "Bundle name", "default": "The Complete Glow Ritual" },
    { "type": "textarea", "id": "story", "label": "Story / description" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "value_note", "label": "Value note (optional)", "info": "e.g. \"Over $60 if bought separately\"" },
    { "type": "url", "id": "cta_link", "label": "Buy This Bundle link", "info": "Point this at the anchor product's page where the Pumper bundle widget lives." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Buy This Bundle" },
    { "type": "text", "id": "included_heading", "label": "\"What's included\" heading", "default": "What's Included" },
    { "type": "textarea", "id": "included_subheading", "label": "\"What's included\" subheading" },
    { "type": "text", "id": "footer_heading", "label": "Footer CTA heading", "default": "Ready to start your ritual?" },
    { "type": "color", "id": "hero_bg_color", "label": "Hero/trust background color", "default": "#fdfaf6" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E8637E" }
  ],
  "blocks": [
    {
      "type": "included_item",
      "name": "Included item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "step_label", "label": "Step label (optional)", "default": "Step 1" },
        { "type": "text", "id": "name", "label": "Product name" },
        { "type": "textarea", "id": "description", "label": "Short description" }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / emoji", "default": "✦" },
        { "type": "text", "id": "label", "label": "Label", "default": "Free shipping" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "SM1C Bundle Landing",
      "blocks": [
        { "type": "included_item" },
        { "type": "included_item" },
        { "type": "included_item" },
        { "type": "trust_item", "settings": { "icon": "✦", "label": "Save vs. buying separately" } },
        { "type": "trust_item", "settings": { "icon": "🚚", "label": "Free U.S. shipping" } },
        { "type": "trust_item", "settings": { "icon": "🔒", "label": "30-day guarantee" } }
      ]
    }
  ]
}
{% endschema %}
