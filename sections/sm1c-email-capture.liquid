{%- style -%}
#shopify-section-{{ section.id }} .sm1c-ec-wrap {
  padding: 64px clamp(20px, 4vw, 44px);
  background: {{ section.settings.bg_color }};
  font-family: var(--sm1c-sans, sans-serif);
}
#shopify-section-{{ section.id }} .sm1c-ec-inner {
  max-width: 620px;
  margin: 0 auto;
  text-align: center;
}
#shopify-section-{{ section.id }} .sm1c-ec-eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: {{ section.settings.accent_color }};
  margin-bottom: 12px;
}
#shopify-section-{{ section.id }} .sm1c-ec-heading {
  font-family: var(--sm1c-serif, serif);
  font-size: clamp(28px, 3vw, 38px);
  font-weight: 500;
  line-height: 1.15;
  color: var(--sm1c-ink, #2b211d);
  margin: 0 0 14px;
}
#shopify-section-{{ section.id }} .sm1c-ec-heading em {
  font-style: italic;
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-ec-sub {
  font-size: 15px;
  line-height: 1.6;
  color: rgba(43, 33, 29, .65);
  margin-bottom: 28px;
}
#shopify-section-{{ section.id }} .sm1c-ec-form {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .sm1c-ec-input {
  flex: 1 1 280px;
  max-width: 340px;
  padding: 15px 18px;
  border: 1.5px solid var(--sm1c-border, rgba(0,0,0,.14));
  border-radius: 4px;
  background: #fff;
  font-family: inherit;
  font-size: 14px;
  color: var(--sm1c-ink, #2b211d);
  transition: border-color .2s ease;
}
#shopify-section-{{ section.id }} .sm1c-ec-input:focus {
  outline: none;
  border-color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-ec-btn {
  flex: none;
  background: var(--sm1c-rose-deep, #C2506A);
  color: #fff;
  border: none;
  padding: 15px 32px;
  border-radius: 4px;
  font-family: inherit;
  font-size: 12.5px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background .2s ease, transform .2s ease;
}
#shopify-section-{{ section.id }} .sm1c-ec-btn:hover {
  background: {{ section.settings.accent_color }};
  transform: translateY(-2px);
}
#shopify-section-{{ section.id }} .sm1c-ec-note {
  margin-top: 14px;
  font-size: 12px;
  color: rgba(43, 33, 29, .5);
}
#shopify-section-{{ section.id }} .sm1c-ec-success {
  margin-top: 16px;
  font-size: 14px;
  font-weight: 600;
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-ec-error {
  margin-top: 16px;
  font-size: 13px;
  color: #b3261e;
}
{%- endstyle -%}

<div class="sm1c-ec-wrap">
  <div class="sm1c-ec-inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="sm1c-ec-eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h2 class="sm1c-ec-heading">{{ section.settings.heading }}{%- if section.settings.heading_accent != blank -%} <em>{{ section.settings.heading_accent }}</em>{%- endif -%}</h2>
    {%- if section.settings.subtext != blank -%}
      <div class="sm1c-ec-sub">{{ section.settings.subtext }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'sm1c-ec-form-el' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="sm1c-ec-form">
        <input
          class="sm1c-ec-input"
          type="email"
          name="contact[email]"
          required
          autocomplete="email"
          placeholder="{{ section.settings.placeholder }}"
          aria-label="{{ section.settings.placeholder }}"
        >
        <button type="submit" class="sm1c-ec-btn">{{ section.settings.button_label }}</button>
      </div>

      {%- if form.posted_successfully? -%}
        <div class="sm1c-ec-success">{{ section.settings.success_text }}</div>
      {%- elsif form.errors -%}
        <div class="sm1c-ec-error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.note != blank -%}
      <div class="sm1c-ec-note">{{ section.settings.note }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SM1C Email Capture",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join The Ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% Off Your" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "First Order" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Skincare tips, early access to new drops, and subscriber-only offers — straight to your inbox." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get My 10% Off" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're in! Check your inbox for your discount code." },
    { "type": "text", "id": "note", "label": "Small print", "default": "No spam, ever. Unsubscribe anytime." },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FCF1EE" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E8637E" }
  ],
  "presets": [
    { "name": "SM1C Email Capture" }
  ]
}
{% endschema %}
