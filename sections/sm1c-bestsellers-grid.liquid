{%- style -%}
#shopify-section-{{ section.id }} .sm1c-pg-wrap {
  font-family: 'Work Sans', sans-serif;
  background: {{ section.settings.bg_color }};
}
#shopify-section-{{ section.id }} .sm1c-pg-toolbar {
  padding: 28px 44px 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
#shopify-section-{{ section.id }} .sm1c-pg-sort {
  font-size: 13px;
  font-weight: 600;
  border: none;
  background: transparent;
  font-family: inherit;
  cursor: pointer;
}
#shopify-section-{{ section.id }} .sm1c-pg-count {
  font-size: 13px;
  color: oklch(50% 0.02 30);
}
#shopify-section-{{ section.id }} .sm1c-pg-grid {
  padding: 24px 44px 64px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px 20px;
}
#shopify-section-{{ section.id }} .sm1c-pg-card {
  text-decoration: none;
  color: inherit;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pg-imgwrap {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: oklch(94% 0.03 30);
}
#shopify-section-{{ section.id }} .sm1c-pg-img {
  height: 230px;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-pg-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pg-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  padding: 5px 10px;
  border-radius: 100px;
}
#shopify-section-{{ section.id }} .sm1c-pg-name {
  margin-top: 14px;
  font-size: 14px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-pg-swatches {
  display: flex;
  gap: 6px;
  margin: 8px 0 2px;
}
#shopify-section-{{ section.id }} .sm1c-pg-swatch {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
  border: 1px solid rgba(0,0,0,.1);
}
#shopify-section-{{ section.id }} .sm1c-pg-price {
  font-size: 14px;
  font-weight: 700;
  margin-top: 4px;
}
#shopify-section-{{ section.id }} .sm1c-pg-compare {
  text-decoration: line-through;
  color: oklch(60% 0.01 30);
  font-weight: 500;
  font-size: 12px;
}
#shopify-section-{{ section.id }} .sm1c-pg-rating {
  font-size: 12px;
  color: oklch(50% 0.02 30);
  margin-top: 4px;
}
#shopify-section-{{ section.id }} .sm1c-pg-pagination {
  display: flex;
  justify-content: center;
  gap: 16px;
  padding: 0 44px 64px;
  font-size: 13px;
  font-weight: 600;
}
#shopify-section-{{ section.id }} .sm1c-pg-pagination a {
  color: oklch(60% 0.16 25);
  text-decoration: none;
}
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .sm1c-pg-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pg-wrap {
  background: var(--sm1c-bg);
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pg-sort {
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pg-count,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pg-compare,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pg-rating {
  color: rgba(240, 237, 232, .65);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pg-imgwrap,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pg-img {
  background: var(--sm1c-surface);
}
{%- endstyle -%}

<div class="sm1c-pg-wrap">
  {%- assign collection = section.settings.collection | default: collection -%}
  {%- assign tag_filter = section.settings.tag_filter -%}

  {%- assign match_count = 0 -%}
  {%- if tag_filter != blank -%}
    {%- for product in collections.all.products -%}
      {%- if product.tags contains tag_filter -%}
        {%- assign match_count = match_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- assign match_count = collection.products_count -%}
  {%- endif -%}

  <div class="sm1c-pg-toolbar">
    {%- if tag_filter == blank -%}
      <select class="sm1c-pg-sort" onchange="window.location.href=this.value">
        <option value="{{ collection.url }}?sort_by=manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Sort by: Featured</option>
        <option value="{{ collection.url }}?sort_by=best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Best selling</option>
        <option value="{{ collection.url }}?sort_by=title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>Alphabetically, A-Z</option>
        <option value="{{ collection.url }}?sort_by=title-descending" {% if collection.sort_by == 'title-descending' %}selected{% endif %}>Alphabetically, Z-A</option>
        <option value="{{ collection.url }}?sort_by=price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price, low to high</option>
        <option value="{{ collection.url }}?sort_by=price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price, high to low</option>
        <option value="{{ collection.url }}?sort_by=created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
      </select>
    {%- endif -%}
    <div class="sm1c-pg-count">{{ match_count }} products</div>
  </div>

    <div class="sm1c-pg-grid">
      {%- if tag_filter != blank -%}
        {%- assign shown_count = 0 -%}
        {%- for product in collections.all.products -%}
          {%- if product.tags contains tag_filter -%}
            {%- if shown_count >= section.settings.products_per_page -%}
              {%- break -%}
            {%- endif -%}
            {%- assign shown_count = shown_count | plus: 1 -%}
            {%- render 'sm1c-bestsellers-card', product: product, section: section -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for product in collection.products limit: section.settings.products_per_page -%}
          {%- render 'sm1c-bestsellers-card', product: product, section: section -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if match_count > section.settings.products_per_page -%}
      <div class="sm1c-pg-pagination">
        {%- if tag_filter != blank -%}
          <div>Showing {{ section.settings.products_per_page }} of {{ match_count }} products</div>
        {%- else -%}
          <a href="{{ collection.url }}">View all {{ collection.products_count }} products →</a>
        {%- endif -%}
      </div>
    {%- endif -%}
</div>

{% schema %}
{
  "name": "SM1C Bestsellers Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "text",
      "id": "tag_filter",
      "label": "Filter by product tag (optional)",
      "info": "If set, shows products from the whole store with this exact tag instead of the collection above."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#fdfaf6"
    },
    {
      "type": "color",
      "id": "sale_badge_color",
      "label": "Sale badge color",
      "default": "#c24a2e"
    },
    {
      "type": "color",
      "id": "tag_badge_color",
      "label": "Tag badge color (bestseller/viral/new)",
      "default": "#111111"
    },
    {
      "type": "checkbox",
      "id": "show_ratings",
      "label": "Show star ratings",
      "default": true
    },
    {
      "type": "text",
      "id": "default_rating_text",
      "label": "Default rating text",
      "default": "★★★★★"
    }
  ],
  "presets": [
    {
      "name": "SM1C Bestsellers Grid"
    }
  ]
}
{% endschema %}
