{%- style -%}
#shopify-section-{{ section.id }} .sm1c-test-wrap {
  padding: 60px 0;
  background: {{ section.settings.bg_color }};
  font-family: var(--sm1c-sans, sans-serif);
}
#shopify-section-{{ section.id }} .sm1c-test-eyebrow {
  text-align: center;
  font-size: 12px;
  font-weight: 700;
  color: {{ section.settings.accent_color }};
  letter-spacing: .05em;
  margin-bottom: 10px;
  padding: 0 44px;
}
#shopify-section-{{ section.id }} .sm1c-test-title {
  font-family: var(--sm1c-serif, serif);
  font-size: 34px;
  font-weight: 500;
  text-align: center;
  max-width: 560px;
  margin: 0 auto 40px;
  padding: 0 44px;
}

#shopify-section-{{ section.id }} .sm1c-test-marquee {
  display: flex;
  flex-direction: column;
  gap: 28px;
}
#shopify-section-{{ section.id }} .sm1c-test-row {
  overflow-x: hidden;
  -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
}
#shopify-section-{{ section.id }} .sm1c-test-offset {
  width: max-content;
  padding: 6px 4px 34px;
}
#shopify-section-{{ section.id }} .sm1c-test-row--bottom .sm1c-test-offset {
  margin-left: 130px;
}
#shopify-section-{{ section.id }} .sm1c-test-track {
  display: flex;
  align-items: center;
  width: max-content;
  gap: 18px;
}
#shopify-section-{{ section.id }} .sm1c-test-track > * {
  flex: none;
}
@media (prefers-reduced-motion: no-preference) {
  #shopify-section-{{ section.id }} .sm1c-test-row--top .sm1c-test-track {
    animation: sm1c-test-scroll 42s linear infinite reverse;
  }
  #shopify-section-{{ section.id }} .sm1c-test-row--bottom .sm1c-test-track {
    animation: sm1c-test-scroll 36s linear infinite;
  }
  #shopify-section-{{ section.id }} .sm1c-test-row:hover .sm1c-test-track {
    animation-play-state: paused;
  }
}
@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .sm1c-test-row {
    overflow-x: auto;
  }
  #shopify-section-{{ section.id }} .sm1c-test-offset {
    margin-left: 0 !important;
  }
}
@keyframes sm1c-test-scroll {
  to {
    transform: translate3d(-50%, 0, 0);
  }
}

#shopify-section-{{ section.id }} .sm1c-test-card {
  width: 300px;
  min-height: 338px;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 18px;
  border-radius: 20px;
  padding: 30px;
  background: {{ section.settings.card_bg }};
  box-shadow: 0 1px 2px rgba(17, 17, 17, .04), 0 12px 26px -12px rgba(17, 17, 17, .18);
  transition: transform .35s cubic-bezier(.22, 1, .36, 1), box-shadow .35s cubic-bezier(.22, 1, .36, 1);
}
#shopify-section-{{ section.id }} .sm1c-test-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 4px 10px rgba(17, 17, 17, .06), 0 26px 44px -16px rgba(17, 17, 17, .28);
}
#shopify-section-{{ section.id }} .sm1c-test-card-head {
  display: flex;
  align-items: center;
  gap: 12px;
}
#shopify-section-{{ section.id }} .sm1c-test-avatar {
  flex: none;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-test-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-test-names {
  flex: 1;
  min-width: 0;
}
#shopify-section-{{ section.id }} .sm1c-test-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
#shopify-section-{{ section.id }} .sm1c-test-author {
  font-size: 17px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
#shopify-section-{{ section.id }} .sm1c-test-headline {
  font-size: 14.5px;
  font-weight: 700;
  margin-top: 3px;
}
#shopify-section-{{ section.id }} .sm1c-test-stars {
  flex: none;
  font-size: 14.5px;
  letter-spacing: 1px;
  white-space: nowrap;
}
#shopify-section-{{ section.id }} .sm1c-test-quote-mark {
  font-family: Georgia, serif;
  font-size: 54px;
  line-height: 1;
  font-weight: 700;
  color: {{ section.settings.accent_color }};
  opacity: .35;
  margin-bottom: -16px;
}
#shopify-section-{{ section.id }} .sm1c-test-quote {
  font-size: 18px;
  font-weight: 500;
  line-height: 1.6;
  color: #262121;
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-test-media {
  width: 190px;
  aspect-ratio: 9 / 16;
  border-radius: 20px;
  background: #ddd;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-test-media img,
#shopify-section-{{ section.id }} .sm1c-test-media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-test-card {
    width: 240px;
    min-height: 267px;
    padding: 22px;
    gap: 14px;
  }
  #shopify-section-{{ section.id }} .sm1c-test-media {
    width: 150px;
  }
  #shopify-section-{{ section.id }} .sm1c-test-row--bottom .sm1c-test-track {
    padding-left: 90px;
  }
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-test-wrap {
  background: var(--sm1c-bg);
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-test-card {
  background: var(--sm1c-surface);
}
{%- endstyle -%}

<div class="sm1c-test-wrap">
  <div class="sm1c-test-eyebrow">{{ section.settings.eyebrow }}</div>
  <div class="sm1c-test-title">{{ section.settings.heading }}</div>

  {%- assign half_blocks = section.blocks.size | divided_by: 2 -%}
  <div class="sm1c-test-marquee">
    <div class="sm1c-test-row sm1c-test-row--top">
      <div class="sm1c-test-offset">
      <div class="sm1c-test-track">
        {%- for copy in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if forloop.index0 < half_blocks -%}
              {%- render 'sm1c-testimonial-card', block: block, card_bg: section.settings.card_bg, accent_color: section.settings.accent_color -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
      </div>
    </div>
    <div class="sm1c-test-row sm1c-test-row--bottom">
      <div class="sm1c-test-offset">
      <div class="sm1c-test-track">
        {%- for copy in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if forloop.index0 >= half_blocks -%}
              {%- render 'sm1c-testimonial-card', block: block, card_bg: section.settings.card_bg, accent_color: section.settings.accent_color -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SM1C Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "REAL RESULTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "There's a reason women are raving about us."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#fbe4ec"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#E8637E"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar photo (optional — falls back to initial)" },
        { "type": "text", "id": "author", "label": "Author name", "default": "Lauren" },
        { "type": "text", "id": "headline", "label": "Headline (short pink subtitle)", "default": "Finally laughing again" },
        { "type": "text", "id": "rating_text", "label": "Rating text (accessibility label)", "default": "★★★★★ Verified" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "One conversation away from counseling. Now we're laughing again." }
      ]
    },
    {
      "type": "media",
      "name": "Photo/video tile",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (optional — overrides image, plays muted & looped)" },
        { "type": "image_picker", "id": "image", "label": "Image (used if no video, or as video fallback)" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "customer photo" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "SM1C Testimonials",
      "blocks": [
        { "type": "review", "settings": { "author": "Lauren", "headline": "Finally laughing again", "quote": "One conversation away from counseling. Now we're laughing again." } },
        { "type": "review", "settings": { "author": "Tracey", "headline": "Helped through a dry spell", "quote": "So glad I tried these — helped through a dry spell." } },
        { "type": "media", "settings": { "alt": "customer video" } },
        { "type": "review", "settings": { "author": "Lana", "headline": "Noticed real change", "quote": "47 and perimenopausal — noticed a difference in three weeks." } },
        { "type": "media", "settings": { "alt": "customer photo" } },
        { "type": "review", "settings": { "author": "Sienna", "headline": "More energy, more focus", "quote": "Noticed a difference within days — more energy and focus all day." } },
        { "type": "media", "settings": { "alt": "customer photo" } },
        { "type": "review", "settings": { "author": "Janelle", "headline": "Now part of my routine", "quote": "Two kids, no time — three weeks in and it's already part of my routine." } }
      ]
    }
  ]
}
{% endschema %}
