{%- style -%}
#shopify-section-{{ section.id }} .sm1c-test-wrap {
  padding: 60px 44px;
  background: {{ section.settings.bg_color }};
  font-family: 'Inter', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-test-eyebrow {
  text-align: center;
  font-size: 12px;
  font-weight: 700;
  color: {{ section.settings.accent_color }};
  letter-spacing: .05em;
  margin-bottom: 10px;
}
#shopify-section-{{ section.id }} .sm1c-test-title {
  font-family: 'Fraunces', serif;
  font-size: 30px;
  font-weight: 400;
  text-align: center;
  max-width: 560px;
  margin: 0 auto 32px;
}
#shopify-section-{{ section.id }} .sm1c-test-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}
#shopify-section-{{ section.id }} .sm1c-test-card {
  background: {{ section.settings.card_bg }};
  border-radius: 20px;
  padding: 22px;
}
#shopify-section-{{ section.id }} .sm1c-test-author {
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 4px;
}
#shopify-section-{{ section.id }} .sm1c-test-rating {
  font-size: 11px;
  color: {{ section.settings.accent_color }};
  margin-bottom: 10px;
}
#shopify-section-{{ section.id }} .sm1c-test-quote {
  font-size: 13px;
  line-height: 1.5;
}
#shopify-section-{{ section.id }} .sm1c-test-media {
  border-radius: 20px;
  height: 132px;
  background: #ddd;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-test-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
@media (max-width: 989px) {
  #shopify-section-{{ section.id }} .sm1c-test-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 550px) {
  #shopify-section-{{ section.id }} .sm1c-test-grid {
    grid-template-columns: 1fr;
  }
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-test-wrap {
  background: var(--sm1c-bg);
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-test-card {
  background: var(--sm1c-surface);
}
{%- endstyle -%}

<div class="sm1c-test-wrap">
  <div class="sm1c-test-eyebrow">{{ section.settings.eyebrow }}</div>
  <div class="sm1c-test-title">{{ section.settings.heading }}</div>
  <div class="sm1c-test-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' -%}
        <div class="sm1c-test-card" {{ block.shopify_attributes }}>
          <div class="sm1c-test-author">{{ block.settings.author }}</div>
          <div class="sm1c-test-rating">{{ block.settings.rating_text }}</div>
          <div class="sm1c-test-quote">"{{ block.settings.quote }}"</div>
        </div>
      {%- else -%}
        <div class="sm1c-test-media" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.alt }}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "SM1C Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "REAL RESULTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "There's a reason women are raving about us."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f6e6dd"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#E8637E"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "author", "label": "Author name", "default": "Lauren" },
        { "type": "text", "id": "rating_text", "label": "Rating text", "default": "★★★★★ Verified" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "One conversation away from counseling. Now we're laughing again." }
      ]
    },
    {
      "type": "media",
      "name": "Photo/video tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "customer photo" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "SM1C Testimonials",
      "blocks": [
        { "type": "review", "settings": { "author": "Lauren", "quote": "One conversation away from counseling. Now we're laughing again." } },
        { "type": "review", "settings": { "author": "Tracey", "quote": "So glad I tried these — helped through a dry spell." } },
        { "type": "media", "settings": { "alt": "customer video" } },
        { "type": "review", "settings": { "author": "Lana", "quote": "47 and perimenopausal — noticed a difference in three weeks." } },
        { "type": "media", "settings": { "alt": "customer photo" } },
        { "type": "review", "settings": { "author": "Sienna", "quote": "Noticed a difference within days — more energy and focus all day." } },
        { "type": "media", "settings": { "alt": "customer photo" } },
        { "type": "review", "settings": { "author": "Janelle", "quote": "Two kids, no time — three weeks in and it's already part of my routine." } }
      ]
    }
  ]
}
{% endschema %}
