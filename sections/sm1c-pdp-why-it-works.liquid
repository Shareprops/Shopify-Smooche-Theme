{%- style -%}
#shopify-section-{{ section.id }} .sm1c-wiw-wrap {
  padding: 76px clamp(20px, 4vw, 44px);
  background: {{ section.settings.bg_color }};
  font-family: 'Work Sans', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-wiw-grid {
  display: grid;
  grid-template-columns: .92fr 1fr;
  gap: 56px;
  align-items: center;
  max-width: 1180px;
  margin: 0 auto;
}

/* ---------- Image side ---------- */
#shopify-section-{{ section.id }} .sm1c-wiw-media {
  position: relative;
}
#shopify-section-{{ section.id }} .sm1c-wiw-media::before {
  content: '';
  position: absolute;
  inset: -8%;
  background: radial-gradient(circle at 30% 25%, {{ section.settings.accent_color }}33, transparent 60%);
  filter: blur(10px);
  z-index: 0;
  border-radius: 50%;
}
#shopify-section-{{ section.id }} .sm1c-wiw-img {
  position: relative;
  z-index: 1;
  border-radius: 26px;
  overflow: hidden;
  background: #eee;
  min-height: 400px;
  box-shadow: 0 30px 60px -30px rgba(43, 33, 29, .4);
}
#shopify-section-{{ section.id }} .sm1c-wiw-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-wiw-stat-badge {
  position: absolute;
  z-index: 2;
  left: -6%;
  bottom: -8%;
  background: #fff;
  border-radius: 18px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 18px 40px -16px rgba(43, 33, 29, .35);
  max-width: 240px;
}
#shopify-section-{{ section.id }} .sm1c-wiw-stat-ring {
  flex: none;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ED7C93 0%, #E8637E 45%, #D14C67 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 14px -6px rgba(216, 68, 100, .55);
}
#shopify-section-{{ section.id }} .sm1c-wiw-stat-number {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 12.5px;
  font-weight: 700;
  color: #fff;
  letter-spacing: -.02em;
}
#shopify-section-{{ section.id }} .sm1c-wiw-stat-label {
  font-size: 12px;
  font-weight: 600;
  line-height: 1.35;
  color: rgba(58, 46, 39, .75);
}

/* ---------- Content side ---------- */
#shopify-section-{{ section.id }} .sm1c-wiw-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: {{ section.settings.accent_color }}1a;
  color: {{ section.settings.accent_color }};
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  padding: 7px 14px;
  border-radius: 100px;
  margin-bottom: 16px;
}
#shopify-section-{{ section.id }} .sm1c-wiw-eyebrow svg {
  width: 13px;
  height: 13px;
}
#shopify-section-{{ section.id }} .sm1c-wiw-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: clamp(28px, 3.2vw, 38px);
  font-weight: 400;
  line-height: 1.12;
  color: var(--sm1c-ink, #2b211d);
  margin: 0 0 10px;
}
#shopify-section-{{ section.id }} .sm1c-wiw-title span {
  color: {{ section.settings.accent_color }};
}
#shopify-section-{{ section.id }} .sm1c-wiw-sub {
  font-size: 14.5px;
  line-height: 1.6;
  color: rgba(58, 46, 39, .75);
  margin-bottom: 24px;
  max-width: 460px;
}
#shopify-section-{{ section.id }} .sm1c-wiw-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
#shopify-section-{{ section.id }} .sm1c-wiw-item {
  display: flex;
  align-items: center;
  gap: 14px;
  background: #fff;
  border: 1px solid rgba(58, 46, 39, .07);
  border-radius: 14px;
  padding: 13px 16px;
  transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}
#shopify-section-{{ section.id }} .sm1c-wiw-item:hover {
  transform: translateX(3px);
  box-shadow: 0 10px 26px -18px rgba(43, 33, 29, .5);
  border-color: {{ section.settings.accent_color }}55;
}
#shopify-section-{{ section.id }} .sm1c-wiw-item-icon {
  flex: none;
  width: 38px;
  height: 38px;
  border-radius: 11px;
  background: linear-gradient(135deg, #ED7C93 0%, #E8637E 45%, #D14C67 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 14px -6px rgba(216, 68, 100, .55);
}
#shopify-section-{{ section.id }} .sm1c-wiw-item-icon svg {
  width: 18px;
  height: 18px;
}
#shopify-section-{{ section.id }} .sm1c-wiw-item-label {
  font-size: 15px;
  font-weight: 600;
  color: var(--sm1c-ink, #2b211d);
}

/* ---------- Trust chips ---------- */
#shopify-section-{{ section.id }} .sm1c-wiw-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
  max-width: 1180px;
  margin: 48px auto 0;
}
#shopify-section-{{ section.id }} .sm1c-wiw-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  border: 1px solid rgba(58, 46, 39, .08);
  border-radius: 100px;
  padding: 9px 16px 9px 10px;
  box-shadow: 0 2px 8px -4px rgba(43, 33, 29, .12);
}
#shopify-section-{{ section.id }} .sm1c-wiw-chip-icon {
  flex: none;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: {{ section.settings.accent_color }}1f;
  color: {{ section.settings.accent_color }};
  display: flex;
  align-items: center;
  justify-content: center;
}
#shopify-section-{{ section.id }} .sm1c-wiw-chip-icon svg {
  width: 13px;
  height: 13px;
}
#shopify-section-{{ section.id }} .sm1c-wiw-chip-label {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--sm1c-ink, #2b211d);
  white-space: nowrap;
}

@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .sm1c-wiw-grid {
    grid-template-columns: 1fr;
    gap: 60px;
  }
  #shopify-section-{{ section.id }} .sm1c-wiw-img {
    min-height: 300px;
  }
  #shopify-section-{{ section.id }} .sm1c-wiw-stat-badge {
    left: 16px;
    bottom: -28px;
  }
  #shopify-section-{{ section.id }} .sm1c-wiw-sub {
    max-width: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  #shopify-section-{{ section.id }} .sm1c-wiw-item {
    transition: none;
  }
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-wiw-item,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-wiw-chip,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-wiw-stat-badge {
  background: var(--sm1c-surface);
  border-color: var(--sm1c-border);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-wiw-sub {
  color: rgba(240, 237, 232, .65);
}
{%- endstyle -%}

<div class="sm1c-wiw-wrap">
  <div class="sm1c-wiw-grid">
    <div class="sm1c-wiw-media">
      <div class="sm1c-wiw-img">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: '' }}
        {%- endif -%}
      </div>
      {%- if section.settings.stat_label != blank -%}
        <div class="sm1c-wiw-stat-badge">
          <span class="sm1c-wiw-stat-ring">
            <span class="sm1c-wiw-stat-number">{{ section.settings.stat_number }}</span>
          </span>
          <span class="sm1c-wiw-stat-label">{{ section.settings.stat_label }}</span>
        </div>
      {%- endif -%}
    </div>
    <div class="sm1c-wiw-content">
      {%- if section.settings.eyebrow != blank -%}
        <div class="sm1c-wiw-eyebrow">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3.5c.6 3.3 1.8 4.9 5.5 5.5-3.7.6-4.9 2.2-5.5 5.5-.6-3.3-1.8-4.9-5.5-5.5 3.7-.6 4.9-2.2 5.5-5.5Z"/></svg>
          {{ section.settings.eyebrow }}
        </div>
      {%- endif -%}
      <h2 class="sm1c-wiw-title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank %} <span>{{ section.settings.heading_accent }}</span>{% endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <div class="sm1c-wiw-sub">{{ section.settings.subheading }}</div>
      {%- endif -%}
      {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit_item' -%}
      {%- if benefit_blocks.size > 0 -%}
        <div class="sm1c-wiw-list">
          {%- for block in benefit_blocks -%}
            <div class="sm1c-wiw-item" {{ block.shopify_attributes }}>
              <span class="sm1c-wiw-item-icon">{%- render 'sm1c-pdp-icon', icon: block.settings.icon -%}</span>
              <span class="sm1c-wiw-item-label">{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- assign chip_blocks = section.blocks | where: 'type', 'trust_chip' -%}
  {%- if chip_blocks.size > 0 -%}
    <div class="sm1c-wiw-chips">
      {%- for block in chip_blocks -%}
        <div class="sm1c-wiw-chip" {{ block.shopify_attributes }}>
          <span class="sm1c-wiw-chip-icon">{%- render 'sm1c-pdp-icon', icon: block.settings.icon -%}</span>
          <span class="sm1c-wiw-chip-label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "SM1C Why It Works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)", "default": "Backed By Results" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why This Product" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (colored)", "default": "Actually Works" },
    { "type": "textarea", "id": "subheading", "label": "Subheading (optional)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "header", "content": "Floating stat badge (optional)" },
    { "type": "text", "id": "stat_number", "label": "Stat number", "info": "e.g. \"93%\". Use a real number from your own reviews/survey data.", "default": "93%" },
    { "type": "text", "id": "stat_label", "label": "Stat label", "info": "Leave blank to hide the badge entirely.", "default": "felt lightweight, never sticky" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FDF4F1" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#E8637E" }
  ],
  "blocks": [
    {
      "type": "benefit_item",
      "name": "Benefit item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "droplet", "label": "Droplet" },
            { "value": "layers", "label": "Layers" },
            { "value": "trending-up", "label": "Trending up" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "moon", "label": "Moon" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "clock", "label": "Clock" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "droplet"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Deep, lasting hydration" }
      ]
    },
    {
      "type": "trust_chip",
      "name": "Trust chip",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "stethoscope", "label": "Stethoscope (dermatologist tested)" },
            { "value": "layers", "label": "Layers" },
            { "value": "ban", "label": "Ban / free-from" },
            { "value": "flask", "label": "Flask" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "stethoscope"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Dermatologist tested" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "SM1C Why It Works",
      "blocks": [
        { "type": "benefit_item", "settings": { "icon": "droplet", "label": "Deep, lasting hydration" } },
        { "type": "benefit_item", "settings": { "icon": "layers", "label": "Sealed moisture barrier" } },
        { "type": "benefit_item", "settings": { "icon": "trending-up", "label": "Firmer, lifted appearance" } },
        { "type": "benefit_item", "settings": { "icon": "sparkle", "label": "Smoother skin, softer lines" } },
        { "type": "benefit_item", "settings": { "icon": "shield", "label": "Reduced redness and irritation" } },
        { "type": "benefit_item", "settings": { "icon": "moon", "label": "Overnight repair and renewal" } },
        { "type": "trust_chip", "settings": { "icon": "stethoscope", "label": "Dermatologist tested" } },
        { "type": "trust_chip", "settings": { "icon": "layers", "label": "Sensitive skin safe" } },
        { "type": "trust_chip", "settings": { "icon": "ban", "label": "Cruelty-free" } },
        { "type": "trust_chip", "settings": { "icon": "flask", "label": "Paraben-free" } },
        { "type": "trust_chip", "settings": { "icon": "ban", "label": "Sulfate-free" } },
        { "type": "trust_chip", "settings": { "icon": "leaf", "label": "Natural ingredients" } }
      ]
    }
  ]
}
{% endschema %}
