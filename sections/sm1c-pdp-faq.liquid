{%- style -%}
#shopify-section-{{ section.id }} .sm1c-faq-wrap {
  padding: 60px 44px;
  background: oklch(94% 0.03 30);
  font-family: 'Work Sans', sans-serif;
}
#shopify-section-{{ section.id }} .sm1c-faq-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 28px;
  font-weight: 400;
  text-align: center;
  margin-bottom: 32px;
}
#shopify-section-{{ section.id }} .sm1c-faq-title span {
  color: #E8637E;
}
#shopify-section-{{ section.id }} .sm1c-faq-list {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
}
#shopify-section-{{ section.id }} .sm1c-faq-item {
  border-bottom: 1px solid oklch(88% 0.01 30);
}
#shopify-section-{{ section.id }} .sm1c-faq-item:first-child {
  border-top: 1px solid oklch(88% 0.01 30);
}
#shopify-section-{{ section.id }} .sm1c-faq-summary {
  padding: 18px 0;
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  list-style: none;
}
#shopify-section-{{ section.id }} .sm1c-faq-summary::-webkit-details-marker {
  display: none;
}
#shopify-section-{{ section.id }} .sm1c-faq-summary::after {
  content: "+";
  display: inline-block;
  transition: transform .3s ease;
}
#shopify-section-{{ section.id }} .sm1c-faq-item[open] .sm1c-faq-summary::after {
  transform: rotate(135deg);
}
#shopify-section-{{ section.id }} .sm1c-faq-item {
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-faq-body {
  padding: 0 0 18px;
  font-size: 13px;
  line-height: 1.6;
  color: rgba(58, 46, 39, .8);
}
{%- endstyle -%}

<div class="sm1c-faq-wrap">
  <div class="sm1c-faq-title">{{ section.settings.heading }} <span>{{ section.settings.heading_accent }}</span></div>
  <div class="sm1c-faq-list">
    {%- if product.metafields.custom.faq_items.value.size > 0 -%}
      {%- for faq in product.metafields.custom.faq_items.value -%}
        <details class="sm1c-faq-item">
          <summary class="sm1c-faq-summary">{{ faq.question.value }}</summary>
          <div class="sm1c-faq-body">{{ faq.answer.value | newline_to_br }}</div>
        </details>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        <details class="sm1c-faq-item" {{ block.shopify_attributes }}>
          <summary class="sm1c-faq-summary">{{ block.settings.question }}</summary>
          <div class="sm1c-faq-body">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<script>
(function () {
  function Accordion(el) {
    this.el = el;
    this.summary = el.querySelector('.sm1c-faq-summary');
    this.content = el.querySelector('.sm1c-faq-body');
    this.animation = null;
    this.isClosing = false;
    this.isExpanding = false;
    this.summary.addEventListener('click', this.onClick.bind(this));
  }
  Accordion.prototype.onClick = function (e) {
    e.preventDefault();
    this.el.style.overflow = 'hidden';
    if (this.isClosing || !this.el.open) {
      this.open();
    } else if (this.isExpanding || this.el.open) {
      this.shrink();
    }
  };
  Accordion.prototype.shrink = function () {
    this.isClosing = true;
    var startHeight = this.el.offsetHeight + 'px';
    var endHeight = this.summary.offsetHeight + 'px';
    if (this.animation) this.animation.cancel();
    this.animation = this.el.animate(
      { height: [startHeight, endHeight] },
      { duration: 300, easing: 'cubic-bezier(.4, 0, .2, 1)' }
    );
    this.animation.onfinish = this.onAnimationFinish.bind(this, false);
    this.animation.oncancel = function () { this.isClosing = false; }.bind(this);
  };
  Accordion.prototype.open = function () {
    this.el.style.height = this.el.offsetHeight + 'px';
    this.el.open = true;
    window.requestAnimationFrame(this.expand.bind(this));
  };
  Accordion.prototype.expand = function () {
    this.isExpanding = true;
    var startHeight = this.el.offsetHeight + 'px';
    var endHeight = (this.summary.offsetHeight + this.content.offsetHeight) + 'px';
    if (this.animation) this.animation.cancel();
    this.animation = this.el.animate(
      { height: [startHeight, endHeight] },
      { duration: 300, easing: 'cubic-bezier(.4, 0, .2, 1)' }
    );
    this.animation.onfinish = this.onAnimationFinish.bind(this, true);
    this.animation.oncancel = function () { this.isExpanding = false; }.bind(this);
  };
  Accordion.prototype.onAnimationFinish = function (open) {
    this.el.open = open;
    this.animation = null;
    this.isClosing = false;
    this.isExpanding = false;
    this.el.style.height = '';
    this.el.style.overflow = '';
  };

  if (window.Animation && Element.prototype.animate) {
    document.querySelectorAll('.sm1c-faq-item').forEach(function (el) {
      new Accordion(el);
    });
  }
})();
</script>

{% schema %}
{
  "name": "SM1C FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I use this product?" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "SM1C FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How do I use the Lip Plumper?" } },
        { "type": "question", "settings": { "question": "How soon will I see results?" } },
        { "type": "question", "settings": { "question": "Is it safe for sensitive skin?" } },
        { "type": "question", "settings": { "question": "Do you offer a money-back guarantee?" } },
        { "type": "question", "settings": { "question": "Can I subscribe and save?" } }
      ]
    }
  ]
}
{% endschema %}
