}
#shopify-section-{{ section.id }} .sm1c-pdp-main-img {
  position: relative;
  height: 460px;
  border-radius: 24px;
  overflow: hidden;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-btn {
  position: absolute;
  right: 16px;
  bottom: 16px;
