{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign main_image = current_variant.featured_image | default: product.featured_image
  assign title_words = product.title | split: ' '
  assign title_last = title_words | last
  assign title_rest = product.title | remove: title_last | strip
-%}

{%- style -%}
#shopify-section-{{ section.id }} .sm1c-pdp-wrap {
  font-family: 'Work Sans', sans-serif;
  color: oklch(20% 0.02 20);
}
#shopify-section-{{ section.id }} .sm1c-pdp-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 0;
  padding: 48px 44px 20px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-main-img {
  height: 460px;
  border-radius: 24px;
  overflow: hidden;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-pdp-main-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pdp-thumbs {
  display: flex;
  gap: 12px;
  margin-top: 14px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-thumb {
  flex: 1;
  height: 90px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid transparent;
  background: #eee;
  cursor: pointer;
  padding: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-thumb.is-active {
  border-color: oklch(60% 0.16 25);
}
#shopify-section-{{ section.id }} .sm1c-pdp-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pdp-badges {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 28px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-badge {
  text-align: center;
}
#shopify-section-{{ section.id }} .sm1c-pdp-badge-icon {
  font-size: 22px;
  margin-bottom: 6px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-badge-label {
  font-size: 12px;
  font-weight: 600;
  line-height: 1.4;
}
#shopify-section-{{ section.id }} .sm1c-pdp-info {
  padding-left: 48px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-rating {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-rating-stars {
  font-size: 18px;
  letter-spacing: .02em;
  color: oklch(60% 0.16 25);
}
#shopify-section-{{ section.id }} .sm1c-pdp-rating-text {
  font-size: 14px;
  font-weight: 700;
  color: oklch(25% 0.02 20);
}
#shopify-section-{{ section.id }} .sm1c-pdp-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 36px;
  font-weight: 800;
  line-height: 1.15;
  margin: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-title span {
  color: oklch(60% 0.16 25);
}
#shopify-section-{{ section.id }} .sm1c-pdp-desc {
  font-size: 14px;
  color: oklch(40% 0.02 30);
  margin-top: 10px;
  line-height: 1.5;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tag-badge {
  background: oklch(94% 0.03 30);
  color: oklch(35% 0.02 30);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .02em;
  text-transform: uppercase;
  padding: 5px 10px;
  border-radius: 100px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-viewing {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 700;
  color: oklch(45% 0.18 25);
  background: oklch(94% 0.05 25);
  padding: 8px 14px;
  border-radius: 12px;
  margin-top: 14px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-viewing svg {
  width: 15px;
  height: 15px;
  flex: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: #fff;
  border-top: 1px solid oklch(90% 0.01 30);
  box-shadow: 0 -6px 20px rgba(0,0,0,.06);
  transform: translateY(100%);
  transition: transform .25s ease;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc.is-visible {
  transform: translateY(0);
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 12px 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-info {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-img {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  overflow: hidden;
  background: #eee;
  flex: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-title {
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-price {
  font-size: 13px;
  font-weight: 600;
  color: oklch(40% 0.02 30);
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-btn {
  flex: none;
  background: oklch(60% 0.16 25);
  color: #fff;
  border: none;
  padding: 12px 28px;
  border-radius: 100px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  font-family: inherit;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-btn[disabled] {
  opacity: .5;
  cursor: not-allowed;
}
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-inner {
    padding: 10px 20px;
  }
  #shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-title {
    max-width: 120px;
  }
}
#shopify-section-{{ section.id }} .sm1c-pdp-label {
  margin-top: 20px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .04em;
  color: oklch(35% 0.02 30);
}
#shopify-section-{{ section.id }} .sm1c-pdp-divider {
  height: 1px;
  background: oklch(90% 0.01 30);
  margin: 10px 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-offer {
  background: oklch(94% 0.03 30);
  border-radius: 14px;
  padding: 14px 18px;
  font-size: 13px;
  font-weight: 600;
  margin: 16px 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tiers {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier {
  border: 1.5px solid oklch(88% 0.01 30);
  border-radius: 16px;
  padding: 16px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  background: none;
  width: 100%;
  text-align: left;
  font-family: inherit;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier.is-selected {
  border: 2px solid oklch(60% 0.16 25);
  background: oklch(97% 0.02 30);
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier-label {
  font-size: 14px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier-badge {
  background: oklch(60% 0.16 25);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 100px;
  margin-left: 6px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier-note {
  font-size: 12px;
  color: oklch(45% 0.02 30);
  margin-top: 4px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier-price {
  text-align: right;
  font-size: 18px;
  font-weight: 800;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier-compare {
  font-size: 12px;
  text-decoration: line-through;
  color: oklch(60% 0.01 30);
  font-weight: 500;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency {
  background: oklch(94% 0.03 30);
  border-radius: 100px;
  padding: 14px 22px;
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 22px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: oklch(60% 0.16 25);
  flex: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency-text {
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency-text span {
  color: oklch(60% 0.16 25);
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency-track {
  flex: 1;
  height: 8px;
  border-radius: 100px;
  background: rgba(255,255,255,.6);
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency-fill {
  display: block;
  height: 100%;
  border-radius: 100px;
  background: oklch(60% 0.16 25);
}
#shopify-section-{{ section.id }} .sm1c-pdp-atc {
  display: block;
  text-align: center;
  background: oklch(60% 0.16 25);
  color: #fff;
  padding: 18px;
  border-radius: 16px;
  font-size: 15px;
  font-weight: 700;
  margin-top: 16px;
  border: none;
  width: 100%;
  cursor: pointer;
  font-family: inherit;
}
#shopify-section-{{ section.id }} .sm1c-pdp-atc[disabled] {
  opacity: .5;
  cursor: not-allowed;
}
#shopify-section-{{ section.id }} .sm1c-pdp-variant-select {
  width: 100%;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1.5px solid oklch(88% 0.01 30);
  font-size: 13px;
  margin-top: 16px;
  font-family: inherit;
}
#shopify-section-{{ section.id }} .sm1c-pdp-ship-row {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: oklch(40% 0.02 30);
  margin-top: 14px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-social {
  text-align: center;
  margin-top: 26px;
  font-size: 13px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-pdp-media-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10px;
  margin-top: 14px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-media-tile {
  height: 100px;
  border-radius: 12px;
  overflow: hidden;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-pdp-media-tile img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion {
  margin-top: 28px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion details {
  border-top: 1px solid oklch(90% 0.01 30);
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion details:last-child {
  border-bottom: 1px solid oklch(90% 0.01 30);
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion summary {
  padding: 16px 0;
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  list-style: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion summary::-webkit-details-marker {
  display: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion summary::after {
  content: "+";
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion details[open] summary::after {
  content: "\2212";
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion-body {
  padding: 0 0 16px;
  font-size: 13px;
  line-height: 1.6;
  color: oklch(40% 0.02 30);
}
#shopify-section-{{ section.id }} .sm1c-pdp-feedback {
  margin-top: 26px;
  background: oklch(97% 0.015 30);
  border-radius: 18px;
  padding: 22px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-feedback-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 16px;
  font-weight: 800;
  text-align: center;
  margin-bottom: 16px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-fb-label {
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 6px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-fb-track {
  height: 8px;
  border-radius: 100px;
  background: oklch(88% 0.01 30);
  margin-bottom: 16px;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-pdp-fb-track:last-child {
  margin-bottom: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-fb-fill {
  display: block;
  height: 100%;
  border-radius: 100px;
  background: oklch(60% 0.16 25);
}
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .sm1c-pdp-grid {
    grid-template-columns: 1fr;
    padding: 24px 20px;
  }
  #shopify-section-{{ section.id }} .sm1c-pdp-info {
    padding-left: 0;
    margin-top: 32px;
  }
  #shopify-section-{{ section.id }} .sm1c-pdp-media-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-wrap {
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-main-img,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-thumb,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-media-tile,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-img {
  background: var(--sm1c-surface);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-rating-text,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-label {
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-desc,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-ship-row,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-tier-note,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-accordion-body,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-price {
  color: rgba(240, 237, 232, .65);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-tier-compare {
  color: rgba(240, 237, 232, .45);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-tag-badge {
  background: var(--sm1c-surface);
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-viewing,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-offer,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-urgency,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-feedback {
  background: var(--sm1c-surface);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc {
  background: var(--sm1c-surface);
  border-top-color: var(--sm1c-border);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-divider,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-accordion details {
  border-color: var(--sm1c-border);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-tier,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-variant-select {
  border-color: var(--sm1c-border);
  background: var(--sm1c-surface);
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-tier.is-selected {
  background: var(--sm1c-bg);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-fb-track {
  background: rgba(255, 255, 255, .12);
}
{%- endstyle -%}

{{ 'sm1c-viewing-badge.js' | asset_url | script_tag }}

<div class="sm1c-pdp-wrap">
  <div class="sm1c-pdp-grid">
    <div>
      <div class="sm1c-pdp-main-img" data-sm1c-main-img>
        {%- if main_image != blank -%}
          {{ main_image | image_url: width: 900 | image_tag: loading: 'eager', alt: product.title }}
        {%- endif -%}
      </div>
      {%- assign thumb_images = product.images | slice: 0, 4 -%}
      {%- if thumb_images.size > 1 -%}
        <div class="sm1c-pdp-thumbs">
          {%- for image in thumb_images -%}
            <button
              type="button"
              class="sm1c-pdp-thumb{% if forloop.first %} is-active{% endif %}"
              data-sm1c-thumb
              data-full="{{ image | image_url: width: 900 }}"
              aria-label="View image {{ forloop.index }}"
            >
              {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="sm1c-pdp-badges">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
            <div class="sm1c-pdp-badge" {{ block.shopify_attributes }}>
              <div class="sm1c-pdp-badge-icon">{{ block.settings.icon }}</div>
              <div class="sm1c-pdp-badge-label">{{ block.settings.label }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="sm1c-pdp-info">
      <div class="sm1c-pdp-rating">
        <span class="sm1c-pdp-rating-stars">★★★★★</span>
        <span class="sm1c-pdp-rating-text">{{ section.settings.rating_text }}</span>
      </div>
      <h1 class="sm1c-pdp-title">{{ title_rest }} <span>{{ title_last }}</span></h1>
      <div class="sm1c-pdp-desc">{{ product.description | strip_html | truncatewords: 28 }}</div>

      {%- if product.tags.size > 0 -%}
        <div class="sm1c-pdp-tags">
          {%- for tag in product.tags -%}
            <span class="sm1c-pdp-tag-badge">{{ tag }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="sm1c-pdp-viewing" data-sm1c-viewing-badge hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        <span data-sm1c-viewing-count>0</span> people are viewing this product
      </div>

      {%- if section.settings.facts_label != blank -%}
        <div class="sm1c-pdp-label">{{ section.settings.facts_label }}</div>
        <div class="sm1c-pdp-divider"></div>
      {%- endif -%}

      {%- if section.settings.offer_text != blank -%}
        <div class="sm1c-pdp-offer">{{ section.settings.offer_text }}</div>
      {%- endif -%}

      {%- form 'product', product, id: 'sm1c-pdp-form', class: '', data-sm1c-ajax-cart-form: '' -%}
        <div class="sm1c-pdp-tiers">
          {%- assign tier_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tier' -%}
              {%- assign tier_index = tier_index | plus: 1 -%}
              {%- assign tier_total = current_variant.price | times: block.settings.quantity -%}
              <button
                type="button"
                class="sm1c-pdp-tier{% if block.settings.highlighted %} is-selected{% endif %}"
                data-sm1c-tier
                data-quantity="{{ block.settings.quantity }}"
                {{ block.shopify_attributes }}
              >
                <div>
                  <div class="sm1c-pdp-tier-label">
                    {{ block.settings.label }}
                    {%- if block.settings.badge_text != blank -%}
                      <span class="sm1c-pdp-tier-badge">{{ block.settings.badge_text }}</span>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.note_text != blank -%}
                    <div class="sm1c-pdp-tier-note">{{ block.settings.note_text }}</div>
                  {%- endif -%}
                </div>
                <div class="sm1c-pdp-tier-price">
                  <div>{{ tier_total | money }}</div>
                </div>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if product.variants.size > 1 -%}
          <select name="id" class="sm1c-pdp-variant-select" data-sm1c-variant-select>
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }} {% unless variant.available %}- Sold out{% endunless %}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endif -%}

        <input type="hidden" name="quantity" value="1" data-sm1c-quantity>

        {%- if section.settings.urgency_text != blank -%}
          <div class="sm1c-pdp-urgency">
            <span class="sm1c-pdp-urgency-dot"></span>
            <span class="sm1c-pdp-urgency-text">{{ section.settings.urgency_text }} <span>{{ section.settings.urgency_percent }}%</span></span>
            <span class="sm1c-pdp-urgency-track"><span class="sm1c-pdp-urgency-fill" style="width:{{ section.settings.urgency_percent }}%"></span></span>
          </div>
        {%- endif -%}

        <button type="submit" class="sm1c-pdp-atc" data-sm1c-atc-observe {% unless current_variant.available %}disabled{% endunless %}>
          {%- if current_variant.available -%}
            {{ section.settings.atc_label | default: 'ADD TO CART' }}
          {%- else -%}
            Sold out
          {%- endif -%}
        </button>
      {%- endform -%}

      <div class="sm1c-pdp-ship-row">
        <span>{{ section.settings.ship_note_left }}</span>
        <span>{{ section.settings.ship_note_right }}</span>
      </div>

      {%- if section.settings.social_proof_text != blank -%}
        <div class="sm1c-pdp-social">★★★★★ &nbsp;{{ section.settings.social_proof_text }}</div>
      {%- endif -%}

      {%- assign media_blocks = section.blocks | where: 'type', 'media_tile' -%}
      {%- if media_blocks.size > 0 -%}
        <div class="sm1c-pdp-media-grid">
          {%- for block in media_blocks -%}
            <div class="sm1c-pdp-media-tile" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion_item' -%}
      {%- if accordion_blocks.size > 0 -%}
        <div class="sm1c-pdp-accordion">
          {%- for block in accordion_blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div class="sm1c-pdp-accordion-body">{{ block.settings.body }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign feedback_blocks = section.blocks | where: 'type', 'feedback_bar' -%}
      {%- if feedback_blocks.size > 0 -%}
        <div class="sm1c-pdp-feedback">
          {%- if section.settings.feedback_title != blank -%}
            <div class="sm1c-pdp-feedback-title">{{ section.settings.feedback_title }}</div>
          {%- endif -%}
          {%- for block in feedback_blocks -%}
            <div {{ block.shopify_attributes }}>
              <div class="sm1c-pdp-fb-label">{{ block.settings.label }}</div>
              <div class="sm1c-pdp-fb-track"><div class="sm1c-pdp-fb-fill" style="width:{{ block.settings.percent }}%"></div></div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="sm1c-pdp-sticky-atc" data-sm1c-sticky-atc hidden>
    <div class="sm1c-pdp-sticky-atc-inner">
      <div class="sm1c-pdp-sticky-atc-info">
        <div class="sm1c-pdp-sticky-atc-img">
          {%- if main_image != blank -%}
            {{ main_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: product.title }}
          {%- endif -%}
        </div>
        <div>
          <div class="sm1c-pdp-sticky-atc-title">{{ product.title }}</div>
          <div class="sm1c-pdp-sticky-atc-price">{{ current_variant.price | money }}</div>
        </div>
      </div>
      <button
        type="button"
        class="sm1c-pdp-sticky-atc-btn"
        data-sm1c-sticky-atc-btn
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {%- if current_variant.available -%}
          {{ section.settings.atc_label | default: 'ADD TO CART' }}
        {%- else -%}
          Sold out
        {%- endif -%}
      </button>
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.currentScript.closest('.shopify-section') || document;
  var mainImg = root.querySelector('[data-sm1c-main-img]');
  var thumbs = root.querySelectorAll('[data-sm1c-thumb]');
  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      thumb.classList.add('is-active');
      if (mainImg) {
        var img = mainImg.querySelector('img');
        if (img) img.src = thumb.getAttribute('data-full');
      }
    });
  });

  var tiers = root.querySelectorAll('[data-sm1c-tier]');
  var qtyInput = root.querySelector('[data-sm1c-quantity]');
  tiers.forEach(function (tier) {
    tier.addEventListener('click', function () {
      tiers.forEach(function (t) { t.classList.remove('is-selected'); });
      tier.classList.add('is-selected');
      if (qtyInput) qtyInput.value = tier.getAttribute('data-quantity');
    });
  });

  var stickyBar = root.querySelector('[data-sm1c-sticky-atc]');
  var mainAtcButton = root.querySelector('[data-sm1c-atc-observe]');
  var stickyAtcButton = root.querySelector('[data-sm1c-sticky-atc-btn]');
  var pdpForm = document.getElementById('sm1c-pdp-form');

  if (stickyBar && mainAtcButton && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        stickyBar.hidden = !scrolledPast;
        stickyBar.classList.toggle('is-visible', scrolledPast);
      });
    }, { threshold: 0 });
    observer.observe(mainAtcButton);
  }

  if (stickyAtcButton && pdpForm) {
    stickyAtcButton.addEventListener('click', function () {
      if (pdpForm.requestSubmit) {
        pdpForm.requestSubmit();
      } else {
        pdpForm.submit();
      }
    });
  }
})();
</script>

