{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign main_image = current_variant.featured_image | default: product.featured_image
  assign title_words = product.title | split: ' '
  assign title_last = title_words | last
  assign title_rest = product.title | remove: title_last | strip

  assign color_option = null
  for option in product.options_with_values
    assign option_name_downcase = option.name | downcase
    if option_name_downcase contains 'color' or option_name_downcase contains 'colour'
      assign color_option = option
    endif
  endfor
-%}

{%- style -%}
#shopify-section-{{ section.id }} .sm1c-pdp-wrap {
  font-family: 'Inter', sans-serif;
  color: #3A2E27;
}
#shopify-section-{{ section.id }} .sm1c-pdp-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 0;
  padding: 48px 44px 20px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-grid > * {
  min-width: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-main-img {
  position: relative;
  height: 460px;
  border-radius: 24px;
  overflow: hidden;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-btn {
  position: absolute;
  right: 16px;
  bottom: 16px;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, .92);
  color: #3A2E27;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(0, 0, 0, .12);
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-btn:hover {
  background: #fff;
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(10, 10, 10, .92);
  display: flex;
  align-items: center;
  justify-content: center;
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-overlay[hidden] {
  display: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-overlay-close {
  position: absolute;
  top: 20px;
  left: 20px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, .12);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 1;
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-overlay-close:hover {
  background: rgba(255, 255, 255, .22);
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-stage {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-stage img {
  max-height: 100vh;
  width: auto;
  max-width: 100vw;
  object-fit: contain;
  cursor: zoom-in;
  touch-action: none;
  user-select: none;
  transition: transform .15s ease;
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-stage img.is-zoomed {
  cursor: grab;
  transition: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-zoom-stage img.is-panning {
  cursor: grabbing;
}
@media (max-width: 749px) {
  #shopify-section-{{ section.id }} .sm1c-pdp-zoom-overlay-close {
    top: 12px;
    left: 12px;
  }
}
#shopify-section-{{ section.id }} .sm1c-pdp-main-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pdp-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 14px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-thumb {
  flex: 0 0 72px;
  height: 72px;
  border-radius: 12px;
  overflow: hidden;
  border: 2px solid transparent;
  background: #eee;
  cursor: pointer;
  padding: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-option-group {
  margin-top: 18px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-option-label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .02em;
  margin-bottom: 8px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-color-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-color-swatch {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid oklch(88% 0.01 30);
  background: #eee;
  cursor: pointer;
  padding: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-color-swatch img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pdp-color-swatch.is-active {
  border-color: #E8637E;
}
#shopify-section-{{ section.id }} .sm1c-pdp-color-swatch[disabled] {
  opacity: .35;
  cursor: not-allowed;
}
#shopify-section-{{ section.id }} .sm1c-pdp-size-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-size-pill {
  min-width: 44px;
  height: 40px;
  padding: 0 14px;
  border-radius: 10px;
  border: 1.5px solid oklch(88% 0.01 30);
  background: #fff;
  font-size: 13px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
}
#shopify-section-{{ section.id }} .sm1c-pdp-size-pill.is-active {
  border-color: #E8637E;
  background: oklch(97% 0.02 30);
  color: #E8637E;
}
#shopify-section-{{ section.id }} .sm1c-pdp-size-pill[disabled] {
  opacity: .4;
  cursor: not-allowed;
  text-decoration: line-through;
}
#shopify-section-{{ section.id }} .sm1c-pdp-thumb.is-active {
  border-color: #E8637E;
}
#shopify-section-{{ section.id }} .sm1c-pdp-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pdp-badges {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 28px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-badge {
  text-align: center;
}
#shopify-section-{{ section.id }} .sm1c-pdp-badge-icon {
  font-size: 22px;
  margin-bottom: 6px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-badge-label {
  font-size: 12px;
  font-weight: 600;
  line-height: 1.4;
}
#shopify-section-{{ section.id }} .sm1c-pdp-info {
  padding-left: 48px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-rating {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-rating-stars {
  font-size: 18px;
  letter-spacing: .02em;
  color: #E8637E;
}
#shopify-section-{{ section.id }} .sm1c-pdp-rating-text {
  font-size: 14px;
  font-weight: 700;
  color: #3A2E27;
}
#shopify-section-{{ section.id }} .sm1c-pdp-title {
  font-family: 'Fraunces', serif;
  font-size: 36px;
  font-weight: 600;
  line-height: 1.15;
  margin: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-title span {
  color: #E8637E;
}
#shopify-section-{{ section.id }} .sm1c-pdp-desc {
  font-size: 14px;
  color: rgba(58, 46, 39, .8);
  margin-top: 10px;
  line-height: 1.5;
}
#shopify-section-{{ section.id }} .sm1c-pdp-desc-list {
  list-style: none;
  margin: 12px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-desc-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 14px;
  color: rgba(58, 46, 39, .8);
  line-height: 1.5;
}
#shopify-section-{{ section.id }} .sm1c-pdp-desc-check {
  width: 16px;
  height: 16px;
  flex: none;
  margin-top: 3px;
  color: oklch(55% 0.14 150);
}
#shopify-section-{{ section.id }} .sm1c-pdp-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tag-badge {
  background: oklch(94% 0.03 30);
  color: oklch(35% 0.02 30);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .02em;
  text-transform: uppercase;
  padding: 5px 10px;
  border-radius: 100px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-viewing {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 700;
  color: #C13D5B;
  background: #FCE8EC;
  padding: 10px 18px;
  border-radius: 100px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-viewing svg {
  width: 15px;
  height: 15px;
  flex: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-viewing--on-image {
  position: absolute;
  top: 16px;
  right: 16px;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 4px 14px rgba(0, 0, 0, .12);
  white-space: nowrap;
}
@media (max-width: 480px) {
  #shopify-section-{{ section.id }} .sm1c-pdp-viewing--on-image {
    font-size: 11px;
    padding: 8px 12px;
  }
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: #fff;
  border-top: 1px solid oklch(90% 0.01 30);
  box-shadow: 0 -6px 20px rgba(0,0,0,.06);
  transform: translateY(100%);
  transition: transform .25s ease;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc.is-visible {
  transform: translateY(0);
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 12px 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-info {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-img {
  width: 48px;
  height: 48px;
  border-radius: 10px;
  overflow: hidden;
  background: #eee;
  flex: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-title {
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-price {
  font-size: 13px;
  font-weight: 600;
  color: rgba(58, 46, 39, .8);
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-btn {
  flex: none;
  background: #E8637E;
  color: #FBF6EE;
  border: none;
  padding: 12px 28px;
  border-radius: 100px;
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: .03em;
  cursor: pointer;
  font-family: inherit;
}
#shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-btn[disabled] {
  opacity: .5;
  cursor: not-allowed;
}
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-inner {
    padding: 10px 20px;
  }
  #shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-title {
    max-width: 120px;
  }
}
#shopify-section-{{ section.id }} .sm1c-pdp-label {
  margin-top: 20px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .04em;
  color: oklch(35% 0.02 30);
}
#shopify-section-{{ section.id }} .sm1c-pdp-divider {
  height: 1px;
  background: oklch(90% 0.01 30);
  margin: 10px 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-offer {
  background: oklch(94% 0.03 30);
  border-radius: 14px;
  padding: 14px 18px;
  font-size: 13px;
  font-weight: 600;
  margin: 16px 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tiers {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier {
  position: relative;
  border: 1.5px solid oklch(88% 0.01 30);
  border-radius: 16px;
  padding: 16px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  background: none;
  width: 100%;
  text-align: left;
  font-family: inherit;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier.is-selected {
  border: 2px solid #E8637E;
  background: oklch(97% 0.02 30);
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier-label {
  font-size: 14px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier-badge {
  position: absolute;
  top: -10px;
  left: 18px;
  background: #E8637E;
  color: #fff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .02em;
  padding: 4px 10px;
  border-radius: 100px;
  margin-left: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier-note {
  font-size: 12px;
  color: rgba(58, 46, 39, .8);
  margin-top: 4px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier-price {
  text-align: right;
  font-size: 18px;
  font-weight: 800;
}
#shopify-section-{{ section.id }} .sm1c-pdp-tier-compare {
  font-size: 12px;
  text-decoration: line-through;
  color: oklch(60% 0.01 30);
  font-weight: 500;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency {
  background: oklch(94% 0.03 30);
  border-radius: 100px;
  padding: 14px 22px;
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 22px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #E8637E;
  flex: none;
}
@media (prefers-reduced-motion: no-preference) {
  #shopify-section-{{ section.id }} .sm1c-pdp-urgency-dot {
    animation: sm1c-pdp-pulse 1.6s ease-in-out infinite;
  }
}
@keyframes sm1c-pdp-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .35; }
}
#shopify-section-{{ section.id }} .sm1c-pdp-ship-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: oklch(65% 0.16 145);
  margin-right: 5px;
  vertical-align: middle;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency-text {
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency-text span {
  color: #E8637E;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency-track {
  flex: 1;
  height: 8px;
  border-radius: 100px;
  background: rgba(255,255,255,.6);
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-pdp-urgency-fill {
  display: block;
  height: 100%;
  border-radius: 100px;
  background: #E8637E;
}
#shopify-section-{{ section.id }} .sm1c-pdp-atc {
  display: block;
  text-align: center;
  background: #E8637E;
  color: #FBF6EE;
  padding: 18px;
  border-radius: 16px;
  font-family: 'Inter', sans-serif;
  font-size: 15px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: .03em;
  margin-top: 16px;
  border: none;
  width: 100%;
  cursor: pointer;
  font-family: inherit;
}
#shopify-section-{{ section.id }} .sm1c-pdp-atc[disabled] {
  opacity: .5;
  cursor: not-allowed;
}
#shopify-section-{{ section.id }} .sm1c-pdp-variant-select {
  width: 100%;
  padding: 12px 14px;
  border-radius: 12px;
  border: 1.5px solid oklch(88% 0.01 30);
  font-size: 13px;
  margin-top: 16px;
  font-family: inherit;
}
#shopify-section-{{ section.id }} .sm1c-pdp-ship-row {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: rgba(58, 46, 39, .8);
  margin-top: 14px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-social {
  text-align: center;
  margin-top: 26px;
  font-size: 13px;
  font-weight: 700;
}
#shopify-section-{{ section.id }} .sm1c-pdp-reel-row {
  display: flex;
  gap: 10px;
  margin-top: 16px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-reel-row::-webkit-scrollbar {
  display: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-reel {
  flex: 0 0 auto;
  width: 160px;
  aspect-ratio: 9 / 16;
  border-radius: 16px;
  overflow: hidden;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-pdp-reel video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  pointer-events: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-media-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10px;
  margin-top: 14px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-media-tile {
  height: 100px;
  border-radius: 12px;
  overflow: hidden;
  background: #eee;
}
#shopify-section-{{ section.id }} .sm1c-pdp-media-tile img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion {
  margin-top: 28px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion details {
  border-top: 1px solid oklch(90% 0.01 30);
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion details:last-child {
  border-bottom: 1px solid oklch(90% 0.01 30);
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion summary {
  padding: 16px 0;
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  list-style: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion summary::-webkit-details-marker {
  display: none;
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion summary::after {
  content: "+";
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion details[open] summary::after {
  content: "\2212";
}
#shopify-section-{{ section.id }} .sm1c-pdp-accordion-body {
  padding: 0 0 16px;
  font-size: 13px;
  line-height: 1.6;
  color: rgba(58, 46, 39, .8);
}
#shopify-section-{{ section.id }} .sm1c-pdp-feedback {
  margin-top: 26px;
  background: oklch(97% 0.015 30);
  border-radius: 18px;
  padding: 22px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-feedback-title {
  font-family: 'Fraunces', serif;
  font-size: 16px;
  font-weight: 400;
  text-align: center;
  margin-bottom: 16px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-fb-label {
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 6px;
}
#shopify-section-{{ section.id }} .sm1c-pdp-fb-track {
  height: 8px;
  border-radius: 100px;
  background: oklch(88% 0.01 30);
  margin-bottom: 16px;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .sm1c-pdp-fb-track:last-child {
  margin-bottom: 0;
}
#shopify-section-{{ section.id }} .sm1c-pdp-fb-fill {
  display: block;
  height: 100%;
  border-radius: 100px;
  background: #E8637E;
}
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .sm1c-pdp-grid {
    grid-template-columns: 1fr;
    padding: 24px 20px;
  }
  #shopify-section-{{ section.id }} .sm1c-pdp-info {
    padding-left: 0;
    margin-top: 32px;
  }
  #shopify-section-{{ section.id }} .sm1c-pdp-media-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  #shopify-section-{{ section.id }} .sm1c-pdp-thumbs {
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
    padding-bottom: 2px;
  }
  #shopify-section-{{ section.id }} .sm1c-pdp-thumbs::-webkit-scrollbar {
    display: none;
  }
  #shopify-section-{{ section.id }} .sm1c-pdp-thumb {
    flex: 0 0 80px;
    height: 80px;
    scroll-snap-align: start;
  }
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-wrap {
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-main-img,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-thumb,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-media-tile,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-img {
  background: var(--sm1c-surface);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-rating-text,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-label {
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-desc,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-desc-list li,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-ship-row,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-tier-note,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-accordion-body,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc-price {
  color: rgba(240, 237, 232, .65);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-tier-compare {
  color: rgba(240, 237, 232, .45);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-tag-badge {
  background: var(--sm1c-surface);
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-viewing,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-offer,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-urgency,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-feedback {
  background: var(--sm1c-surface);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-sticky-atc {
  background: var(--sm1c-surface);
  border-top-color: var(--sm1c-border);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-divider,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-accordion details {
  border-color: var(--sm1c-border);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-tier,
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-variant-select {
  border-color: var(--sm1c-border);
  background: var(--sm1c-surface);
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-tier.is-selected {
  background: var(--sm1c-bg);
}
:root[data-sm1c-theme='dark'] #shopify-section-{{ section.id }} .sm1c-pdp-fb-track {
  background: rgba(255, 255, 255, .12);
}
{%- endstyle -%}

{{ 'sm1c-viewing-badge.js' | asset_url | script_tag }}

<div class="sm1c-pdp-wrap">
  <div class="sm1c-pdp-grid">
    <div>
      <div class="sm1c-pdp-main-img" data-sm1c-main-img>
        {%- if main_image != blank -%}
          {{ main_image | image_url: width: 900 | image_tag: loading: 'eager', alt: product.title, srcset: nil }}
        {%- endif -%}
        <div class="sm1c-pdp-viewing sm1c-pdp-viewing--on-image" data-sm1c-viewing-badge hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          <span data-sm1c-viewing-count>0</span> viewing now
        </div>
        <button
          type="button"
          class="sm1c-pdp-zoom-btn"
          data-sm1c-zoom-btn
          aria-label="Zoom image"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </div>
      {%- liquid
        assign thumb_images = product.images
        if main_image
          assign sorted_thumb_images = '' | split: ''
          assign sorted_thumb_images = sorted_thumb_images | concat: product.images | where: 'id', main_image.id
          for image in product.images
            unless image.id == main_image.id
              assign remaining_image = product.images | where: 'id', image.id
              assign sorted_thumb_images = sorted_thumb_images | concat: remaining_image
            endunless
          endfor
          assign thumb_images = sorted_thumb_images
        endif
      -%}
      {%- if thumb_images.size > 1 -%}
        <div class="sm1c-pdp-thumbs">
          {%- for image in thumb_images -%}
            <button
              type="button"
              class="sm1c-pdp-thumb{% if image.id == main_image.id %} is-active{% endif %}"
              data-sm1c-thumb
              data-full="{{ image | image_url: width: 900 }}"
              aria-label="View image {{ forloop.index }}"
            >
              {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="sm1c-pdp-badges">
        {%- if product.metafields.custom.trust_badges.value.size > 0 -%}
          {%- for badge in product.metafields.custom.trust_badges.value -%}
            <div class="sm1c-pdp-badge">
              <div class="sm1c-pdp-badge-icon">{{ badge.icon.value }}</div>
              <div class="sm1c-pdp-badge-label">{{ badge.label.value }}</div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              <div class="sm1c-pdp-badge" {{ block.shopify_attributes }}>
                <div class="sm1c-pdp-badge-icon">{{ block.settings.icon }}</div>
                <div class="sm1c-pdp-badge-label">{{ block.settings.label }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="sm1c-pdp-info">
      {%- liquid
        assign pdp_review_count = product.metafields.custom.review_count.value | default: section.settings.rating_text
      -%}
      <div class="sm1c-pdp-rating">
        <span class="sm1c-pdp-rating-stars">★★★★★</span>
        <span class="sm1c-pdp-rating-text">{{ pdp_review_count }}</span>
      </div>
      <h1 class="sm1c-pdp-title">{{ title_rest }} <span>{{ title_last }}</span></h1>
      {%- liquid
        assign desc_stripped = product.description | strip_html
        assign desc_parts = desc_stripped | split: '✅'
        assign desc_bullet_count = 0
        for part in desc_parts
          assign part_trimmed = part | strip
          unless part_trimmed == blank
            assign desc_bullet_count = desc_bullet_count | plus: 1
          endunless
        endfor
      -%}
      {%- if desc_bullet_count > 1 -%}
        <ul class="sm1c-pdp-desc-list">
          {%- for part in desc_parts limit: 4 -%}
            {%- assign part_trimmed = part | strip -%}
            {%- unless part_trimmed == blank -%}
              <li>
                <svg class="sm1c-pdp-desc-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>{{ part_trimmed | truncatewords: 24 }}</span>
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="sm1c-pdp-desc">{{ desc_stripped | truncatewords: 28 }}</div>
      {%- endif -%}

      {%- if product.tags.size > 0 -%}
        <div class="sm1c-pdp-tags">
          {%- for tag in product.tags -%}
            <span class="sm1c-pdp-tag-badge">{{ tag }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.facts_label != blank -%}
        <div class="sm1c-pdp-label">{{ section.settings.facts_label }}</div>
        <div class="sm1c-pdp-divider"></div>
      {%- endif -%}

      {%- if section.settings.offer_text != blank -%}
        <div class="sm1c-pdp-offer">{{ section.settings.offer_text }}</div>
      {%- endif -%}

      {%- form 'product', product, id: 'sm1c-pdp-form', class: '', data-sm1c-ajax-cart-form: '', data-currency: shop.currency -%}
        <div class="sm1c-pdp-tiers">
          {%- assign tier_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tier' -%}
              {%- assign tier_index = tier_index | plus: 1 -%}
              {%- assign tier_total = current_variant.price | times: block.settings.quantity -%}
              <button
                type="button"
                class="sm1c-pdp-tier{% if block.settings.highlighted %} is-selected{% endif %}"
                data-sm1c-tier
                data-quantity="{{ block.settings.quantity }}"
                {{ block.shopify_attributes }}
              >
                <div>
                  <div class="sm1c-pdp-tier-label">
                    {{ block.settings.label }}
                    {%- if block.settings.badge_text != blank -%}
                      <span class="sm1c-pdp-tier-badge">{{ block.settings.badge_text }}</span>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.note_text != blank -%}
                    <div class="sm1c-pdp-tier-note">{{ block.settings.note_text }}</div>
                  {%- endif -%}
                </div>
                <div class="sm1c-pdp-tier-price">
                  <div data-sm1c-tier-price>{{ tier_total | money }}</div>
                </div>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if color_option -%}
          <div class="sm1c-pdp-option-group">
            <label class="sm1c-pdp-option-label">
              {{ color_option.name }}: <span data-sm1c-color-name>{{ color_option.selected_value }}</span>
            </label>
            <div class="sm1c-pdp-color-swatches" data-sm1c-color-swatches data-option-position="{{ color_option.position }}">
              {%- capture color_option_key -%}option{{ color_option.position }}{%- endcapture -%}
              {%- for value in color_option.values -%}
                {%- assign swatch_image = null -%}
                {%- for variant in product.variants -%}
                  {%- if variant[color_option_key] == value -%}
                    {%- assign swatch_image = variant.featured_image | default: product.featured_image -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                <button
                  type="button"
                  class="sm1c-pdp-color-swatch{% if color_option.selected_value == value %} is-active{% endif %}"
                  data-sm1c-color-swatch
                  data-value="{{ value | escape }}"
                  aria-label="{{ value | escape }}"
                  title="{{ value | escape }}"
                >
                  {%- if swatch_image -%}
                    {{ swatch_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: value }}
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- for option in product.options_with_values -%}
          {%- assign is_placeholder_option = false -%}
          {%- if option.values.size == 1 -%}
            {%- assign single_value_downcase = option.values.first | strip | downcase -%}
            {%- if single_value_downcase == blank
              or single_value_downcase == 'n/a'
              or single_value_downcase == 'default title'
              or single_value_downcase == 'default'
            -%}
              {%- assign is_placeholder_option = true -%}
            {%- endif -%}
          {%- endif -%}
          {%- assign skip_option = is_placeholder_option -%}
          {%- if color_option and option.position == color_option.position -%}
            {%- assign skip_option = true -%}
          {%- endif -%}
          {%- unless skip_option -%}
            <div class="sm1c-pdp-option-group">
              <label class="sm1c-pdp-option-label">
                {{ option.name }}: <span data-sm1c-option-name>{{ option.selected_value }}</span>
              </label>
              <div class="sm1c-pdp-size-pills" data-sm1c-option-pills data-option-position="{{ option.position }}">
                {%- capture option_key -%}option{{ option.position }}{%- endcapture -%}
                {%- for value in option.values -%}
                  {%- assign value_available = false -%}
                  {%- for variant in product.variants -%}
                    {%- assign matches_color = true -%}
                    {%- if color_option -%}
                      {%- assign matches_color = false -%}
                      {%- if variant[color_option_key] == color_option.selected_value -%}
                        {%- assign matches_color = true -%}
                      {%- endif -%}
                    {%- endif -%}
                    {%- if variant[option_key] == value and variant.available and matches_color -%}
                      {%- assign value_available = true -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <button
                    type="button"
                    class="sm1c-pdp-size-pill{% if option.selected_value == value %} is-active{% endif %}"
                    data-sm1c-option-pill
                    data-value="{{ value | escape }}"
                    {% unless value_available %}disabled{% endunless %}
                  >
                    {{ value }}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endunless -%}
        {%- endfor -%}

        <input type="hidden" name="id" value="{{ current_variant.id }}" data-sm1c-variant-id>
        <script type="application/json" data-sm1c-variants-json>
          {{ product.variants | json }}
        </script>

        <input type="hidden" name="quantity" value="1" data-sm1c-quantity>

        {%- if section.settings.urgency_text != blank -%}
          <div class="sm1c-pdp-urgency">
            <span class="sm1c-pdp-urgency-dot"></span>
            <span class="sm1c-pdp-urgency-text">{{ section.settings.urgency_text }} <span>{{ section.settings.urgency_percent }}%</span></span>
            <span class="sm1c-pdp-urgency-track"><span class="sm1c-pdp-urgency-fill" style="width:{{ section.settings.urgency_percent }}%"></span></span>
          </div>
        {%- endif -%}

        <button type="submit" class="sm1c-pdp-atc" data-sm1c-atc-observe {% unless current_variant.available %}disabled{% endunless %}>
          <span data-sm1c-atc-label>
            {%- if current_variant.available -%}
              {{ section.settings.atc_label | default: 'ADD TO CART' }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </span>
        </button>
      {%- endform -%}

      {%- liquid
        assign ship_note_left_clean = section.settings.ship_note_left | replace_first: '● ', '' | replace_first: '●', ''
      -%}
      <div class="sm1c-pdp-ship-row">
        <span><span class="sm1c-pdp-ship-dot"></span>{{ ship_note_left_clean }}</span>
        <span>{{ section.settings.ship_note_right }}</span>
      </div>

      {%- if section.settings.social_proof_text != blank -%}
        <div class="sm1c-pdp-social">★★★★★ &nbsp;{{ section.settings.social_proof_text }}</div>
      {%- endif -%}

      {%- assign demo_videos = product.metafields.custom.product_demos.value -%}
      {%- if demo_videos.size > 0 or section.settings.reel_video != null -%}
        <div class="sm1c-pdp-reel-row">
          {%- if demo_videos.size > 0 -%}
            {%- for demo in demo_videos -%}
              {%- if demo.media_type == 'video' -%}
                <div class="sm1c-pdp-reel">
                  {{-
                    demo
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      preload: 'metadata',
                      image_size: '400x'
                  -}}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <div class="sm1c-pdp-reel">
              {{-
                section.settings.reel_video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  preload: 'metadata',
                  image_size: '400x'
              -}}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- liquid
        assign media_blocks = section.blocks | where: 'type', 'media_tile'
        assign has_media_image = false
        for block in media_blocks
          if block.settings.image != blank
            assign has_media_image = true
          endif
        endfor
      -%}
      {%- if has_media_image -%}
        <div class="sm1c-pdp-media-grid">
          {%- for block in media_blocks -%}
            {%- if block.settings.image != blank -%}
              <div class="sm1c-pdp-media-tile" {{ block.shopify_attributes }}>
                {{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion_item' -%}
      {%- if accordion_blocks.size > 0 -%}
        <div class="sm1c-pdp-accordion">
          {%- for block in accordion_blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div class="sm1c-pdp-accordion-body">{{ block.settings.body }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign feedback_bars_mf = product.metafields.custom.feedback_bars.value -%}
      {%- assign feedback_blocks = section.blocks | where: 'type', 'feedback_bar' -%}
      {%- if feedback_bars_mf.size > 0 or feedback_blocks.size > 0 -%}
        <div class="sm1c-pdp-feedback">
          {%- if section.settings.feedback_title != blank -%}
            <div class="sm1c-pdp-feedback-title">{{ section.settings.feedback_title }}</div>
          {%- endif -%}
          {%- if feedback_bars_mf.size > 0 -%}
            {%- for bar in feedback_bars_mf -%}
              <div>
                <div class="sm1c-pdp-fb-label">{{ bar.label.value }}</div>
                <div class="sm1c-pdp-fb-track"><div class="sm1c-pdp-fb-fill" style="width:{{ bar.percent.value }}%"></div></div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for block in feedback_blocks -%}
              <div {{ block.shopify_attributes }}>
                <div class="sm1c-pdp-fb-label">{{ block.settings.label }}</div>
                <div class="sm1c-pdp-fb-track"><div class="sm1c-pdp-fb-fill" style="width:{{ block.settings.percent }}%"></div></div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="sm1c-pdp-sticky-atc" data-sm1c-sticky-atc hidden>
    <div class="sm1c-pdp-sticky-atc-inner">
      <div class="sm1c-pdp-sticky-atc-info">
        <div class="sm1c-pdp-sticky-atc-img">
          {%- if main_image != blank -%}
            {{ main_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: product.title }}
          {%- endif -%}
        </div>
        <div>
          <div class="sm1c-pdp-sticky-atc-title">{{ product.title }}</div>
          <div class="sm1c-pdp-sticky-atc-price" data-sm1c-sticky-price>{{ current_variant.price | money }}</div>
        </div>
      </div>
      <button
        type="button"
        class="sm1c-pdp-sticky-atc-btn"
        data-sm1c-sticky-atc-btn
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span data-sm1c-sticky-atc-label>
          {%- if current_variant.available -%}
            {{ section.settings.atc_label | default: 'ADD TO CART' }}
          {%- else -%}
            Sold out
          {%- endif -%}
        </span>
      </button>
    </div>
  </div>

  <div class="sm1c-pdp-zoom-overlay" data-sm1c-zoom-overlay hidden>
    <button type="button" class="sm1c-pdp-zoom-overlay-close" data-sm1c-zoom-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="26" height="26">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="sm1c-pdp-zoom-stage" data-sm1c-zoom-stage>
      <img data-sm1c-zoom-image src="" alt="" draggable="false">
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.currentScript.closest('.shopify-section') || document;
  var mainImg = root.querySelector('[data-sm1c-main-img]');
  var thumbs = root.querySelectorAll('[data-sm1c-thumb]');

  function setMainImage(url) {
    if (!mainImg || !url) return;
    var img = mainImg.querySelector('img');
    if (!img) return;
    // A srcset (auto-added by Shopify's image_tag) takes priority over `src` for the
    // browser's image selection, so a plain `img.src = url` silently no-ops unless
    // srcset is cleared first.
    img.removeAttribute('srcset');
    img.removeAttribute('sizes');
    img.src = url;
  }

  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () {
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      thumb.classList.add('is-active');
      setMainImage(thumb.getAttribute('data-full'));
    });
  });

  var tiers = root.querySelectorAll('[data-sm1c-tier]');
  var qtyInput = root.querySelector('[data-sm1c-quantity]');
  tiers.forEach(function (tier) {
    tier.addEventListener('click', function () {
      tiers.forEach(function (t) { t.classList.remove('is-selected'); });
      tier.classList.add('is-selected');
      if (qtyInput) qtyInput.value = tier.getAttribute('data-quantity');
      updateTierPrices();
    });
  });

  var variantsJson = root.querySelector('[data-sm1c-variants-json]');
  var variants = variantsJson ? JSON.parse(variantsJson.textContent) : [];
  var variantIdInput = root.querySelector('[data-sm1c-variant-id]');
  var colorSwatchesWrap = root.querySelector('[data-sm1c-color-swatches]');
  var colorNameLabel = root.querySelector('[data-sm1c-color-name]');
  var optionGroups = root.querySelectorAll('[data-option-position]');
  var pdpFormEl = root.querySelector('#sm1c-pdp-form') || document.getElementById('sm1c-pdp-form');
  var currencyCode = (pdpFormEl && pdpFormEl.getAttribute('data-currency')) || 'USD';

  var moneyFormatter = null;
  try {
    moneyFormatter = new Intl.NumberFormat(undefined, { style: 'currency', currency: currencyCode });
  } catch (e) {
    moneyFormatter = null;
  }

  function formatMoney(amount) {
    if (moneyFormatter) return moneyFormatter.format(amount);
    return '$' + amount.toFixed(2);
  }

  function optionValueButtons(group) {
    return group.querySelectorAll('[data-sm1c-color-swatch], [data-sm1c-option-pill]');
  }

  function getSelectedOptions() {
    var selected = {};
    optionGroups.forEach(function (group) {
      var active = group.querySelector('.is-active');
      if (active) selected[group.getAttribute('data-option-position')] = active.getAttribute('data-value');
    });
    return selected;
  }

  function recomputeAvailability() {
    var selected = getSelectedOptions();
    optionGroups.forEach(function (group) {
      var position = group.getAttribute('data-option-position');
      var otherSelected = Object.assign({}, selected);
      delete otherSelected[position];

      optionValueButtons(group).forEach(function (button) {
        var value = button.getAttribute('data-value');
        var candidate = Object.assign({}, otherSelected);
        candidate[position] = value;
        var available = variants.some(function (variant) {
          return variant.available && Object.keys(candidate).every(function (pos) {
            return variant['option' + pos] === candidate[pos];
          });
        });
        button.disabled = !available;
        if (!available) button.classList.remove('is-active');
      });

      if (!group.querySelector('.is-active')) {
        var firstEnabled = Array.prototype.find.call(optionValueButtons(group), function (b) { return !b.disabled; });
        if (firstEnabled) firstEnabled.classList.add('is-active');
      }
    });
  }

  function findMatchingVariant(selected) {
    return variants.find(function (variant) {
      return Object.keys(selected).every(function (position) {
        return variant['option' + position] === selected[position];
      });
    });
  }

  function updateTierPrices() {
    var variant = findMatchingVariant(getSelectedOptions());
    if (!variant) return;
    tiers.forEach(function (tier) {
      var priceEl = tier.querySelector('[data-sm1c-tier-price]');
      var quantity = parseInt(tier.getAttribute('data-quantity'), 10) || 1;
      if (priceEl) priceEl.textContent = formatMoney((variant.price / 100) * quantity);
    });
  }

  function applyVariant(variant) {
    if (!variant) return;

    if (variantIdInput) variantIdInput.value = variant.id;

    if (variant.featured_image && variant.featured_image.src) {
      setMainImage(variant.featured_image.src);
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
    }

    updateTierPrices();

    var stickyPrice = root.querySelector('[data-sm1c-sticky-price]');
    if (stickyPrice) stickyPrice.textContent = formatMoney(variant.price / 100);

    [
      { button: mainAtcButtonEl(), label: root.querySelector('[data-sm1c-atc-label]') },
      { button: root.querySelector('[data-sm1c-sticky-atc-btn]'), label: root.querySelector('[data-sm1c-sticky-atc-label]') },
    ].forEach(function (pair) {
      if (!pair.button) return;
      pair.button.disabled = !variant.available;
      if (pair.label) pair.label.textContent = variant.available ? (pair.label.getAttribute('data-default-label') || pair.label.textContent) : 'Sold out';
    });
  }

  function mainAtcButtonEl() {
    return root.querySelector('[data-sm1c-atc-observe]');
  }

  // Preserve each button's original "available" label so re-selecting an available variant restores it.
  root.querySelectorAll('[data-sm1c-atc-label], [data-sm1c-sticky-atc-label]').forEach(function (label) {
    if (!label.hasAttribute('data-default-label') && label.textContent.trim().toLowerCase() !== 'sold out') {
      label.setAttribute('data-default-label', label.textContent.trim());
    }
  });

  optionGroups.forEach(function (group) {
    var nameLabel = group === colorSwatchesWrap ? colorNameLabel : group.parentElement.querySelector('[data-sm1c-option-name]');

    optionValueButtons(group).forEach(function (button) {
      button.addEventListener('click', function () {
        if (button.disabled) return;

        optionValueButtons(group).forEach(function (b) { b.classList.remove('is-active'); });
        button.classList.add('is-active');
        if (nameLabel) nameLabel.textContent = button.getAttribute('data-value');

        recomputeAvailability();
        applyVariant(findMatchingVariant(getSelectedOptions()));
      });
    });
  });

  recomputeAvailability();

  var stickyBar = root.querySelector('[data-sm1c-sticky-atc]');
  var mainAtcButton = root.querySelector('[data-sm1c-atc-observe]');
  var stickyAtcButton = root.querySelector('[data-sm1c-sticky-atc-btn]');
  var pdpForm = document.getElementById('sm1c-pdp-form');

  if (stickyBar && mainAtcButton && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        stickyBar.hidden = !scrolledPast;
        stickyBar.classList.toggle('is-visible', scrolledPast);
      });
    }, { threshold: 0 });
    observer.observe(mainAtcButton);
  }

  if (stickyAtcButton && pdpForm) {
    stickyAtcButton.addEventListener('click', function () {
      if (pdpForm.requestSubmit) {
        pdpForm.requestSubmit();
      } else {
        pdpForm.submit();
      }
    });
  }

  var zoomBtn = root.querySelector('[data-sm1c-zoom-btn]');
  var zoomOverlay = root.querySelector('[data-sm1c-zoom-overlay]');
  var zoomCloseBtn = root.querySelector('[data-sm1c-zoom-close]');
  var zoomStage = root.querySelector('[data-sm1c-zoom-stage]');
  var zoomImage = root.querySelector('[data-sm1c-zoom-image]');

  if (zoomBtn && zoomOverlay && zoomImage) {
    var zoomScale = 1;
    var zoomPanX = 0;
    var zoomPanY = 0;
    var isPanning = false;
    var panStartX = 0;
    var panStartY = 0;

    function setZoomTransform() {
      zoomImage.style.transform = 'translate(' + zoomPanX + 'px, ' + zoomPanY + 'px) scale(' + zoomScale + ')';
    }

    function resetZoom() {
      zoomScale = 1;
      zoomPanX = 0;
      zoomPanY = 0;
      isPanning = false;
      zoomImage.classList.remove('is-zoomed', 'is-panning');
      setZoomTransform();
    }

    function openZoom() {
      var mainImgEl = mainImg && mainImg.querySelector('img');
      if (!mainImgEl || !mainImgEl.src) return;
      zoomImage.src = mainImgEl.src;
      zoomImage.alt = mainImgEl.alt || '';
      resetZoom();
      zoomOverlay.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeZoom() {
      zoomOverlay.hidden = true;
      document.body.style.overflow = '';
      resetZoom();
    }

    zoomBtn.addEventListener('click', openZoom);
    zoomCloseBtn.addEventListener('click', closeZoom);

    zoomOverlay.addEventListener('click', function (event) {
      if (event.target === zoomOverlay || event.target === zoomStage) closeZoom();
    });

    document.addEventListener('keydown', function (event) {
      if (!zoomOverlay.hidden && event.key === 'Escape') closeZoom();
    });

    zoomImage.addEventListener('click', function (event) {
      event.stopPropagation();
      if (zoomScale === 1) {
        zoomScale = 2;
        zoomImage.classList.add('is-zoomed');
      } else {
        resetZoom();
      }
      setZoomTransform();
    });

    zoomStage.addEventListener('wheel', function (event) {
      event.preventDefault();
      var next = zoomScale - event.deltaY * 0.0015;
      zoomScale = Math.min(4, Math.max(1, next));
      zoomImage.classList.toggle('is-zoomed', zoomScale > 1);
      if (zoomScale === 1) {
        zoomPanX = 0;
        zoomPanY = 0;
      }
      setZoomTransform();
    }, { passive: false });

    zoomImage.addEventListener('pointerdown', function (event) {
      if (zoomScale === 1) return;
      isPanning = true;
      panStartX = event.clientX - zoomPanX;
      panStartY = event.clientY - zoomPanY;
      zoomImage.classList.add('is-panning');
      zoomImage.setPointerCapture(event.pointerId);
    });

    zoomImage.addEventListener('pointermove', function (event) {
      if (!isPanning) return;
      zoomPanX = event.clientX - panStartX;
      zoomPanY = event.clientY - panStartY;
      setZoomTransform();
    });

    ['pointerup', 'pointercancel'].forEach(function (eventName) {
      zoomImage.addEventListener(eventName, function () {
        isPanning = false;
        zoomImage.classList.remove('is-panning');
      });
    });
  }
})();
</script>

