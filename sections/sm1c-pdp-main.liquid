{{ 'sm1c-viewing-badge.js' | asset_url | script_tag }}

<div class="sm1c-pdp-wrap">
  <div class="sm1c-pdp-grid">
    <div>
      <div class="sm1c-pdp-main-img" data-sm1c-main-img>
        {%- if main_image != blank -%}
          {{ main_image | image_url: width: 900 | image_tag: loading: 'eager', alt: product.title, srcset: nil }}
        {%- endif -%}
        <div class="sm1c-pdp-viewing sm1c-pdp-viewing--on-image" data-sm1c-viewing-badge hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          <span data-sm1c-viewing-count>0</span> viewing now
        </div>
        <button
          type="button"
          class="sm1c-pdp-zoom-btn"
          data-sm1c-zoom-btn
          aria-label="Zoom image"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </div>
      {%- liquid
        assign thumb_images = product.images
        if main_image
          assign sorted_thumb_images = '' | split: ''
          assign sorted_thumb_images = sorted_thumb_images | concat: product.images | where: 'id', main_image.id
          for image in product.images
            unless image.id == main_image.id
              assign remaining_image = product.images | where: 'id', image.id
              assign sorted_thumb_images = sorted_thumb_images | concat: remaining_image
            endunless
          endfor
          assign thumb_images = sorted_thumb_images
        endif
      -%}
      <div class="sm1c-pdp-mobile-gallery" data-sm1c-mobile-gallery>
        <div class="sm1c-pdp-mobile-track" data-sm1c-mobile-track>
          {%- for image in thumb_images -%}
            <div
              class="sm1c-pdp-mobile-slide"
              data-sm1c-mobile-slide
              data-full="{{ image | image_url: width: 1200 }}"
            >
              {{ image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
            </div>
          {%- else -%}
            <div class="sm1c-pdp-mobile-slide" data-sm1c-mobile-slide data-full="{{ main_image | image_url: width: 1200 }}">
              {%- if main_image != blank -%}
                {{ main_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <div class="sm1c-pdp-viewing sm1c-pdp-viewing--on-image" data-sm1c-viewing-badge hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          <span data-sm1c-viewing-count>0</span> viewing now
        </div>
      </div>
      {%- if thumb_images.size > 1 -%}
        <div class="sm1c-pdp-thumbs">
          {%- for image in thumb_images -%}
            <button
              type="button"
              class="sm1c-pdp-thumb{% if image.id == main_image.id %} is-active{% endif %}"
              data-sm1c-thumb
              data-full="{{ image | image_url: width: 900 }}"
              aria-label="View image {{ forloop.index }}"
            >
              {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="sm1c-pdp-badges">
        {%- if product.metafields.custom.trust_badges.value.size > 0 -%}
          {%- for badge in product.metafields.custom.trust_badges.value -%}
            <div class="sm1c-pdp-badge">
              <div class="sm1c-pdp-badge-icon">{{ badge.icon.value }}</div>
              <div class="sm1c-pdp-badge-label">{{ badge.label.value }}</div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              <div class="sm1c-pdp-badge" {{ block.shopify_attributes }}>
                <div class="sm1c-pdp-badge-icon">{{ block.settings.icon }}</div>
                <div class="sm1c-pdp-badge-label">{{ block.settings.label }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      <div class="sm1c-pdp-bundle-slot sm1c-pdp-bundle-slot--desktop" data-sm1c-bundle-slot="desktop"></div>
    </div>

    <div class="sm1c-pdp-info">
      {%- liquid
        assign pdp_review_count = product.metafields.custom.review_count.value | default: section.settings.rating_text
        assign pdp_average_rating = section.settings.average_rating
      -%}
      {%- if pdp_average_rating != blank or pdp_review_count != blank -%}
        <a href="#sm1c-reviews" class="sm1c-pdp-rating">
          <span class="sm1c-pdp-rating-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6.3 6.9.7-5.1 4.7 1.5 6.8L12 17.8l-6.2 3.2 1.5-6.8-5.1-4.7 6.9-.7L12 2.5Z"/></svg>
            {%- endfor -%}
          </span>
          {%- if pdp_average_rating != blank -%}
            <span class="sm1c-pdp-rating-number">{{ pdp_average_rating }}</span>
          {%- endif -%}
          {%- if pdp_review_count != blank -%}
            <span class="sm1c-pdp-rating-text">{{ pdp_review_count }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
      <h1 class="sm1c-pdp-title">{{ title_rest }} <span>{{ title_last }}</span></h1>

      {%- assign pill_blocks = section.blocks | where: 'type', 'pill_badge' -%}
      {%- if pill_blocks.size > 0 -%}
        <div class="sm1c-pdp-pills">
          {%- for block in pill_blocks -%}
            <span class="sm1c-pdp-pill" {{ block.shopify_attributes }}>
              <span class="sm1c-pdp-pill-icon">{{ block.settings.icon }}</span>
              {{ block.settings.label }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.short_description != blank -%}
        <div class="sm1c-pdp-shortdesc">{{ section.settings.short_description }}</div>
      {%- else -%}
        {%- liquid
          assign desc_stripped = product.description | strip_html
          assign desc_parts = desc_stripped | split: '✅'
          assign desc_bullet_count = 0
          for part in desc_parts
            assign part_trimmed = part | strip
            unless part_trimmed == blank
              assign desc_bullet_count = desc_bullet_count | plus: 1
            endunless
          endfor
        -%}
        <div class="sm1c-pdp-desc-wrap" data-sm1c-desc-wrap>
          {%- if desc_bullet_count > 1 -%}
            <ul class="sm1c-pdp-desc-list sm1c-pdp-desc-content" data-sm1c-desc-content>
              {%- for part in desc_parts -%}
                {%- assign part_trimmed = part | strip -%}
                {%- unless part_trimmed == blank -%}
                  <li>
                    <svg class="sm1c-pdp-desc-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>{{ part_trimmed }}</span>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          {%- else -%}
            <div class="sm1c-pdp-desc sm1c-pdp-desc-content" data-sm1c-desc-content>{{ desc_stripped }}</div>
          {%- endif -%}
          <button type="button" class="sm1c-pdp-desc-toggle" data-sm1c-desc-toggle hidden>Read more</button>
        </div>
      {%- endif -%}

      {%- assign feature_blocks = section.blocks | where: 'type', 'feature_item' -%}
      {%- if feature_blocks.size > 0 -%}
        <div class="sm1c-pdp-feature-grid">
          {%- for block in feature_blocks -%}
            <div class="sm1c-pdp-feature-item" {{ block.shopify_attributes }}>
              <span class="sm1c-pdp-feature-icon">{{ block.settings.icon }}</span>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.gift_banner_text != blank -%}
        <div class="sm1c-pdp-gift-banner">
          <span>{{ section.settings.gift_banner_icon | default: '🎁' }}</span>
          <span>{{ section.settings.gift_banner_text }}</span>
        </div>
      {%- endif -%}

      {%- if product.tags.size > 0 -%}
        <div class="sm1c-pdp-tags">
          {%- for tag in product.tags -%}
            <span class="sm1c-pdp-tag-badge">{{ tag }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, id: 'sm1c-pdp-form', class: '', data-sm1c-ajax-cart-form: '', data-currency: shop.currency -%}
        {%- if section.settings.best_results_text != blank -%}
          <div class="sm1c-pdp-best-results">{{ section.settings.best_results_text }}</div>
        {%- endif -%}
        <div class="sm1c-pdp-tiers">
          {%- assign tier_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tier' -%}
              {%- assign tier_index = tier_index | plus: 1 -%}
              {%- assign tier_total = current_variant.price | times: block.settings.quantity -%}
              <button
                type="button"
                class="sm1c-pdp-tier{% if block.settings.highlighted %} is-selected{% endif %}"
                data-sm1c-tier
                data-quantity="{{ block.settings.quantity }}"
                {{ block.shopify_attributes }}
              >
                <div>
                  <div class="sm1c-pdp-tier-label">
                    {{ block.settings.label }}
                    {%- if block.settings.badge_text != blank -%}
                      <span class="sm1c-pdp-tier-badge">{{ block.settings.badge_text }}</span>
                    {%- endif -%}
                  </div>
                  {%- if block.settings.note_text != blank -%}
                    <div class="sm1c-pdp-tier-note">{{ block.settings.note_text }}</div>
                  {%- endif -%}
                </div>
                <div class="sm1c-pdp-tier-price">
                  <div data-sm1c-tier-price>{{ tier_total | money }}</div>
                </div>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <input type="hidden" name="id" value="{{ current_variant.id }}" data-sm1c-variant-id>
        <script type="application/json" data-sm1c-variants-json>
          {{ product.variants | json }}
        </script>

        <input type="hidden" name="quantity" value="1" data-sm1c-quantity>

        <div class="sm1c-pdp-atc-group">
          {%- unless section.settings.hide_variant_picker -%}
          {%- if color_option -%}
            <div class="sm1c-pdp-option-group">
              <label class="sm1c-pdp-option-label">
                {{ color_option.name }}: <span data-sm1c-color-name>{{ color_option.selected_value }}</span>
              </label>
              <div class="sm1c-pdp-color-swatches" data-sm1c-color-swatches data-option-position="{{ color_option.position }}">
                {%- capture color_option_key -%}option{{ color_option.position }}{%- endcapture -%}
                {%- for value in color_option.values -%}
                  {%- assign swatch_image = null -%}
                  {%- for variant in product.variants -%}
                    {%- if variant[color_option_key] == value -%}
                      {%- assign swatch_image = variant.featured_image | default: product.featured_image -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  <button
                    type="button"
                    class="sm1c-pdp-color-swatch{% if color_option.selected_value == value %} is-active{% endif %}"
                    data-sm1c-color-swatch
                    data-value="{{ value | escape }}"
                    aria-label="{{ value | escape }}"
                    title="{{ value | escape }}"
                  >
                    {%- if swatch_image -%}
                      {{ swatch_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: value }}
                    {%- endif -%}
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- for option in product.options_with_values -%}
            {%- assign is_placeholder_option = false -%}
            {%- if option.values.size == 1 -%}
              {%- assign single_value_downcase = option.values.first | strip | downcase -%}
              {%- if single_value_downcase == blank
                or single_value_downcase == 'n/a'
                or single_value_downcase == 'default title'
                or single_value_downcase == 'default'
              -%}
                {%- assign is_placeholder_option = true -%}
              {%- endif -%}
            {%- endif -%}
            {%- assign skip_option = is_placeholder_option -%}
            {%- if color_option and option.position == color_option.position -%}
              {%- assign skip_option = true -%}
            {%- endif -%}
            {%- unless skip_option -%}
              <div class="sm1c-pdp-option-group">
                <label class="sm1c-pdp-option-label">
                  {{ option.name }}: <span data-sm1c-option-name>{{ option.selected_value }}</span>
                </label>
                <div class="sm1c-pdp-size-pills" data-sm1c-option-pills data-option-position="{{ option.position }}">
                  {%- capture option_key -%}option{{ option.position }}{%- endcapture -%}
                  {%- for value in option.values -%}
                    {%- assign value_available = false -%}
                    {%- for variant in product.variants -%}
                      {%- assign matches_color = true -%}
                      {%- if color_option -%}
                        {%- assign matches_color = false -%}
                        {%- if variant[color_option_key] == color_option.selected_value -%}
                          {%- assign matches_color = true -%}
                        {%- endif -%}
                      {%- endif -%}
                      {%- if variant[option_key] == value and variant.available and matches_color -%}
                        {%- assign value_available = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                    <button
                      type="button"
                      class="sm1c-pdp-size-pill{% if option.selected_value == value %} is-active{% endif %}"
                      data-sm1c-option-pill
                      data-value="{{ value | escape }}"
                      {% unless value_available %}disabled{% endunless %}
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endunless -%}
          {%- endfor -%}
          {%- endunless -%}

          {%- if section.settings.urgency_text != blank -%}
            <div class="sm1c-pdp-urgency">
              <span class="sm1c-pdp-urgency-dot"></span>
              <span class="sm1c-pdp-urgency-text">{{ section.settings.urgency_text }} <span>{{ urgency_percent }}%</span></span>
              <span class="sm1c-pdp-urgency-track"><span class="sm1c-pdp-urgency-fill" style="width:{{ urgency_percent }}%"></span></span>
            </div>
          {%- endif -%}

          <div class="product-form__buttons">
          <button type="submit" name="add" class="sm1c-pdp-atc product-form__submit" data-sm1c-atc-observe {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 4h2.2l2.6 12.4a2 2 0 0 0 2 1.6h7.4a2 2 0 0 0 1.94-1.53L20.5 8H5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="8.7" cy="20" r="1.3" fill="currentColor"/><circle cx="14.7" cy="20" r="1.3" fill="currentColor"/><circle cx="18.3" cy="6" r="5" fill="#fff"/><path d="M18.3 3.4v5.2M15.7 6h5.2" stroke="#D14C67" stroke-width="1.7" stroke-linecap="round"/></svg>
            {%- endif -%}
            <span data-sm1c-atc-label>
              {%- if current_variant.available -%}
                {{ section.settings.atc_label | default: 'ADD TO CART' }}
              {%- else -%}
                Sold out
              {%- endif -%}
            </span>
          </button>
          </div>
        </div>
      {%- endform -%}

      <div class="sm1c-pdp-free-shipping">Free Shipping For All Orders</div>
      <div class="sm1c-pdp-bundle-slot sm1c-pdp-bundle-slot--mobile" data-sm1c-bundle-slot="mobile"></div>

      {%- if section.settings.social_proof_text != blank -%}
        <div class="sm1c-pdp-social">★★★★★ &nbsp;{{ section.settings.social_proof_text }}</div>
      {%- endif -%}

      {%- assign demo_videos = product.metafields.custom.product_demos.value -%}
      {%- if demo_videos.size > 0 or section.settings.reel_video != null -%}
        <div class="sm1c-pdp-reel-row">
          {%- if demo_videos.size > 0 -%}
            {%- for demo in demo_videos -%}
              {%- if demo.media_type == 'video' -%}
                <div class="sm1c-pdp-reel">
                  {{-
                    demo
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      preload: 'metadata',
                      image_size: '400x'
                  -}}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <div class="sm1c-pdp-reel">
              {{-
                section.settings.reel_video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  preload: 'metadata',
                  image_size: '400x'
              -}}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- liquid
        assign media_blocks = section.blocks | where: 'type', 'media_tile'
        assign has_media_content = false
        for block in media_blocks
          if block.settings.video != blank or block.settings.image != blank
            assign has_media_content = true
          endif
        endfor
      -%}
      {%- if has_media_content -%}
        <div class="sm1c-pdp-media-grid">
          {%- for block in media_blocks -%}
            {%- if block.settings.video != blank -%}
              <div class="sm1c-pdp-media-tile" {{ block.shopify_attributes }}>
                {{-
                  block.settings.video
                  | video_tag:
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    preload: 'metadata',
                    image_size: '400x'
                -}}
              </div>
            {%- elsif block.settings.image != blank -%}
              <div class="sm1c-pdp-media-tile" {{ block.shopify_attributes }}>
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion_item' -%}
      {%- if accordion_blocks.size > 0 -%}
        <div class="sm1c-pdp-accordion">
          {%- for block in accordion_blocks -%}
            {%- assign point_count = 0 -%}
            {%- for i in (1..5) -%}
              {%- assign point_text_key = 'point_' | append: i | append: '_text' -%}
              {%- assign point_text_value = block.settings[point_text_key] -%}
              {%- unless point_text_value == blank -%}
                {%- assign point_count = point_count | plus: 1 -%}
              {%- endunless -%}
            {%- endfor -%}
            <details {{ block.shopify_attributes }}>
              <summary>
                <span class="sm1c-pdp-accordion-summary-left">
                  {%- if block.settings.title_icon != blank -%}
                    <span class="sm1c-pdp-accordion-summary-icon">{% render 'sm1c-pdp-icon', icon: block.settings.title_icon %}</span>
                  {%- endif -%}
                  <span>{{ block.settings.title }}</span>
                </span>
              </summary>
              <div class="sm1c-pdp-accordion-body">
                {%- if point_count > 0 -%}
                  <div class="sm1c-pdp-accordion-points">
                    {%- for i in (1..5) -%}
                      {%- assign point_icon_key = 'point_' | append: i | append: '_icon' -%}
                      {%- assign point_text_key = 'point_' | append: i | append: '_text' -%}
                      {%- assign point_text_value = block.settings[point_text_key] -%}
                      {%- unless point_text_value == blank -%}
                        <div class="sm1c-pdp-accordion-point">
                          <span class="sm1c-pdp-accordion-point-icon">{% render 'sm1c-pdp-icon', icon: block.settings[point_icon_key] %}</span>
                          <span>{{ point_text_value }}</span>
                        </div>
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  {{ block.settings.body }}
                {%- endif -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign feedback_bars_mf = product.metafields.custom.feedback_bars.value -%}
      {%- assign feedback_blocks = section.blocks | where: 'type', 'feedback_bar' -%}
      {%- if feedback_bars_mf.size > 0 or feedback_blocks.size > 0 -%}
        <div class="sm1c-pdp-feedback">
          {%- if section.settings.feedback_title != blank -%}
            <div class="sm1c-pdp-feedback-title">
              <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true"><path d="M12 21s-6.6-4.35-9.3-8.1C1 10.2 1.6 6.6 4.6 5.1c2.3-1.15 4.7-.3 6 1.4l1.4 1.8 1.4-1.8c1.3-1.7 3.7-2.55 6-1.4 3 1.5 3.6 5.1 1.9 7.8C18.6 16.65 12 21 12 21Z"/></svg>
              {{ section.settings.feedback_title }}
            </div>
          {%- endif -%}
          {%- if feedback_bars_mf.size > 0 -%}
            {%- for bar in feedback_bars_mf -%}
              <div class="sm1c-pdp-fb-row">
                <div class="sm1c-pdp-fb-row-top">
                  <span class="sm1c-pdp-fb-label">{{ bar.label.value }}</span>
                  <span class="sm1c-pdp-fb-percent">{{ bar.percent.value }}%</span>
                </div>
                <div class="sm1c-pdp-fb-track"><div class="sm1c-pdp-fb-fill" style="--sm1c-fb-target:{{ bar.percent.value }}%"></div></div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for block in feedback_blocks -%}
              <div class="sm1c-pdp-fb-row" {{ block.shopify_attributes }}>
                <div class="sm1c-pdp-fb-row-top">
                  <span class="sm1c-pdp-fb-label">{{ block.settings.label }}</span>
                  <span class="sm1c-pdp-fb-percent">{{ block.settings.percent }}%</span>
                </div>
                <div class="sm1c-pdp-fb-track"><div class="sm1c-pdp-fb-fill" style="--sm1c-fb-target:{{ block.settings.percent }}%"></div></div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="sm1c-pdp-sticky-atc" data-sm1c-sticky-atc hidden>
    <div class="sm1c-pdp-sticky-atc-inner">
      <div class="sm1c-pdp-sticky-atc-info">
        <div class="sm1c-pdp-sticky-atc-img">
          {%- if main_image != blank -%}
            {{ main_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: product.title }}
          {%- endif -%}
        </div>
        <div>
          <div class="sm1c-pdp-sticky-atc-title">{{ product.title }}</div>
          <div class="sm1c-pdp-sticky-atc-price" data-sm1c-sticky-price>{{ current_variant.price | money }}</div>
          {%- if section.settings.urgency_text != blank -%}
            <div class="sm1c-pdp-sticky-atc-urgency">{{ section.settings.urgency_text }} {{ urgency_percent }}% left</div>
          {%- endif -%}
        </div>
      </div>
      <button
        type="button"
        class="sm1c-pdp-sticky-atc-btn"
        data-sm1c-sticky-atc-btn
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span data-sm1c-sticky-atc-label>
          {%- if current_variant.available -%}
            {{ section.settings.atc_label | default: 'ADD TO CART' }}
          {%- else -%}
            Sold out
          {%- endif -%}
        </span>
      </button>
    </div>
  </div>

  <div class="sm1c-pdp-zoom-overlay" data-sm1c-zoom-overlay hidden>
    <button type="button" class="sm1c-pdp-zoom-overlay-close" data-sm1c-zoom-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="26" height="26">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="sm1c-pdp-zoom-stage" data-sm1c-zoom-stage>
      <img data-sm1c-zoom-image src="" alt="" draggable="false">
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.currentScript.closest('.shopify-section') || document;

  var descWrap = root.querySelector('[data-sm1c-desc-wrap]');
  var descContent = root.querySelector('[data-sm1c-desc-content]');
  var descToggle = root.querySelector('[data-sm1c-desc-toggle]');
  if (descWrap && descContent && descToggle) {
    if (descContent.scrollHeight > descContent.clientHeight + 1) {
      descToggle.hidden = false;
    } else {
      descWrap.classList.add('no-clamp');
    }
    descToggle.addEventListener('click', function () {
      var expanded = descWrap.classList.toggle('is-expanded');
      descToggle.textContent = expanded ? 'Read less' : 'Read more';
    });
  }

  var mainImg = root.querySelector('[data-sm1c-main-img]');
  var thumbs = root.querySelectorAll('[data-sm1c-thumb]');

  function setMainImage(url) {
    if (!mainImg || !url) return;
    var img = mainImg.querySelector('img');
    if (!img) return;
    // A srcset (auto-added by Shopify's image_tag) takes priority over `src` for the
    // browser's image selection, so a plain `img.src = url` silently no-ops unless
    // srcset is cleared first.
    img.removeAttribute('srcset');
    img.removeAttribute('sizes');
    img.src = url;
  }

  var mobileTrack = root.querySelector('[data-sm1c-mobile-track]');
  var mobileSlideEls = mobileTrack ? mobileTrack.querySelectorAll('[data-sm1c-mobile-slide]') : [];

  function setActiveThumb(index) {
    thumbs.forEach(function (t, i) { t.classList.toggle('is-active', i === index); });
  }

  thumbs.forEach(function (thumb, index) {
    thumb.addEventListener('click', function () {
      setActiveThumb(index);
      setMainImage(thumb.getAttribute('data-full'));
      var targetSlide = mobileSlideEls[index];
      if (targetSlide && mobileTrack) {
        mobileTrack.scrollTo({ left: targetSlide.offsetLeft, behavior: 'smooth' });
      }
    });
  });

  if (mobileTrack && mobileSlideEls.length > 1) {
    var scrollTimer = null;
    mobileTrack.addEventListener('scroll', function () {
      if (scrollTimer) clearTimeout(scrollTimer);
      scrollTimer = setTimeout(function () {
        var trackRect = mobileTrack.getBoundingClientRect();
        var center = trackRect.left + trackRect.width / 2;
        var closestIndex = 0;
        var closestDist = Infinity;
        mobileSlideEls.forEach(function (slide, index) {
          var rect = slide.getBoundingClientRect();
          var dist = Math.abs((rect.left + rect.width / 2) - center);
          if (dist < closestDist) {
            closestDist = dist;
            closestIndex = index;
          }
        });
        setActiveThumb(closestIndex);
      }, 80);
    }, { passive: true });
  }

  var tiers = root.querySelectorAll('[data-sm1c-tier]');
  var qtyInput = root.querySelector('[data-sm1c-quantity]');
  tiers.forEach(function (tier) {
    tier.addEventListener('click', function () {
      tiers.forEach(function (t) { t.classList.remove('is-selected'); });
      tier.classList.add('is-selected');
      if (qtyInput) qtyInput.value = tier.getAttribute('data-quantity');
      updateTierPrices();
    });
  });

  var variantsJson = root.querySelector('[data-sm1c-variants-json]');
  var variants = variantsJson ? JSON.parse(variantsJson.textContent) : [];
  var variantIdInput = root.querySelector('[data-sm1c-variant-id]');
  var colorSwatchesWrap = root.querySelector('[data-sm1c-color-swatches]');
  var colorNameLabel = root.querySelector('[data-sm1c-color-name]');
  var optionGroups = root.querySelectorAll('[data-option-position]');
  var pdpFormEl = root.querySelector('#sm1c-pdp-form') || document.getElementById('sm1c-pdp-form');
  var currencyCode = (pdpFormEl && pdpFormEl.getAttribute('data-currency')) || 'USD';

  var moneyFormatter = null;
  try {
    moneyFormatter = new Intl.NumberFormat(undefined, { style: 'currency', currency: currencyCode });
  } catch (e) {
    moneyFormatter = null;
  }

  function formatMoney(amount) {
    if (moneyFormatter) return moneyFormatter.format(amount);
    return '$' + amount.toFixed(2);
  }

  function optionValueButtons(group) {
    return group.querySelectorAll('[data-sm1c-color-swatch], [data-sm1c-option-pill]');
  }

  function getSelectedOptions() {
    var selected = {};
    optionGroups.forEach(function (group) {
      var active = group.querySelector('.is-active');
      if (active) selected[group.getAttribute('data-option-position')] = active.getAttribute('data-value');
    });
    return selected;
  }

  function recomputeAvailability() {
    var selected = getSelectedOptions();
    optionGroups.forEach(function (group) {
      var position = group.getAttribute('data-option-position');
      var otherSelected = Object.assign({}, selected);
      delete otherSelected[position];

      optionValueButtons(group).forEach(function (button) {
        var value = button.getAttribute('data-value');
        var candidate = Object.assign({}, otherSelected);
        candidate[position] = value;
        var available = variants.some(function (variant) {
          return variant.available && Object.keys(candidate).every(function (pos) {
            return variant['option' + pos] === candidate[pos];
          });
        });
        button.disabled = !available;
        if (!available) button.classList.remove('is-active');
      });

      if (!group.querySelector('.is-active')) {
        var firstEnabled = Array.prototype.find.call(optionValueButtons(group), function (b) { return !b.disabled; });
        if (firstEnabled) firstEnabled.classList.add('is-active');
      }
    });
  }

  function findMatchingVariant(selected) {
    return variants.find(function (variant) {
      return Object.keys(selected).every(function (position) {
        return variant['option' + position] === selected[position];
      });
    });
  }

  function updateTierPrices() {
    var variant = findMatchingVariant(getSelectedOptions());
    if (!variant) return;
    tiers.forEach(function (tier) {
      var priceEl = tier.querySelector('[data-sm1c-tier-price]');
      var quantity = parseInt(tier.getAttribute('data-quantity'), 10) || 1;
      if (priceEl) priceEl.textContent = formatMoney((variant.price / 100) * quantity);
    });
  }

  function applyVariant(variant) {
    if (!variant) return;

    if (variantIdInput) variantIdInput.value = variant.id;

    if (variant.featured_image && variant.featured_image.src) {
      setMainImage(variant.featured_image.src);
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
    }

    updateTierPrices();

    var stickyPrice = root.querySelector('[data-sm1c-sticky-price]');
    if (stickyPrice) stickyPrice.textContent = formatMoney(variant.price / 100);

    [
      { button: mainAtcButtonEl(), label: root.querySelector('[data-sm1c-atc-label]') },
      { button: root.querySelector('[data-sm1c-sticky-atc-btn]'), label: root.querySelector('[data-sm1c-sticky-atc-label]') },
    ].forEach(function (pair) {
      if (!pair.button) return;
      pair.button.disabled = !variant.available;
      if (pair.label) pair.label.textContent = variant.available ? (pair.label.getAttribute('data-default-label') || pair.label.textContent) : 'Sold out';
    });
  }

  function mainAtcButtonEl() {
    return root.querySelector('[data-sm1c-atc-observe]');
  }

  // Preserve each button's original "available" label so re-selecting an available variant restores it.
  root.querySelectorAll('[data-sm1c-atc-label], [data-sm1c-sticky-atc-label]').forEach(function (label) {
    if (!label.hasAttribute('data-default-label') && label.textContent.trim().toLowerCase() !== 'sold out') {
      label.setAttribute('data-default-label', label.textContent.trim());
    }
  });

  optionGroups.forEach(function (group) {
    var nameLabel = group === colorSwatchesWrap ? colorNameLabel : group.parentElement.querySelector('[data-sm1c-option-name]');

    optionValueButtons(group).forEach(function (button) {
      button.addEventListener('click', function () {
        if (button.disabled) return;

        optionValueButtons(group).forEach(function (b) { b.classList.remove('is-active'); });
        button.classList.add('is-active');
        if (nameLabel) nameLabel.textContent = button.getAttribute('data-value');

        recomputeAvailability();
        applyVariant(findMatchingVariant(getSelectedOptions()));
      });
    });
  });

  recomputeAvailability();

  var stickyBar = root.querySelector('[data-sm1c-sticky-atc]');
  var mainAtcButton = root.querySelector('[data-sm1c-atc-observe]');
  var stickyAtcButton = root.querySelector('[data-sm1c-sticky-atc-btn]');
  var pdpForm = document.getElementById('sm1c-pdp-form');

  if (stickyBar && mainAtcButton && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
        stickyBar.hidden = !scrolledPast;
        stickyBar.classList.toggle('is-visible', scrolledPast);
      });
    }, { threshold: 0 });
    observer.observe(mainAtcButton);
  }

  if (stickyAtcButton && pdpForm) {
    stickyAtcButton.addEventListener('click', function () {
      if (pdpForm.requestSubmit) {
        pdpForm.requestSubmit();
      } else {
        pdpForm.submit();
      }
    });
  }

  var zoomBtn = root.querySelector('[data-sm1c-zoom-btn]');
  var zoomOverlay = root.querySelector('[data-sm1c-zoom-overlay]');
  var zoomCloseBtn = root.querySelector('[data-sm1c-zoom-close]');
  var zoomStage = root.querySelector('[data-sm1c-zoom-stage]');
  var zoomImage = root.querySelector('[data-sm1c-zoom-image]');

  if (zoomBtn && zoomOverlay && zoomImage) {
    var zoomScale = 1;
    var zoomPanX = 0;
    var zoomPanY = 0;
    var isPanning = false;
    var panStartX = 0;
    var panStartY = 0;

    function setZoomTransform() {
      zoomImage.style.transform = 'translate(' + zoomPanX + 'px, ' + zoomPanY + 'px) scale(' + zoomScale + ')';
    }

    function resetZoom() {
      zoomScale = 1;
      zoomPanX = 0;
      zoomPanY = 0;
      isPanning = false;
      zoomImage.classList.remove('is-zoomed', 'is-panning');
      setZoomTransform();
    }

    function openZoom(src, alt) {
      if (!src) {
        var mainImgEl = mainImg && mainImg.querySelector('img');
        if (!mainImgEl || !mainImgEl.src) return;
        src = mainImgEl.src;
        alt = mainImgEl.alt || '';
      }
      zoomImage.src = src;
      zoomImage.alt = alt || '';
      resetZoom();
      zoomOverlay.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function closeZoom() {
      zoomOverlay.hidden = true;
      document.body.style.overflow = '';
      resetZoom();
    }

    zoomBtn.addEventListener('click', function () { openZoom(); });
    zoomCloseBtn.addEventListener('click', closeZoom);

    var mobileSlides = root.querySelectorAll('[data-sm1c-mobile-slide]');
    mobileSlides.forEach(function (slide) {
      slide.addEventListener('click', function () {
        var img = slide.querySelector('img');
        openZoom(slide.getAttribute('data-full'), img ? img.alt : '');
      });
    });

    zoomOverlay.addEventListener('click', function (event) {
      if (event.target === zoomOverlay || event.target === zoomStage) closeZoom();
    });

    document.addEventListener('keydown', function (event) {
      if (!zoomOverlay.hidden && event.key === 'Escape') closeZoom();
    });

    zoomImage.addEventListener('click', function (event) {
      event.stopPropagation();
      if (zoomScale === 1) {
        zoomScale = 2;
        zoomImage.classList.add('is-zoomed');
      } else {
        resetZoom();
      }
      setZoomTransform();
    });

    zoomStage.addEventListener('wheel', function (event) {
      event.preventDefault();
      var next = zoomScale - event.deltaY * 0.0015;
      zoomScale = Math.min(4, Math.max(1, next));
      zoomImage.classList.toggle('is-zoomed', zoomScale > 1);
      if (zoomScale === 1) {
        zoomPanX = 0;
        zoomPanY = 0;
      }
      setZoomTransform();
    }, { passive: false });

    zoomImage.addEventListener('pointerdown', function (event) {
      if (zoomScale === 1) return;
      isPanning = true;
      panStartX = event.clientX - zoomPanX;
      panStartY = event.clientY - zoomPanY;
      zoomImage.classList.add('is-panning');
      zoomImage.setPointerCapture(event.pointerId);
    });

    zoomImage.addEventListener('pointermove', function (event) {
      if (!isPanning) return;
      zoomPanX = event.clientX - panStartX;
      zoomPanY = event.clientY - panStartY;
      setZoomTransform();
    });

    ['pointerup', 'pointercancel'].forEach(function (eventName) {
      zoomImage.addEventListener(eventName, function () {
        isPanning = false;
        zoomImage.classList.remove('is-panning');
      });
    });
  }

  function SM1CAccordion(el) {
    this.el = el;
    this.summary = el.querySelector('summary');
    this.content = el.querySelector('.sm1c-pdp-accordion-body');
    this.animation = null;
    this.isClosing = false;
    this.isExpanding = false;
    this.summary.addEventListener('click', this.onClick.bind(this));
  }
  SM1CAccordion.prototype.onClick = function (e) {
    e.preventDefault();
    this.el.style.overflow = 'hidden';
    if (this.isClosing || !this.el.open) {
      this.open();
    } else if (this.isExpanding || this.el.open) {
      this.shrink();
    }
  };
  SM1CAccordion.prototype.shrink = function () {
    this.isClosing = true;
    var startHeight = this.el.offsetHeight + 'px';
    var endHeight = this.summary.offsetHeight + 'px';
    if (this.animation) this.animation.cancel();
    this.animation = this.el.animate(
      { height: [startHeight, endHeight] },
      { duration: 300, easing: 'cubic-bezier(.4, 0, .2, 1)' }
    );
    this.animation.onfinish = this.onAnimationFinish.bind(this, false);
    this.animation.oncancel = function () { this.isClosing = false; }.bind(this);
  };
  SM1CAccordion.prototype.open = function () {
    this.el.style.height = this.el.offsetHeight + 'px';
    this.el.open = true;
    window.requestAnimationFrame(this.expand.bind(this));
  };
  SM1CAccordion.prototype.expand = function () {
    this.isExpanding = true;
    var startHeight = this.el.offsetHeight + 'px';
    var endHeight = (this.summary.offsetHeight + this.content.offsetHeight) + 'px';
    if (this.animation) this.animation.cancel();
    this.animation = this.el.animate(
      { height: [startHeight, endHeight] },
      { duration: 300, easing: 'cubic-bezier(.4, 0, .2, 1)' }
    );
    this.animation.onfinish = this.onAnimationFinish.bind(this, true);
    this.animation.oncancel = function () { this.isExpanding = false; }.bind(this);
  };
  SM1CAccordion.prototype.onAnimationFinish = function (open) {
    this.el.open = open;
    this.animation = null;
    this.isClosing = false;
    this.isExpanding = false;
    this.el.style.height = '';
    this.el.style.overflow = '';
  };

  if (window.Animation && Element.prototype.animate) {
    root.querySelectorAll('.sm1c-pdp-accordion details').forEach(function (el) {
      new SM1CAccordion(el);
    });
  }
})();
</script>

<script>
/*
  Pumper combo-bundle repositioning.

  Pumper's "combo" bundle offer type (rendered as .pmpr_bundle__root, with a
  matching hidden .pmpr_bundle__inActive_state sibling) renders on the page of
  EVERY product that's a member of that combo — by design, not a
  misconfiguration. On a product that belongs to multiple combos, this stacks
  several bundle-buy boxes directly inside the buy box, ahead of the plain Add
  to Cart button.

  Pumper injects these elements asynchronously into the product form after its
  own script runs, so we poll briefly for them, then move (not clone) them.

  Preferred destination: the standalone "SM1C PDP Combo Bundles" section
  (sm1c-pdp-combo-bundles.liquid) if the template includes it. That section
  sits after the reviews, so a multi-product combo is only offered once the
  shopper has read what the product does — a combo asks them to evaluate
  products they may not know yet, unlike a quantity tier.

  Fallback (template has no combo section): the original two
  .sm1c-pdp-bundle-slot containers, chosen by viewport — on desktop the left
  column below the image gallery; on mobile (where the layout stacks to one
  column, same 900px breakpoint as .sm1c-pdp-grid) below the "Free Shipping
  For All Orders" line, so it doesn't land above the title/price/Add to Cart.

  NOTE: this moves ONLY Pumper combo widgets. The quantity tiers rendered by
  this section's own `tier` blocks (Buy 1 / Buy 2 / Buy 3 of the same product)
  stay in the buy box and are untouched.
*/
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root) return;
  var desktopSlot = root.querySelector('[data-sm1c-bundle-slot="desktop"]');
  var mobileSlot = root.querySelector('[data-sm1c-bundle-slot="mobile"]');
  if (!desktopSlot || !mobileSlot) return;
  var mql = window.matchMedia('(max-width: 900px)');
  var comboSection = null;
  var comboSlot = null;

  // Resolved lazily, never cached as null: this section renders before the
  // combo section further down the page, so at the time this script first
  // runs that element does not exist in the DOM yet. Looking it up on each
  // pass means the first pass after the page finishes parsing finds it.
  function resolveComboSlot() {
    if (comboSlot) return comboSlot;
    comboSection = document.querySelector('[data-sm1c-combo-section]');
    comboSlot = comboSection ? comboSection.querySelector('[data-sm1c-combo-slot]') : null;
    return comboSlot;
  }

  function currentSlot() {
    // The standalone section wins whenever the template includes it; it is a
    // single destination, so viewport no longer decides placement.
    var combo = resolveComboSlot();
    if (combo) return combo;
    return mql.matches ? mobileSlot : desktopSlot;
  }

  function moveBundleWidgets() {
    var slot = currentSlot();
    var found = root.querySelectorAll('.pmpr_bundle__root, .pmpr_bundle__inActive_state');
    found.forEach(function (el) {
      if (el.parentNode !== slot) slot.appendChild(el);
    });
    // Reveal the standalone section only once a real widget is inside it, so
    // products belonging to no combo don't render a stranded heading.
    if (comboSection && comboSlot && comboSlot.querySelector('.pmpr_bundle__root')) {
      comboSection.hidden = false;
    }
    return found.length > 0;
  }

  (function retry(attemptsLeft) {
    var moved = moveBundleWidgets();
    if (!moved && attemptsLeft > 0) {
      setTimeout(function () { retry(attemptsLeft - 1); }, 400);
    }
  })(20); // Pumper's script loads async — retry for a few seconds if it isn't ready yet.

  // If Pumper won the race and the widgets were already parked in a fallback
  // slot before the combo section existed, these passes relocate them: the
  // fallback slots live inside `root`, so the widgets are still discoverable
  // and get moved on to the combo slot once it resolves.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', moveBundleWidgets);
  }
  window.addEventListener('load', moveBundleWidgets);

  // Combo widgets can also be added/changed after an in-page Pumper re-render
  // (e.g. after its own cart refresh); keep watching for late insertions.
  var observer = new MutationObserver(function () {
    moveBundleWidgets();
  });
  observer.observe(root, { childList: true, subtree: true });

  // Move between slots if the viewport crosses the breakpoint (window resize,
  // not just a fresh page load at a given size).
  if (typeof mql.addEventListener === 'function') {
    mql.addEventListener('change', moveBundleWidgets);
  } else if (typeof mql.addListener === 'function') {
    mql.addListener(moveBundleWidgets); // Safari < 14 fallback.
  }

  // The combo bundle's own "Add to cart" button is a plain <button> (so it
  // defaults to type="submit"). While the widget sits inside #sm1c-pdp-form,
  // Pumper's own script AJAX-adds the combo and opens its slide cart, but
  // nothing stops the click from ALSO submitting the surrounding form
  // natively, sending the browser to the cart page at the same time. We block
  // only that native submission; Pumper's own listener still runs normally.
  //
  // Once the widget has been moved into the standalone combo section it is no
  // longer inside any form, so there is no native submit to block — hence the
  // closest('form') test rather than a fixed container check. Guarding on the
  // form (instead of `root`) keeps this correct in both placements.
  document.addEventListener('click', function (event) {
    var btn = event.target.closest('.pmpr_bundle__add_to_cart');
    if (!btn || !btn.closest('form')) return;
    event.preventDefault();
  }, true);
})();
</script>

<script>
/*
  Pumper Quantity Breaks bridge.

  The Pumper bundle widget keeps the correct add-to-cart payload (selected tier
  quantity + the __pumper_bundles offer property that its Shopify Function needs
  to apply the discount) in `window.pmpr_cart_item`. It does NOT write that
  payload back into this section's product form, and another script on the page
  intercepts the button click before Pumper can act — so a plain click would add
  1 unit at the tier-0 property and silently lose the discount.

  This handler runs in the capture phase (before those other listeners) and, when
  a Pumper payload is present, performs the add itself from that payload, then
  opens Pumper's slide cart. Without Pumper on the page it does nothing and the
  normal form submit is left untouched.
*/
(function () {
  var ATC_SELECTOR = '.sm1c-pdp-atc, [data-sm1c-sticky-atc-btn]';

  function pumperPayload() {
    var items = window.pmpr_cart_item;
    if (!Array.isArray(items) || !items.length) return null;
    var clean = items
      .filter(function (i) { return i && i.id; })
      .map(function (i) {
        var item = { id: String(i.id), quantity: parseInt(i.quantity, 10) || 1 };
        if (i.properties && Object.keys(i.properties).length) item.properties = i.properties;
        if (i.selling_plan) item.selling_plan = i.selling_plan;
        return item;
      });
    return clean.length ? clean : null;
  }

  function setBusy(button, busy, originalHtml) {
    if (!button) return;
    button.disabled = busy;
    if (busy) {
      button.setAttribute('aria-busy', 'true');
    } else {
      button.removeAttribute('aria-busy');
      if (originalHtml != null) button.innerHTML = originalHtml;
    }
  }

  // The header cart badge is only set once, from the server-rendered page load.
  // Nothing else on the page keeps it in sync after an AJAX cart change, so we
  // do it ourselves: after our own add, and by piggybacking on Pumper's own
  // refresh hook so edits made inside Pumper's slide cart (quantity +/-, remove)
  // update the header badge too, not just our own add-to-cart flow.
  function syncHeaderCartCount() {
    fetch('/cart.js')
      .then(function (res) { return res.json(); })
      .then(function (cart) {
        var badge = document.querySelector('[data-sm1c-cart-count]');
        if (badge) badge.textContent = cart.item_count;
      })
      .catch(function () {});
  }

  (function hookPumperRefresh(retriesLeft) {
    if (typeof window.pmprscRefreshCart === 'function' && !window.pmprscRefreshCart.__sm1cWrapped) {
      var original = window.pmprscRefreshCart;
      window.pmprscRefreshCart = function () {
        var result = original.apply(this, arguments);
        syncHeaderCartCount();
        return result;
      };
      window.pmprscRefreshCart.__sm1cWrapped = true;
      return;
    }
    if (retriesLeft > 0) setTimeout(function () { hookPumperRefresh(retriesLeft - 1); }, 400);
  })(15); // Pumper's script loads async — retry for a few seconds if it isn't ready yet.

  document.addEventListener('click', function (event) {
    var button = event.target.closest(ATC_SELECTOR);
    if (!button || button.disabled) return;

    var items = pumperPayload();
    if (!items) return; // no Pumper offer on this product — leave default behaviour alone

    // Beat the other click interceptors on the page.
    event.preventDefault();
    event.stopPropagation();
    if (event.stopImmediatePropagation) event.stopImmediatePropagation();

    var originalHtml = button.innerHTML;
    setBusy(button, true);

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    })
      .then(function (res) {
        return res.json().then(function (body) {
          if (!res.ok) throw body;
          return body;
        });
      })
      .then(function () {
        syncHeaderCartCount();
        if (typeof window.pmprscRefreshCart === 'function') {
          try { window.pmprscRefreshCart(); } catch (e) {}
        }
        if (typeof window.pmprscOpen === 'function') {
          try { window.pmprscOpen(); return; } catch (e) {}
        }
        // Pumper's slide cart unavailable — fall back to the cart page.
        window.location.href = '{{ routes.cart_url }}';
      })
      .catch(function (err) {
        window.alert((err && (err.description || err.message)) || 'Could not add this bundle to your cart.');
      })
      .finally(function () {
        setBusy(button, false, originalHtml);
      });
  }, true); // capture phase
})();
</script>

