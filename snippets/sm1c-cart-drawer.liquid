<style>
.sm1c-cart-drawer {
  position: fixed;
  inset: 0;
  z-index: 200;
}
.sm1c-cart-drawer[hidden] {
  display: none;
}
.sm1c-cart-drawer-overlay {
  position: absolute;
  inset: 0;
  background: rgba(20, 12, 8, 0.4);
  opacity: 0;
  transition: opacity .3s ease;
}
.sm1c-cart-drawer.is-open .sm1c-cart-drawer-overlay {
  opacity: 1;
}
.sm1c-cart-drawer-panel {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 400px;
  max-width: 92vw;
  background: #fff;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform .3s ease;
  font-family: 'Work Sans', sans-serif;
  box-shadow: -12px 0 30px rgba(0,0,0,.12);
}
.sm1c-cart-drawer.is-open .sm1c-cart-drawer-panel {
  transform: translateX(0);
}
.sm1c-cart-drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 22px;
  border-bottom: 1px solid oklch(90% 0.01 30);
}
.sm1c-cart-drawer-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-size: 18px;
  font-weight: 400;
}
.sm1c-cart-drawer-close {
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: #4A3B32;
  padding: 4px;
  line-height: 1;
}
.sm1c-cart-drawer-items {
  flex: 1;
  overflow-y: auto;
  padding: 12px 22px;
}
.sm1c-cart-drawer-item {
  display: grid;
  grid-template-columns: 64px 1fr auto;
  gap: 14px;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid oklch(93% 0.01 30);
}
.sm1c-cart-drawer-item-img {
  display: block;
  width: 64px;
  height: 64px;
  border-radius: 10px;
  overflow: hidden;
  background: #eee;
}
.sm1c-cart-drawer-item-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.sm1c-cart-drawer-item-title {
  display: block;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.3;
  color: inherit;
  text-decoration: none;
}
.sm1c-cart-drawer-item-title:hover {
  text-decoration: underline;
}
.sm1c-cart-drawer-item-variant {
  font-size: 12px;
  color: rgba(58, 46, 39, .75);
  margin-top: 2px;
}
.sm1c-cart-drawer-item-meta {
  font-size: 12px;
  color: rgba(58, 46, 39, .75);
  margin-top: 4px;
}
.sm1c-cart-drawer-item-price {
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
}
.sm1c-cart-drawer-empty {
  text-align: center;
  padding: 40px 0;
  font-size: 13px;
  color: rgba(58, 46, 39, .75);
}
.sm1c-cart-drawer-footer {
  padding: 18px 22px 22px;
  border-top: 1px solid oklch(90% 0.01 30);
}
.sm1c-cart-drawer-subtotal {
  display: flex;
  justify-content: space-between;
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 14px;
}
.sm1c-cart-drawer-view-cart,
.sm1c-cart-drawer-checkout {
  display: block;
  text-align: center;
  text-decoration: none;
  padding: 14px;
  border-radius: 14px;
  font-family: 'Work Sans', sans-serif;
  font-size: 14px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: .03em;
  margin-top: 10px;
}
.sm1c-cart-drawer-view-cart {
  border: 1.5px solid oklch(85% 0.01 30);
  color: #4A3B32;
}
.sm1c-cart-drawer-checkout {
  background: #E8637E;
  color: #FBF6EE;
}
:root[data-sm1c-theme='dark'] .sm1c-cart-drawer-panel {
  background: var(--sm1c-surface);
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] .sm1c-cart-drawer-header,
:root[data-sm1c-theme='dark'] .sm1c-cart-drawer-item,
:root[data-sm1c-theme='dark'] .sm1c-cart-drawer-footer {
  border-color: var(--sm1c-border);
}
:root[data-sm1c-theme='dark'] .sm1c-cart-drawer-close {
  color: var(--sm1c-text);
}
:root[data-sm1c-theme='dark'] .sm1c-cart-drawer-item-img {
  background: var(--sm1c-bg);
}
:root[data-sm1c-theme='dark'] .sm1c-cart-drawer-item-meta,
:root[data-sm1c-theme='dark'] .sm1c-cart-drawer-item-variant,
:root[data-sm1c-theme='dark'] .sm1c-cart-drawer-empty {
  color: rgba(240, 237, 232, .55);
}
:root[data-sm1c-theme='dark'] .sm1c-cart-drawer-view-cart {
  border-color: var(--sm1c-border);
  color: var(--sm1c-text);
}
</style>

<div class="sm1c-cart-drawer" id="sm1c-cart-drawer" data-sm1c-cart-drawer hidden>
  <div class="sm1c-cart-drawer-overlay" data-sm1c-cart-drawer-close></div>
  <div class="sm1c-cart-drawer-panel" role="dialog" aria-modal="true" aria-label="Cart">
    <div class="sm1c-cart-drawer-header">
      <span class="sm1c-cart-drawer-title">Your Cart</span>
      <button type="button" class="sm1c-cart-drawer-close" data-sm1c-cart-drawer-close aria-label="Close cart">✕</button>
    </div>
    <div class="sm1c-cart-drawer-items" data-sm1c-cart-drawer-items>
      {%- if cart.item_count == 0 -%}
        <p class="sm1c-cart-drawer-empty">Your cart is empty.</p>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="sm1c-cart-drawer-item">
            <a href="{{ item.url }}" class="sm1c-cart-drawer-item-img">
              {%- if item.image != blank -%}
                {{ item.image | image_url: width: 130 | image_tag: loading: 'lazy', alt: item.title }}
              {%- endif -%}
            </a>
            <div>
              <a href="{{ item.url }}" class="sm1c-cart-drawer-item-title">{{ item.product.title }}</a>
              {%- assign variant_title_downcase = item.variant.title | strip | downcase -%}
              {%- unless variant_title_downcase == 'default title' or variant_title_downcase == 'n/a' or variant_title_downcase == blank -%}
                <div class="sm1c-cart-drawer-item-variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="sm1c-cart-drawer-item-meta">Qty {{ item.quantity }}</div>
            </div>
            <div class="sm1c-cart-drawer-item-price">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="sm1c-cart-drawer-footer">
      <div class="sm1c-cart-drawer-subtotal">
        <span>Subtotal</span>
        <span data-sm1c-cart-drawer-subtotal>{{ cart.total_price | money }}</span>
      </div>
      <a href="{{ routes.cart_url }}" class="sm1c-cart-drawer-view-cart">View cart</a>
      <a href="{{ routes.root_url }}checkout" class="sm1c-cart-drawer-checkout">Checkout</a>
    </div>
  </div>
</div>

<script>
  window.sm1cMoneyFormat = {{ shop.money_format | json }};
</script>
{{ 'sm1c-cart-drawer.js' | asset_url | script_tag }}
