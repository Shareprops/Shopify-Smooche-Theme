<script>
  (function () {
    try {
      var saved = localStorage.getItem('sm1c_theme');
      var theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    } catch (e) {}
  })();
</script>
<style>
  :root {
    --sm1c-bg: #ffffff;
    --sm1c-text: #111111;
    --sm1c-surface: #ffffff;
    --sm1c-border: rgba(0, 0, 0, .08);
  }
  :root[data-theme='dark'] {
    --sm1c-bg: #121212;
    --sm1c-text: #f0ede8;
    --sm1c-surface: #1c1c1e;
    --sm1c-border: rgba(255, 255, 255, .12);
  }
  :root[data-theme='dark'] body {
    background: var(--sm1c-bg);
    color: var(--sm1c-text);
  }
</style>
