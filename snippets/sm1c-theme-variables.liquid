{%- comment -%}
  Dark mode is temporarily disabled for launch (light theme only).
  To re-enable: uncomment the script_tag below and re-add the theme
  toggle button in sections/sm1c-header.liquid.
  {{ 'sm1c-theme-init.js' | asset_url | script_tag }}
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&display=swap" rel="stylesheet">
<style>
  :root {
    --sm1c-bg: #FBF6EE;
    --sm1c-text: #3A2E27;
    --sm1c-surface: #ffffff;
    --sm1c-border: rgba(58, 46, 39, .1);
    --sm1c-serif: 'Fraunces', serif;
    --sm1c-sans: var(--font-body--family, 'Inter', sans-serif);
    --sm1c-rose: #E8637E;
    --sm1c-rose-deep: #C2506A;
    --sm1c-rose-soft: #FBE9EC;
    --sm1c-rose-tint: #FCF1EE;
    --sm1c-cream: #FBF6EE;
    --sm1c-ink: #2B211D;
  }
  :root[data-sm1c-theme='dark'] {
    --sm1c-bg: #121212;
    --sm1c-text: #f0ede8;
    --sm1c-surface: #1c1c1e;
    --sm1c-border: rgba(255, 255, 255, .12);
  }
  :root[data-sm1c-theme='dark'] body {
    background: var(--sm1c-bg);
    color: var(--sm1c-text);
  }
  /*
    Guards against a small (~scrollbar-width) page-level horizontal
    overflow caused by `position: fixed; left:0; right:0` elements that
    also use `transform` for a show/hide animation (the scratch-to-win
    popup, the mobile sticky Add to Cart bar). In that combination some
    browsers size the fixed element against the full window width
    (including the vertical scrollbar's reserved space) rather than the
    visible content width, which registers as a few px of page-level
    horizontal scroll. This does not affect any of the theme's internal
    horizontal scrollers (image galleries, review rail, marquee, scratch
    card swipe) — they all scroll their own container via overflow-x,
    not the page itself.
  */
  html, body {
    overflow-x: hidden;
  }
</style>
